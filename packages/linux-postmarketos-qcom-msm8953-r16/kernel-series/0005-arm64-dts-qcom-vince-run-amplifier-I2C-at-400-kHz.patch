+++ b/arch/arm64/boot/dts/qcom/msm8953-xiaomi-vince.dts
@@ -186,6 +186,8 @@ &gpu_zap_shader {
 };
 
 &i2c_2 {
+	clock-frequency = <400000>;
+
 	tas2557: codec@4c {
 		compatible = "ti,tas2557";
 		reg = <0x4c>;
