+++ b/arch/arm64/boot/dts/qcom/msm8953-xiaomi-vince.dts
@@ -161,6 +161,18 @@ &cci {
 };
 
 &cci_i2c0 {
+	dw9763: camera-lens@c {
+		compatible = "dongwoon,dw9763";
+		reg = <0x0c>;
+
+		vaf-supply = <&pm8953_l17>;
+		dongwoon,aac-mode = <5>;
+		dongwoon,aac-timing = <0x38>;
+		dongwoon,clock-presc = <1>;
+
+		status = "okay";
+	};
+
 	camera-sensor@10 { // Rear camera
 		compatible = "ovti,ov12a10";
 		reg = <0x10>;
