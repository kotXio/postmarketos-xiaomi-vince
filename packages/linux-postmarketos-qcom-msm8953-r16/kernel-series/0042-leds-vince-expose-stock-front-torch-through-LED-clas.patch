+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/xiaomi,vince-front-fill-light.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Xiaomi Redmi 5 Plus GPIO-programmed front fill-light torch
+
+maintainers:
+  - Kostiantyn Andriiuk <konstantin@andriyuk.com>
+
+description: |
+  Board-specific stock subtorch programming over active-high TLMM GPIO36.
+  The physical driver IC/current table is unidentified. One stock-derived
+  on mode and off are exposed through LED class, without a diagnostic timeout
+  or per-boot budget. No calibrated intensity or camera flash capability.
+
+allOf:
+  - $ref: common.yaml#
+
+properties:
+  compatible:
+    const: xiaomi,vince-front-fill-light
+  enable-gpios:
+    maxItems: 1
+    description: Non-sleeping active-high MSM8953 TLMM GPIO36; low is off.
+  pinctrl-names:
+    items:
+      - const: default
+  pinctrl-0: true
+  color:
+    const: 0
+  function:
+    const: torch
+  function-enumerator:
+    const: 1
+
+required:
+  - compatible
+  - enable-gpios
+  - pinctrl-names
+  - pinctrl-0
+  - color
+  - function
+  - function-enumerator
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/leds/common.h>
+    front-fill-light {
+        compatible = "xiaomi,vince-front-fill-light";
+        enable-gpios = <&tlmm 36 GPIO_ACTIVE_HIGH>;
+        pinctrl-names = "default";
+        pinctrl-0 = <&gpio_front_fill_light_default>;
+        color = <LED_COLOR_ID_WHITE>;
+        function = LED_FUNCTION_TORCH;
+        function-enumerator = <1>;
+    };
