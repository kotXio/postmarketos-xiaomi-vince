diff --git a/drivers/leds/leds-vince-front-fill-test.c b/drivers/leds/leds-vince-front-fill-test.c
deleted file mode 100644
index 62da607781b0..000000000000
--- a/drivers/leds/leds-vince-front-fill-test.c
+++ /dev/null
@@ -1,253 +0,0 @@
-// SPDX-License-Identifier: GPL-2.0-only
-/*
- * Bounded experimental front fill-light control for Xiaomi Redmi 5 Plus.
- * Pulse sequence derived from Xiaomi msm_frontflash.c (GPL-2.0-only):
- * Copyright (c) 2009-2016, The Linux Foundation. All rights reserved.
- * Copyright (C) 2018 XiaoMi, Inc.
- * Copyright (C) 2026 Kostiantyn Andriiuk <konstantin@andriyuk.com>
- *
- * This is NOT a calibrated flash driver or a general-purpose LED interface.
- * The physical driver IC/current table is unknown. No continuous-on mode.
- */
-
-#include <linux/atomic.h>
-#include <linux/capability.h>
-#include <linux/delay.h>
-#include <linux/device.h>
-#include <linux/gpio/consumer.h>
-#include <linux/hrtimer.h>
-#include <linux/interrupt.h>
-#include <linux/ktime.h>
-#include <linux/math64.h>
-#include <linux/module.h>
-#include <linux/mutex.h>
-#include <linux/of.h>
-#include <linux/of_gpio.h>
-#include <linux/platform_device.h>
-#include <linux/pm.h>
-
-#define VINCE_FILL_ON_MS		100
-#define VINCE_FILL_PULSES		10
-#define VINCE_FILL_RESET_MS	5
-
-/* Built-in only: unbind/rebind must not grant another attempt this boot. */
-static atomic_t vince_fill_boot_attempt = ATOMIC_INIT(0);
-
-struct vince_fill_test {
-	struct device *dev;
-	struct gpio_desc *enable;
-	struct hrtimer off_timer;
-	struct mutex lock;
-	u64 on_ns;
-	u64 off_ns;
-	bool blocked;
-};
-
-static enum hrtimer_restart vince_fill_timer_off(struct hrtimer *timer)
-{
-	struct vince_fill_test *fill = container_of(timer, struct vince_fill_test,
-						 off_timer);
-
-	/* Probe rejects sleepable GPIOs; this runs in hard IRQ context. */
-	gpiod_set_value(fill->enable, 0);
-	fill->off_ns = ktime_get_ns();
-	return HRTIMER_NORESTART;
-}
-
-static void vince_fill_off_locked(struct vince_fill_test *fill)
-{
-	hrtimer_cancel(&fill->off_timer);
-	gpiod_set_value(fill->enable, 0);
-	if (fill->on_ns && !fill->off_ns)
-		fill->off_ns = ktime_get_ns();
-}
-
-static void vince_fill_quiesce(void *data)
-{
-	struct vince_fill_test *fill = data;
-
-	mutex_lock(&fill->lock);
-	fill->blocked = true;
-	vince_fill_off_locked(fill);
-	mutex_unlock(&fill->lock);
-}
-
-static ssize_t state_show(struct device *dev, struct device_attribute *attr,
-			 char *buf)
-{
-	struct vince_fill_test *fill = dev_get_drvdata(dev);
-	u64 elapsed_us = 0;
-	ssize_t ret;
-
-	mutex_lock(&fill->lock);
-	if (fill->off_ns > fill->on_ns)
-		elapsed_us = div_u64(fill->off_ns - fill->on_ns, NSEC_PER_USEC);
-	ret = sysfs_emit(buf,
-		"attempts=%d blocked=%d logical_level=%d on_ms=%d pulses=%d software_on_us=%llu\n",
-		atomic_read(&vince_fill_boot_attempt), fill->blocked,
-		gpiod_get_value(fill->enable), VINCE_FILL_ON_MS,
-		VINCE_FILL_PULSES, (unsigned long long)elapsed_us);
-	mutex_unlock(&fill->lock);
-	return ret;
-}
-static DEVICE_ATTR_RO(state);
-
-static ssize_t fire_once_store(struct device *dev, struct device_attribute *attr,
-			      const char *buf, size_t count)
-{
-	struct vince_fill_test *fill = dev_get_drvdata(dev);
-	unsigned long flags;
-	int i, ret;
-
-	if (!capable(CAP_SYS_RAWIO))
-		return -EPERM;
-	if (!sysfs_streq(buf, "1"))
-		return -EINVAL;
-
-	mutex_lock(&fill->lock);
-	if (fill->blocked) {
-		ret = -EBUSY;
-		goto unlock;
-	}
-	if (atomic_cmpxchg(&vince_fill_boot_attempt, 0, 1)) {
-		ret = -EALREADY;
-		goto unlock;
-	}
-
-	/* Consume the sole attempt even if setup fails; never retry silently. */
-	ret = gpiod_direction_output(fill->enable, 0);
-	if (ret)
-		goto off;
-	msleep(VINCE_FILL_RESET_MS);
-
-	/* Arm before the first high, atomically with the short pulse sequence.
-	 * A late sysfs worker cannot extend the on time while hard IRQs run.
-	 * No logging/sleeping between edges. Delays are not scope measurements.
-	 */
-	local_irq_save(flags);
-	fill->on_ns = ktime_get_ns();
-	fill->off_ns = 0;
-	hrtimer_start(&fill->off_timer, ms_to_ktime(VINCE_FILL_ON_MS),
-		      HRTIMER_MODE_REL_HARD);
-	gpiod_set_value(fill->enable, 1);
-	udelay(25);
-	for (i = 0; i < VINCE_FILL_PULSES; i++) {
-		gpiod_set_value(fill->enable, 0);
-		udelay(1);
-		gpiod_set_value(fill->enable, 1);
-		udelay(1);
-	}
-	local_irq_restore(flags);
-	msleep(VINCE_FILL_ON_MS);
-off:
-	vince_fill_off_locked(fill);
-	msleep(VINCE_FILL_RESET_MS);
-	dev_info(dev, "[vince-front-fill] attempt complete: ret=%d level=%d on_us=%llu\n",
-		 ret, gpiod_get_value(fill->enable),
-		 (unsigned long long)(fill->off_ns > fill->on_ns ?
-		 div_u64(fill->off_ns - fill->on_ns, NSEC_PER_USEC) : 0));
-unlock:
-	mutex_unlock(&fill->lock);
-	return ret ? ret : count;
-}
-static DEVICE_ATTR(fire_once, 0200, NULL, fire_once_store);
-
-static struct attribute *vince_fill_attrs[] = {
-	&dev_attr_state.attr,
-	&dev_attr_fire_once.attr,
-	NULL,
-};
-static const struct attribute_group vince_fill_group = {
-	.attrs = vince_fill_attrs,
-};
-
-static int vince_fill_suspend(struct device *dev)
-{
-	vince_fill_quiesce(dev_get_drvdata(dev));
-	return 0;
-}
-
-static int vince_fill_resume(struct device *dev)
-{
-	struct vince_fill_test *fill = dev_get_drvdata(dev);
-
-	mutex_lock(&fill->lock);
-	vince_fill_off_locked(fill);
-	fill->blocked = false;
-	mutex_unlock(&fill->lock);
-	/* Never restore brightness or reset the global attempt budget. */
-	return 0;
-}
-static DEFINE_SIMPLE_DEV_PM_OPS(vince_fill_pm_ops, vince_fill_suspend,
-			      vince_fill_resume);
-
-static int vince_fill_probe(struct platform_device *pdev)
-{
-	struct device *dev = &pdev->dev;
-	struct of_phandle_args gpio;
-	struct vince_fill_test *fill;
-	bool correct_gpio;
-	int ret;
-
-	if (!of_machine_is_compatible("xiaomi,vince"))
-		return -ENODEV;
-	ret = of_parse_phandle_with_args(dev->of_node, "enable-gpios",
-					 "#gpio-cells", 0, &gpio);
-	if (ret)
-		return ret;
-	/* Check identity BEFORE claiming/driving any GPIO. */
-	correct_gpio = gpio.args_count == 2 && gpio.args[0] == 36 &&
-		gpio.args[1] == 0 &&
-		of_device_is_compatible(gpio.np, "qcom,msm8953-pinctrl");
-	of_node_put(gpio.np);
-	if (!correct_gpio)
-		return dev_err_probe(dev, -EINVAL, "requires active-high TLMM GPIO36\n");
-
-	fill = devm_kzalloc(dev, sizeof(*fill), GFP_KERNEL);
-	if (!fill)
-		return -ENOMEM;
-	fill->dev = dev;
-	mutex_init(&fill->lock);
-	hrtimer_setup(&fill->off_timer, vince_fill_timer_off, CLOCK_MONOTONIC,
-		      HRTIMER_MODE_REL_HARD);
-	fill->enable = devm_gpiod_get(dev, "enable", GPIOD_OUT_LOW);
-	if (IS_ERR(fill->enable))
-		return dev_err_probe(dev, PTR_ERR(fill->enable), "cannot claim enable GPIO\n");
-	if (gpiod_cansleep(fill->enable) || gpiod_is_active_low(fill->enable))
-		return dev_err_probe(dev, -EINVAL, "requires non-sleeping active-high GPIO\n");
-	platform_set_drvdata(pdev, fill);
-	ret = devm_add_action_or_reset(dev, vince_fill_quiesce, fill);
-	if (ret)
-		return ret;
-	ret = devm_device_add_group(dev, &vince_fill_group);
-	if (ret)
-		return ret;
-	dev_info(dev, "[vince-front-fill] ready, off; one 100 ms attempt per boot\n");
-	return 0;
-}
-
-static void vince_fill_shutdown(struct platform_device *pdev)
-{
-	vince_fill_quiesce(platform_get_drvdata(pdev));
-}
-
-static const struct of_device_id vince_fill_match[] = {
-	{ .compatible = "xiaomi,vince-front-fill-light-test" },
-	{ }
-};
-MODULE_DEVICE_TABLE(of, vince_fill_match);
-
-static struct platform_driver vince_fill_driver = {
-	.probe = vince_fill_probe,
-	.shutdown = vince_fill_shutdown,
-	.driver = {
-		.name = "vince-front-fill-test",
-		.of_match_table = vince_fill_match,
-		.pm = pm_sleep_ptr(&vince_fill_pm_ops),
-	},
-};
-builtin_platform_driver(vince_fill_driver);
-
-MODULE_AUTHOR("Kostiantyn Andriiuk <konstantin@andriyuk.com>");
-MODULE_DESCRIPTION("One-shot-only experimental Vince front fill light");
-MODULE_LICENSE("GPL");
diff --git a/drivers/leds/leds-vince-front-fill.c b/drivers/leds/leds-vince-front-fill.c
new file mode 100644
index 000000000000..86ee599b9db0
--- /dev/null
+++ b/drivers/leds/leds-vince-front-fill.c
@@ -0,0 +1,195 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Xiaomi Redmi 5 Plus front fill-light torch.
+ * GPIO programming derived from Xiaomi msm_frontflash.c (GPL-2.0-only):
+ * Copyright (c) 2009-2016, The Linux Foundation. All rights reserved.
+ * Copyright (C) 2018 XiaoMi, Inc.
+ * Copyright (C) 2026 Kostiantyn Andriiuk <konstantin@andriyuk.com>
+ *
+ * One stock-derived mode, not calibrated current control. No hardware
+ * watchdog/cutoff is known. Userspace owns the normal on/off duration.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/interrupt.h>
+#include <linux/leds.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_gpio.h>
+#include <linux/platform_device.h>
+#include <linux/pm.h>
+
+#define VINCE_FILL_PULSES	10
+#define VINCE_FILL_RESET_MS	5
+
+struct vince_fill {
+	struct gpio_desc *enable;
+	struct led_classdev led;
+	struct mutex lock;
+	bool blocked;
+	bool on;
+};
+
+static void vince_fill_off_locked(struct vince_fill *fill)
+{
+	gpiod_set_value(fill->enable, 0);
+	fill->on = false;
+	fill->led.brightness = LED_OFF;
+	msleep(VINCE_FILL_RESET_MS);
+}
+
+static int vince_fill_brightness_set(struct led_classdev *led,
+				     enum led_brightness brightness)
+{
+	struct vince_fill *fill = container_of(led, struct vince_fill, led);
+	unsigned long flags;
+	int i, ret = 0;
+
+	mutex_lock(&fill->lock);
+	if (brightness == LED_OFF) {
+		vince_fill_off_locked(fill);
+		goto unlock;
+	}
+	if (fill->blocked) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	if (fill->on)
+		goto unlock;
+
+	ret = gpiod_direction_output(fill->enable, 0);
+	if (ret) {
+		vince_fill_off_locked(fill);
+		goto unlock;
+	}
+	msleep(VINCE_FILL_RESET_MS);
+
+	/* Stock subtorch programming, not plain GPIO high or brightness PWM. */
+	local_irq_save(flags);
+	gpiod_set_value(fill->enable, 1);
+	udelay(25);
+	for (i = 0; i < VINCE_FILL_PULSES; i++) {
+		gpiod_set_value(fill->enable, 0);
+		udelay(1);
+		gpiod_set_value(fill->enable, 1);
+		udelay(1);
+	}
+	local_irq_restore(flags);
+	fill->on = true;
+unlock:
+	mutex_unlock(&fill->lock);
+	return ret;
+}
+
+static enum led_brightness vince_fill_brightness_get(struct led_classdev *led)
+{
+	struct vince_fill *fill = container_of(led, struct vince_fill, led);
+
+	/* Probe requires a non-sleeping GPIO; report logical output, not lux. */
+	return gpiod_get_value(fill->enable) > 0 ? 1 : LED_OFF;
+}
+
+static void vince_fill_quiesce(void *data)
+{
+	struct vince_fill *fill = data;
+
+	mutex_lock(&fill->lock);
+	fill->blocked = true;
+	vince_fill_off_locked(fill);
+	mutex_unlock(&fill->lock);
+}
+
+static int vince_fill_suspend(struct device *dev)
+{
+	vince_fill_quiesce(dev_get_drvdata(dev));
+	return 0;
+}
+
+static int vince_fill_resume(struct device *dev)
+{
+	struct vince_fill *fill = dev_get_drvdata(dev);
+
+	mutex_lock(&fill->lock);
+	vince_fill_off_locked(fill);
+	fill->blocked = false;
+	mutex_unlock(&fill->lock);
+	/* Do not restore a pre-suspend on state or use LED_CORE_SUSPENDRESUME. */
+	return 0;
+}
+static DEFINE_SIMPLE_DEV_PM_OPS(vince_fill_pm_ops, vince_fill_suspend,
+			      vince_fill_resume);
+
+static int vince_fill_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct led_init_data init = { .fwnode = dev_fwnode(dev) };
+	struct of_phandle_args gpio;
+	struct vince_fill *fill;
+	bool correct_gpio;
+	int ret;
+
+	if (!of_machine_is_compatible("xiaomi,vince"))
+		return -ENODEV;
+	ret = of_parse_phandle_with_args(dev->of_node, "enable-gpios",
+					 "#gpio-cells", 0, &gpio);
+	if (ret)
+		return ret;
+	correct_gpio = gpio.args_count == 2 && gpio.args[0] == 36 &&
+		gpio.args[1] == 0 &&
+		of_device_is_compatible(gpio.np, "qcom,msm8953-pinctrl");
+	of_node_put(gpio.np);
+	if (!correct_gpio)
+		return dev_err_probe(dev, -EINVAL, "requires active-high TLMM GPIO36\n");
+
+	fill = devm_kzalloc(dev, sizeof(*fill), GFP_KERNEL);
+	if (!fill)
+		return -ENOMEM;
+	mutex_init(&fill->lock);
+	fill->enable = devm_gpiod_get(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(fill->enable))
+		return dev_err_probe(dev, PTR_ERR(fill->enable), "cannot claim enable GPIO\n");
+	if (gpiod_cansleep(fill->enable) || gpiod_is_active_low(fill->enable))
+		return dev_err_probe(dev, -EINVAL, "requires non-sleeping active-high GPIO\n");
+	platform_set_drvdata(pdev, fill);
+	fill->led.max_brightness = 1;
+	fill->led.brightness_set_blocking = vince_fill_brightness_set;
+	fill->led.brightness_get = vince_fill_brightness_get;
+	ret = devm_led_classdev_register_ext(dev, &fill->led, &init);
+	if (ret)
+		return ret;
+	/* Quiesce before managed LED unregister drains any outstanding work. */
+	ret = devm_add_action_or_reset(dev, vince_fill_quiesce, fill);
+	if (ret)
+		return ret;
+	dev_info(dev, "front fill-light %s ready, off; stock torch mode\n",
+		 fill->led.name);
+	return 0;
+}
+
+static void vince_fill_shutdown(struct platform_device *pdev)
+{
+	vince_fill_quiesce(platform_get_drvdata(pdev));
+}
+
+static const struct of_device_id vince_fill_of_match[] = {
+	{ .compatible = "xiaomi,vince-front-fill-light" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, vince_fill_of_match);
+
+static struct platform_driver vince_fill_driver = {
+	.probe = vince_fill_probe,
+	.shutdown = vince_fill_shutdown,
+	.driver = {
+		.name = "vince-front-fill-light",
+		.of_match_table = vince_fill_of_match,
+		.pm = pm_sleep_ptr(&vince_fill_pm_ops),
+	},
+};
+builtin_platform_driver(vince_fill_driver);
+
+MODULE_AUTHOR("Kostiantyn Andriiuk <konstantin@andriyuk.com>");
+MODULE_DESCRIPTION("Xiaomi Vince stock-mode front fill-light LED torch");
+MODULE_LICENSE("GPL");
