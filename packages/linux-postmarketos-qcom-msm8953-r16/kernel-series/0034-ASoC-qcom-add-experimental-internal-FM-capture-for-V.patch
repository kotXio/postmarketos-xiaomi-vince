 };
 
 struct q6afe_port;
 
 struct q6afe_port *q6afe_port_get_from_id(struct device *dev, int id);
 int q6afe_port_start(struct q6afe_port *port);
+int q6afe_fm_port_prepare(struct q6afe_port *port, struct q6afe_fm_cfg *cfg);
 int q6afe_port_stop(struct q6afe_port *port);
 void q6afe_port_put(struct q6afe_port *port);
 int q6afe_get_port_id(int index);
diff --git a/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.c b/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.c
index 4eed54b071a5..bfb5dd4e480e 100644
--- a/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.c
+++ b/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.c
@@ -97,6 +97,19 @@
 	}
 
 static struct snd_soc_dai_driver q6dsp_audio_fe_dais[] = {
+	{
+		.id = INTERNAL_FM_TX,
+		.name = "INTERNAL_FM_TX",
+		.capture = {
+			.stream_name = "Internal FM Capture",
+			.rates = SNDRV_PCM_RATE_48000,
+			.formats = SNDRV_PCM_FMTBIT_S16_LE,
+			.channels_min = 2,
+			.channels_max = 2,
+			.rate_min = 48000,
+			.rate_max = 48000,
+		},
+	},
 	{
 		.playback = {
 			.stream_name = "USB Playback",
@@ -644,6 +657,9 @@ struct snd_soc_dai_driver *q6dsp_audio_ports_set_config(struct device *dev,
 		case WSA_CODEC_DMA_RX_0 ... RX_CODEC_DMA_RX_7:
 			q6dsp_audio_fe_dais[i].ops = cfg->q6dma_ops;
 			break;
+		case INTERNAL_FM_TX:
+			q6dsp_audio_fe_dais[i].ops = cfg->q6fm_ops;
+			break;
 		case USB_RX:
 			q6dsp_audio_fe_dais[i].ops = cfg->q6usb_ops;
 			break;
diff --git a/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.h b/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.h
index d8dde6dd0aca..481c4e04d601 100644
