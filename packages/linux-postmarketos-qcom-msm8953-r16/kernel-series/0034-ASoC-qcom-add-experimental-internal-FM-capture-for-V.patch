From 3c885b7a677a00497decdef3ac0305bf74c21000 Mon Sep 17 00:00:00 2001
From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Date: Sun, 13 Sep 2026 14:00:06 +0300
Subject: [PATCH 34/42] ASoC: qcom: add experimental internal FM capture for
 Vince

---
 .../boot/dts/qcom/msm8953-xiaomi-vince.dts    | 11 +++++
 .../sound/qcom,q6dsp-lpass-ports.h            |  2 +
 sound/soc/qcom/apq8016_sbc.c                  | 15 +++++++
 sound/soc/qcom/qdsp6/q6afe-dai.c              | 35 +++++++++++++++
 sound/soc/qcom/qdsp6/q6afe.c                  | 43 ++++++++++++++++++-
 sound/soc/qcom/qdsp6/q6afe.h                  | 10 ++++-
 sound/soc/qcom/qdsp6/q6dsp-lpass-ports.c      | 16 +++++++
 sound/soc/qcom/qdsp6/q6dsp-lpass-ports.h      |  1 +
 sound/soc/qcom/qdsp6/q6routing.c              |  4 ++
 9 files changed, 135 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8953-xiaomi-vince.dts b/arch/arm64/boot/dts/qcom/msm8953-xiaomi-vince.dts
index 6794d481a3da..ab1b498a7945 100644
--- a/arch/arm64/boot/dts/qcom/msm8953-xiaomi-vince.dts
+++ b/arch/arm64/boot/dts/qcom/msm8953-xiaomi-vince.dts
@@ -343,6 +343,17 @@ &cdc_pdm_comp_lines_sus
 
 	status = "okay";
 
+	/* Internal FM audio capture; no RF transmitter or external codec. */
+	internal-fm-dai-link {
+		link-name = "Internal FM";
+		cpu {
+			sound-dai = <&q6afedai INTERNAL_FM_TX>;
+		};
+		platform {
+			sound-dai = <&q6routing>;
+		};
+	};
+
 	/* TAS2557 external speaker amplifier on Quinary MI2S */
 	quinary-mi2s-dai-link {
 		link-name = "Quinary MI2S";
diff --git a/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h b/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h
index 6d1ce7f5da51..e16dfa1739f4 100644
--- a/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h
+++ b/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h
@@ -140,6 +140,8 @@
 #define DISPLAY_PORT_RX_6	134
 #define DISPLAY_PORT_RX_7	135
 #define USB_RX			136
+/* Internal FM audio towards ADSP capture, not FM RF transmission. */
+#define INTERNAL_FM_TX		137
 
 #define LPASS_CLK_ID_PRI_MI2S_IBIT	1
 #define LPASS_CLK_ID_PRI_MI2S_EBIT	2
diff --git a/sound/soc/qcom/apq8016_sbc.c b/sound/soc/qcom/apq8016_sbc.c
index 1c6c27a2fa8b..9c7c81ccc350 100644
--- a/sound/soc/qcom/apq8016_sbc.c
+++ b/sound/soc/qcom/apq8016_sbc.c
@@ -316,9 +316,24 @@ static void msm8916_qdsp6_add_ops(struct snd_soc_card *card)
 static void msm8953_qdsp6_add_ops(struct snd_soc_card *card)
 {
 	struct apq8016_sbc_data *pdata = snd_soc_card_get_drvdata(card);
+	struct snd_soc_dai_link *link;
+	int i;
 
 	pdata->use_ibit_clk = true;
 	msm8916_qdsp6_add_ops(card);
+
+	for_each_card_prelinks(card, i, link) {
+		if (link->id != INTERNAL_FM_TX)
+			continue;
+
+		/* Internal DSP capture: dummy codec, no external MI2S clocks. */
+		link->dynamic = 0;
+		link->no_pcm = 1;
+		link->init = NULL;
+		link->ops = NULL;
+		link->be_hw_params_fixup = msm8916_qdsp6_be_hw_params_fixup;
+		link->ignore_suspend = 0;
+	}
 }
 
 static const struct snd_kcontrol_new apq8016_sbc_snd_controls[] = {
diff --git a/sound/soc/qcom/qdsp6/q6afe-dai.c b/sound/soc/qcom/qdsp6/q6afe-dai.c
index 0f47aadaabe1..ce599a5127a4 100644
--- a/sound/soc/qcom/qdsp6/q6afe-dai.c
+++ b/sound/soc/qcom/qdsp6/q6afe-dai.c
@@ -34,6 +34,24 @@ struct q6afe_dai_data {
 	struct q6afe_dai_priv_data priv[AFE_PORT_MAX];
 };
 
+static int q6fm_hw_params(struct snd_pcm_substream *substream,
+			 struct snd_pcm_hw_params *params,
+			 struct snd_soc_dai *dai)
+{
+	struct q6afe_dai_data *data = dev_get_drvdata(dai->dev);
+	struct q6afe_fm_cfg *fm = &data->port_config[dai->id].fm;
+
+	if (substream->stream != SNDRV_PCM_STREAM_CAPTURE ||
+	    params_rate(params) != 48000 || params_channels(params) != 2 ||
+	    params_format(params) != SNDRV_PCM_FORMAT_S16_LE)
+		return -EINVAL;
+
+	fm->sample_rate = params_rate(params);
+	fm->num_channels = params_channels(params);
+	fm->bit_width = 16;
+	return 0;
+}
+
 static int q6slim_hw_params(struct snd_pcm_substream *substream,
 			    struct snd_pcm_hw_params *params,
 			    struct snd_soc_dai *dai)
@@ -400,6 +418,12 @@ static int q6afe_dai_prepare(struct snd_pcm_substream *substream,
 	}
 
 	switch (dai->id) {
+	case INTERNAL_FM_TX:
+		rc = q6afe_fm_port_prepare(dai_data->port[dai->id],
+					  &dai_data->port_config[dai->id].fm);
+		if (rc < 0)
+			return rc;
+		break;
 	case HDMI_RX:
 	case DISPLAY_PORT_RX:
 		q6afe_hdmi_port_prepare(dai_data->port[dai->id],
@@ -517,6 +541,7 @@ static int q6afe_mi2s_set_sysclk(struct snd_soc_dai *dai,
 }
 
 static const struct snd_soc_dapm_route q6afe_dapm_routes[] = {
+	{"INTERNAL_FM_TX", NULL, "Internal FM Capture"},
 	{"HDMI Playback", NULL, "HDMI_RX"},
 	{"DISPLAY_PORT_RX_0 Playback", NULL, "DISPLAY_PORT_RX"},
 	{"Slimbus Playback", NULL, "SLIMBUS_0_RX"},
@@ -706,6 +731,14 @@ static const struct snd_soc_dai_ops q6afe_usb_ops = {
 	 */
 };
 
+static const struct snd_soc_dai_ops q6fm_ops = {
+	.probe = msm_dai_q6_dai_probe,
+	.remove = msm_dai_q6_dai_remove,
+	.prepare = q6afe_dai_prepare,
+	.hw_params = q6fm_hw_params,
+	.shutdown = q6afe_dai_shutdown,
+};
+
 static const struct snd_soc_dai_ops q6hdmi_ops = {
 	.probe			= msm_dai_q6_dai_probe,
 	.remove			= msm_dai_q6_dai_remove,
@@ -755,6 +788,7 @@ static const struct snd_soc_dai_ops q6dma_ops = {
 };
 
 static const struct snd_soc_dapm_widget q6afe_dai_widgets[] = {
+	SND_SOC_DAPM_AIF_OUT("INTERNAL_FM_TX", NULL, 0, SND_SOC_NOPM, 0, 0),
 	SND_SOC_DAPM_AIF_IN("HDMI_RX", NULL, 0, SND_SOC_NOPM, 0, 0),
 	SND_SOC_DAPM_AIF_IN("SLIMBUS_0_RX", NULL, 0, SND_SOC_NOPM, 0, 0),
 	SND_SOC_DAPM_AIF_IN("SLIMBUS_1_RX", NULL, 0, SND_SOC_NOPM, 0, 0),
@@ -1121,6 +1155,7 @@ static int q6afe_dai_dev_probe(struct platform_device *pdev)
 	cfg.q6tdm_ops = &q6tdm_ops;
 	cfg.q6dma_ops = &q6dma_ops;
 	cfg.q6usb_ops = &q6afe_usb_ops;
+	cfg.q6fm_ops = &q6fm_ops;
 	dais = q6dsp_audio_ports_set_config(dev, &cfg, &num_dais);
 
 	return devm_snd_soc_register_component(dev, &q6afe_dai_component, dais, num_dais);
diff --git a/sound/soc/qcom/qdsp6/q6afe.c b/sound/soc/qcom/qdsp6/q6afe.c
index 43d877322bae..43efe2c4e010 100644
--- a/sound/soc/qcom/qdsp6/q6afe.c
+++ b/sound/soc/qcom/qdsp6/q6afe.c
@@ -128,6 +128,10 @@
 #define AFE_PORT_ID_TERTIARY_MI2S_TX        0x1005
 #define AFE_PORT_ID_QUATERNARY_MI2S_RX      0x1006
 #define AFE_PORT_ID_QUATERNARY_MI2S_TX      0x1007
+#define AFE_PORT_ID_INTERNAL_FM_TX	    0x3005
+#define AFE_PARAM_ID_INTERNAL_BT_FM_CONFIG 0x00010211
+#define AFE_API_VERSION_INTERNAL_BT_FM_CONFIG 1
+
 #define AFE_PORT_ID_QUINARY_MI2S_RX	    0x1016
 #define AFE_PORT_ID_QUINARY_MI2S_TX	    0x1017
 
@@ -603,7 +607,17 @@ struct afe_param_id_usb_audio_svc_interval {
 	u32	svc_interval;
 } __packed;
 
+struct afe_param_id_internal_bt_fm_cfg {
+	u32 bt_fm_cfg_minor_version;
+	u16 num_channels;
+	u16 bit_width;
+	u32 sample_rate;
+} __packed;
+
+static_assert(sizeof(struct afe_param_id_internal_bt_fm_cfg) == 12);
+
 union afe_port_config {
+	struct afe_param_id_internal_bt_fm_cfg fm_cfg;
 	struct afe_param_id_hdmi_multi_chan_audio_cfg hdmi_multi_ch;
 	struct afe_param_id_slimbus_cfg           slim_cfg;
 	struct afe_param_id_i2s_cfg	i2s_cfg;
@@ -925,6 +939,7 @@ static struct afe_port_map port_maps[AFE_PORT_MAX] = {
 	[RX_CODEC_DMA_RX_7] = { AFE_PORT_ID_RX_CODEC_DMA_RX_7,
 				RX_CODEC_DMA_RX_7, 1, 1},
 	[USB_RX] = { AFE_PORT_ID_USB_RX, USB_RX, 1, 1},
+	[INTERNAL_FM_TX] = { AFE_PORT_ID_INTERNAL_FM_TX, INTERNAL_FM_TX, 0, 1},
 };
 
 static void q6afe_port_free(struct kref *ref)
@@ -1486,6 +1501,24 @@ void q6afe_hdmi_port_prepare(struct q6afe_port *port,
 }
 EXPORT_SYMBOL_GPL(q6afe_hdmi_port_prepare);
 
+int q6afe_fm_port_prepare(struct q6afe_port *port, struct q6afe_fm_cfg *cfg)
+{
+	struct afe_param_id_internal_bt_fm_cfg *fm = &port->port_cfg.fm_cfg;
+
+	if (port->id != AFE_PORT_ID_INTERNAL_FM_TX ||
+	    cfg->sample_rate != 48000 || cfg->num_channels != 2 ||
+	    cfg->bit_width != 16)
+		return -EINVAL;
+
+	memset(&port->port_cfg, 0, sizeof(port->port_cfg));
+	fm->bt_fm_cfg_minor_version = AFE_API_VERSION_INTERNAL_BT_FM_CONFIG;
+	fm->num_channels = cfg->num_channels;
+	fm->bit_width = cfg->bit_width;
+	fm->sample_rate = cfg->sample_rate;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(q6afe_fm_port_prepare);
+
 /**
  * q6afe_i2s_port_prepare() - Prepare i2s afe port.
  *
@@ -1666,10 +1699,15 @@ int q6afe_port_start(struct q6afe_port *port)
 	int ret, param_id = port->cfg_type;
 	struct apr_pkt *pkt;
 	int pkt_size;
+	size_t cfg_size = sizeof(port->port_cfg);
+
+	/* Send the exact stock FM ABI, not the larger MI2S/TDM union. */
+	if (param_id == AFE_PARAM_ID_INTERNAL_BT_FM_CONFIG)
+		cfg_size = sizeof(port->port_cfg.fm_cfg);
 
 	ret  = q6afe_port_set_param_v2(port, &port->port_cfg, param_id,
 				       AFE_MODULE_AUDIO_DEV_INTERFACE,
-				       sizeof(port->port_cfg));
+				       cfg_size);
 	if (ret) {
 		dev_err(afe->dev, "AFE enable for port 0x%x failed %d\n",
 			port_id, ret);
@@ -1785,6 +1823,9 @@ struct q6afe_port *q6afe_port_get_from_id(struct device *dev, int id)
 	case AFE_PORT_ID_WSA_CODEC_DMA_RX_0 ... AFE_PORT_ID_RX_CODEC_DMA_RX_7:
 		cfg_type = AFE_PARAM_ID_CODEC_DMA_CONFIG;
 		break;
+	case AFE_PORT_ID_INTERNAL_FM_TX:
+		cfg_type = AFE_PARAM_ID_INTERNAL_BT_FM_CONFIG;
+		break;
 	case AFE_PORT_ID_USB_RX:
 		cfg_type = AFE_PARAM_ID_USB_AUDIO_CONFIG;
 		break;
diff --git a/sound/soc/qcom/qdsp6/q6afe.h b/sound/soc/qcom/qdsp6/q6afe.h
index a29abe4ce436..3451f2d13859 100644
