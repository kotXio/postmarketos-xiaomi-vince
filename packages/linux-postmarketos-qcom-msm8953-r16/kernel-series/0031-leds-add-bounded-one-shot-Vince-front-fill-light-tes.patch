diff --git a/Documentation/ABI/testing/sysfs-driver-vince-front-fill b/Documentation/ABI/testing/sysfs-driver-vince-front-fill
new file mode 100644
index 000000000000..939482c71101
--- /dev/null
+++ b/Documentation/ABI/testing/sysfs-driver-vince-front-fill
@@ -0,0 +1,27 @@
+What:		/sys/bus/platform/devices/front-fill-light-test/state
+Date:		September 2026
+Contact:	Kostiantyn Andriiuk <konstantin@andriyuk.com>
+Description:
+		Experimental Xiaomi Vince front fill-light diagnostic state.
+		Reports global attempt count, suspend block, logical GPIO
+		readback, fixed on_ms=100/pulses=10 and software_on_us. The
+		timestamp measures software GPIO writes, not physical current
+		or waveform timing. Before firing: attempts=0, level=0.
+		The driver IC/current table and hardware cutoff are unknown.
+
+What:		/sys/bus/platform/devices/front-fill-light-test/fire_once
+Date:		September 2026
+Contact:	Kostiantyn Andriiuk <konstantin@andriyuk.com>
+Description:
+		Write exactly 1, as root with CAP_SYS_RAWIO, to request the
+		stock ten-pulse front subtorch sequence. A hard hrtimer is
+		armed before the first high and drives low after 100 ms.
+		The request also forces off before returning. Only one attempt
+		per kernel boot, including across unbind/rebind and setup
+		failure. Further requests return EALREADY; during suspend
+		they return EBUSY. No brightness/current/duration selection,
+		automatic trigger or camera-framework integration exists.
+		Probe, managed cleanup, shutdown and suspend force low;
+		resume never restores light or replenishes the attempt.
+		Software timing depends on a functioning CPU and interrupts.
+		It is not a hardware cutoff during a kernel/CPU hang.
diff --git a/Documentation/devicetree/bindings/leds/xiaomi,vince-front-fill-light-test.yaml b/Documentation/devicetree/bindings/leds/xiaomi,vince-front-fill-light-test.yaml
new file mode 100644
index 000000000000..9574b6b37fbd
--- /dev/null
+++ b/Documentation/devicetree/bindings/leds/xiaomi,vince-front-fill-light-test.yaml
@@ -0,0 +1,50 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/xiaomi,vince-front-fill-light-test.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Experimental Xiaomi Redmi 5 Plus front fill-light one-shot test
+
+maintainers:
+  - Kostiantyn Andriiuk <konstantin@andriyuk.com>
+
+description: |
+  Provisional board-specific diagnostic binding, not an identified driver-IC
+  binding or upstream-ready LED ABI. Stock msm_frontflash.c programs the
+  separate front fill light over TLMM GPIO36 with ten short pulses. The IC
+  and calibrated current/mode table are unknown. A dedicated built-in driver
+  provides one root-only 100 ms attempt per kernel boot and initializes off.
+  No automatic trigger, continuous-on mode, current setting or charger control.
+
+properties:
+  compatible:
+    const: xiaomi,vince-front-fill-light-test
+
+  enable-gpios:
+    maxItems: 1
+    description: Non-sleeping, active-high MSM8953 TLMM GPIO36; low is off.
+
+  pinctrl-names:
+    items:
+      - const: default
+
+  pinctrl-0: true
+
+required:
+  - compatible
+  - enable-gpios
+  - pinctrl-names
+  - pinctrl-0
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    front-fill-light-test {
+        compatible = "xiaomi,vince-front-fill-light-test";
+        enable-gpios = <&tlmm 36 GPIO_ACTIVE_HIGH>;
+        pinctrl-names = "default";
+        pinctrl-0 = <&gpio_front_fill_light_default>;
+    };
diff --git a/arch/arm64/boot/dts/qcom/msm8953-xiaomi-vince.dts b/arch/arm64/boot/dts/qcom/msm8953-xiaomi-vince.dts
index 6c209ba8d095..1962bd904f90 100644
--- a/arch/arm64/boot/dts/qcom/msm8953-xiaomi-vince.dts
+++ b/arch/arm64/boot/dts/qcom/msm8953-xiaomi-vince.dts
@@ -17,6 +17,13 @@ / {
 	compatible = "xiaomi,vince", "qcom,msm8953";
 	qcom,board-id = <0x1000b 0x08>;
 
+	front-fill-light-test {
+		compatible = "xiaomi,vince-front-fill-light-test";
+		enable-gpios = <&tlmm 36 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&gpio_front_fill_light_default>;
+	};
+
 	gpio-keys {
 		pinctrl-names = "default";
 		pinctrl-0 = <&gpio_hall_sensor_default>;
@@ -361,6 +368,14 @@ &spi_6 {
 &tlmm {
 	gpio-reserved-ranges = <0 4>, <16 4>, <135 4>;
 
+	gpio_front_fill_light_default: front-fill-light-default-state {
+		pins = "gpio36";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		output-low;
+	};
+
 	cam_sensor_rear_default: cam-sensor-rear-default-state {
 		pins = "gpio33", "gpio62";
 		function = "gpio";
diff --git a/drivers/leds/Kconfig b/drivers/leds/Kconfig
index c32164f52384..6f83679a3f7c 100644
--- a/drivers/leds/Kconfig
+++ b/drivers/leds/Kconfig
@@ -1054,6 +1054,15 @@ config LEDS_ACER_A500
 
