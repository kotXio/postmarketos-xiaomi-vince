+config LEDS_VINCE_FRONT_FILL_TEST
+	bool "Bounded one-shot front fill-light test for Xiaomi Vince"
+	depends on ARM64 && ARCH_QCOM && OF && GPIOLIB && HIGH_RES_TIMERS
+	help
+	  Experimental board-only GPIO pulse protocol. Root may request one
+	  100 ms shot per kernel boot. No continuous LED, camera integration
+	  or calibrated current control. Hardware driver IC is unidentified.
+	  Keep disabled outside the explicitly approved Vince test kernel.
+
 comment "Flash and Torch LED drivers"
