# Packages the exact previously qualified aarch64/musl Gallium payload.
# Build the library with build-mesa.sh before changing its checksum.
pkgname=vince-angelfish-mesa-msaa
pkgver=26.1.6
pkgrel=0
pkgdesc="Browser-private Freedreno MSAA GMEM correction for tested Vince stack"
url="https://www.mesa3d.org"
arch="aarch64"
license="MIT AND SGI-B-2.0 AND BSL-1.0"
depends="mesa-dri-gallium=26.1.6-r0 qt6-qtwebengine=6.11.1-r10 angelfish=26.04.2-r0"
options="!strip !check !tracedeps"
source="libgallium-26.1.6.so browser-launch.sh mesa-license.rst"

package() {
    local prefix="$pkgdir/usr/lib/vince-angelfish-mesa-msaa"
    install -Dm755 "$srcdir/libgallium-26.1.6.so" "$prefix/lib/libgallium-26.1.6.so"
    install -Dm755 "$srcdir/browser-launch.sh" "$prefix/angelfish"
    install -Dm644 "$srcdir/mesa-license.rst" "$pkgdir/usr/share/licenses/$pkgname/mesa-license.rst"
}
sha512sums="
