pkgname=postmarketos-vince-fm-radio
pkgver=1.0.0
pkgrel=1
pkgdesc="Lightweight native FM radio controller for Xiaomi Redmi 5 Plus"
url="https://github.com/kotXio/postmarketos-xiaomi-vince"
arch="aarch64"
license="GPL-2.0-only"
depends="alsa-utils gstreamer gst-plugins-base pulseaudio-utils qmlkonsole v4l-utils"
makedepends="build-base linux-headers"

_fmver=2.0.8
source="
	fmtools-$_fmver.tar.gz::https://benpfaff.org/fmtools/fmtools-$_fmver.tar.gz
	0001-vince-fast-binary-service-scan.patch
	vince-fm-radio
	tests/test-station-merge.sh
	vince-fm-radio-headphones.desktop
	vince-fm-radio-speaker.desktop
	"
builddir="$srcdir/fmtools-$_fmver"

build() {
	cc $CPPFLAGS $CFLAGS -DVERSION=\"$_fmver\" \
		-o fm fm.c fmlib.c $LDFLAGS -lm
	cc $CPPFLAGS $CFLAGS -DVERSION=\"$_fmver\" \
		-o fmscan fmscan.c fmlib.c $LDFLAGS -lm
}

check() {
	./fm -q -d "test 100 0" 90.4
	./fmscan -q -d "test 100 0" -s 89.5 -e 90.5 -i 0.1 -t 50 \
		>scan-test.txt
	grep -q '^89.60: ' scan-test.txt
	grep -q '^90.40: ' scan-test.txt
	grep -q '^90.50: ' scan-test.txt
	sh -n "$srcdir/vince-fm-radio"
	sh "$srcdir/test-station-merge.sh" "$srcdir/vince-fm-radio"
}

package() {
	install -Dm755 fm \
		"$pkgdir/usr/libexec/vince-fm-radio/fm"
	install -Dm755 fmscan \
		"$pkgdir/usr/libexec/vince-fm-radio/fmscan"
	install -Dm755 "$srcdir/vince-fm-radio" \
		"$pkgdir/usr/bin/vince-fm-radio"

	install -Dm644 "$srcdir/vince-fm-radio-headphones.desktop" \
		"$pkgdir/usr/share/applications/vince-fm-radio-headphones.desktop"
	install -Dm644 "$srcdir/vince-fm-radio-speaker.desktop" \
		"$pkgdir/usr/share/applications/vince-fm-radio-speaker.desktop"

	install -Dm644 COPYING \
		"$pkgdir/usr/share/licenses/$pkgname/COPYING"
}

