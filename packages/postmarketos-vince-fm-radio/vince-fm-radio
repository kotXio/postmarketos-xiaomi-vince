set -eu

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

card=alsa_card.platform-c051000.sound-card
normal_profile='HiFi (Mic2, Speaker)'
normal_mic=alsa_input.platform-c051000.sound-card.HiFi__Mic2__source
normal_speaker=alsa_output.platform-c051000.sound-card.HiFi__Speaker__sink
fm_source=alsa_input.platform-c051000.sound-card.FM__FM__source
fm_bin=/usr/libexec/vince-fm-radio/fm
scan_bin=/usr/libexec/vince-fm-radio/fmscan

usage() {
    cat <<'EOF'
Usage: vince-fm-radio headphones|speaker
       vince-fm-radio --check

Wired headphones are required as the FM antenna for both outputs.
The application must be run as the logged-in Plasma user, not root.
EOF
}

fail() {
    printf 'STOP: %s\n' "$*" >&2
    exit 1
}

volume_values() {
    awk '
      /^Volume:/ {
        lines++
        for (i=1; i<=NF; i++) {
          if ($i ~ /^[0-9]+$/ && $(i+1) == "/") {
            if ($i+0 > 65536) bad=1
            out = out == "" ? $i : out " " $i
            values++
          }
        }
      }
      END {
        if (bad || lines != 1 || values < 1 || values > 8) exit 2
        print out
      }'
}

mute_value() {
    awk '
      /^Mute:/ {
        lines++
        if ($2 == "yes") value=1
        else if ($2 == "no") value=0
        else bad=1
      }
      END {
        if (bad || lines != 1) exit 2
        print value
      }'
}

valid_frequency() {
    awk -v f="$1" 'BEGIN {
      if (f !~ /^[0-9]+([.][0-9]+)?$/) exit 1
      exit !((f + 0) >= 87.5 && (f + 0) <= 108.0)
    }'
}

normalize_frequency() {
    awk -v f="$1" 'BEGIN { printf "%.1f", f + 0 }'
}

merge_station_files() {
    old_stations=$1
    found_stations=$2
    awk -F'|' '
      FILENAME == ARGV[1] {old[$1]=$2; next}
      {
        name=(($1 in old) && old[$1] !~ /^FM [0-9.]+ MHz$/) ? old[$1] : $2
        print $1 "|" name
      }
    ' "$old_stations" "$found_stations"
}

# Internal seam used only by the offline package regression test.
if [ "${1:-}" = --internal-merge-stations ]; then
    [ "$#" -eq 4 ] || exit 2
    merge_station_files "$2" "$3" >"$4"
    exit 0
fi

check_common() {
    for tool in amixer awk cat cmp grep gst-launch-1.0 id mkdir mktemp \
        mv pactl readlink rm sed sleep sort tr v4l2-ctl wc; do
        command -v "$tool" >/dev/null 2>&1 ||
            fail "required command missing: $tool"
    done
    [ -x "$fm_bin" ] || fail "missing tuner: $fm_bin"
    [ -x "$scan_bin" ] || fail "missing scanner: $scan_bin"
    [ "$(id -u)" -ne 0 ] || fail 'run as the Plasma user, not root'
    [ -r /sys/firmware/devicetree/base/compatible ] ||
        fail 'device-tree compatible is unavailable'
    tr '\000' '\n' </sys/firmware/devicetree/base/compatible |
        grep -Fxq 'xiaomi,vince' || fail 'this package is only for xiaomi,vince'
    [ "$(cat /sys/module/radio_qcom_fm/version 2>/dev/null || true)" = 0.4 ] ||
        fail 'expected radio-qcom-fm version 0.4 is not active'
    if [ ! -r /dev/radio0 ] || [ ! -w /dev/radio0 ]; then
        fail '/dev/radio0 is not accessible; verify membership in video group'
    fi
    v4l2-ctl -d /dev/radio0 --all >/dev/null 2>&1 ||
        fail '/dev/radio0 did not pass the V4L2 probe'
    amixer -c0 cget "iface=CARD,name='Headphone Jack'" |
        grep -q 'values=on' || fail 'connect wired headphones as the FM antenna'
}

if [ "${1:-}" = --help ] || [ "${1:-}" = -h ]; then
    usage
    exit 0
fi

check_common

if [ "${1:-}" = --check ]; then
    printf 'PASS: Vince FM device, antenna, driver and runtime tools are ready.\n'
    exit 0
fi

case ${1:-} in
    headphones)
        fm_profile='FM (FM, Headphones)'
        output_sink=alsa_output.platform-c051000.sound-card.FM__Headphones__sink
        default_volume=25
        ;;
    speaker)
        fm_profile='FM (FM, Speaker)'
        output_sink=alsa_output.platform-c051000.sound-card.FM__Speaker__sink
        default_volume=100
        amixer -c0 cget "name=Speaker Playback Volume" |
            grep -q 'values=0' ||
            fail 'safe TAS2557 hardware gain -28 dB is not active'
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
output=$1

if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "$XDG_RUNTIME_DIR" ]; then
    fail 'XDG_RUNTIME_DIR is unavailable; start from the Plasma session'
fi

lock=$XDG_RUNTIME_DIR/vince-fm-radio.lock
if ! mkdir "$lock" 2>/dev/null; then
    fail 'another Vince FM session appears to be active'
fi

runtime=$(mktemp -d "$XDG_RUNTIME_DIR/vince-fm-radio.XXXXXXXX")
chmod 700 "$runtime"
config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/vince-fm-radio
mkdir -p "$config_dir"
chmod 700 "$config_dir"
stations=$config_dir/stations
state=$config_dir/state
[ -e "$stations" ] || : >"$stations"
chmod 600 "$stations"

player=
tuner=
switched=0
cleanup_done=0

idle() {
    n=0
    while [ "$n" -lt 15 ]; do
        if [ "$(cat /proc/asound/card0/pcm1c/sub0/status)" = closed ] &&
           [ "$(cat /proc/asound/card0/pcm0p/sub0/status)" = closed ]; then
            return 0
        fi
        sleep 1
        n=$((n + 1))
    done
    return 1
}

stop_player() {
    if [ -n "$player" ]; then
        kill -INT "$player" 2>/dev/null || true
        wait "$player" 2>/dev/null || true
        player=
    fi
}

stop_tuner() {
    if [ -n "$tuner" ]; then
        kill "$tuner" 2>/dev/null || true
        wait "$tuner" 2>/dev/null || true
        tuner=
    fi
}

# Invoked indirectly by EXIT and signal traps.
# shellcheck disable=SC2317
cleanup() {
    result=$?
    [ "$cleanup_done" -eq 0 ] || exit "$result"
    cleanup_done=1
    trap - 0 HUP INT TERM
    set +e
    stop_player
    "$fm_bin" -q -d /dev/radio0 off >/dev/null 2>&1
    stop_tuner
    if [ "$switched" -eq 1 ]; then
        pactl set-card-profile "$card" "$normal_profile" || result=3
        pactl set-default-source "$saved_default_source" || result=3
        pactl set-default-sink "$saved_default_sink" || result=3
        # shellcheck disable=SC2086
        pactl set-source-volume "$normal_mic" $saved_mic_volume || result=3
        pactl set-source-mute "$normal_mic" "$saved_mic_mute" || result=3
        # shellcheck disable=SC2086
        pactl set-sink-volume "$normal_speaker" $saved_speaker_volume || result=3
        pactl set-sink-mute "$normal_speaker" "$saved_speaker_mute" || result=3
        idle || result=3
        amixer -c0 contents >"$runtime/mixer-after.txt"
        cmp "$runtime/mixer-before.txt" "$runtime/mixer-after.txt" || result=3
    fi
    rmdir "$lock" 2>/dev/null || true
    if [ "$result" -eq 0 ]; then
        rm -rf "$runtime"
        printf 'FM stopped; previous HiFi profile and levels restored.\n'
    else
        printf 'FM failed; diagnostics retained in %s\n' "$runtime" >&2
    fi
    exit "$result"
}
trap cleanup 0
trap 'exit 0' HUP INT TERM

# Refuse concurrent RF controllers. This check runs before this process opens
# /dev/radio0, so any matching descriptor belongs to another process.
for fd in /proc/[0-9]*/fd/*; do
    [ "$(readlink "$fd" 2>/dev/null || true)" = /dev/radio0 ] || continue
    fail "another process already controls /dev/radio0 (${fd#/proc/})"
done

active_profile=$(pactl list cards | awk -v card="$card" '
  $1 == "Name:" {selected = ($2 == card)}
  selected && $1 == "Active" && $2 == "Profile:" {
    sub(/^[[:space:]]*Active Profile: /, "")
    print
    found++
  }
  END {if (found != 1) exit 2}') ||
    fail 'cannot identify the Vince audio card profile'
[ "$active_profile" = "$normal_profile" ] ||
    fail "start from $normal_profile, found: $active_profile"

saved_default_source=$(pactl get-default-source)
saved_default_sink=$(pactl get-default-sink)
[ "$saved_default_source" = "$normal_mic" ] ||
    fail 'unexpected default microphone'
[ "$saved_default_sink" = "$normal_speaker" ] ||
    fail 'unexpected default speaker'
[ -z "$(pactl list short source-outputs)" ] ||
    fail 'another capture stream is active'
[ -z "$(pactl list short sink-inputs)" ] ||
    fail 'another playback stream is active'

saved_mic_volume=$(pactl get-source-volume "$normal_mic" | volume_values) ||
    fail 'cannot preserve microphone volume'
saved_mic_mute=$(pactl get-source-mute "$normal_mic" | mute_value) ||
    fail 'cannot preserve microphone mute state'
saved_speaker_volume=$(pactl get-sink-volume "$normal_speaker" | volume_values) ||
    fail 'cannot preserve speaker volume'
saved_speaker_mute=$(pactl get-sink-mute "$normal_speaker" | mute_value) ||
    fail 'cannot preserve speaker mute state'
amixer -c0 contents >"$runtime/mixer-before.txt"

current_frequency=$(awk -F= '$1 == "frequency" {print $2; exit}' "$state" 2>/dev/null || true)
valid_frequency "$current_frequency" 2>/dev/null || current_frequency=103.7
volume=$(awk -F= -v key="${output}_volume" '$1 == key {print $2; exit}' "$state" 2>/dev/null || true)
case $volume in
    ''|*[!0-9]*) volume=$default_volume ;;
esac
if [ "$volume" -lt 0 ] || [ "$volume" -gt 100 ]; then
    volume=$default_volume
fi

save_state() {
    state_tmp=$config_dir/.state.$$
    old_headphones=$(awk -F= '$1 == "headphones_volume" {print $2; exit}' "$state" 2>/dev/null || true)
    old_speaker=$(awk -F= '$1 == "speaker_volume" {print $2; exit}' "$state" 2>/dev/null || true)
    case $old_headphones in ''|*[!0-9]*) old_headphones=25 ;; esac
    case $old_speaker in ''|*[!0-9]*) old_speaker=100 ;; esac
    if [ "$output" = headphones ]; then old_headphones=$volume; else old_speaker=$volume; fi
    {
        printf 'frequency=%s\n' "$current_frequency"
        printf 'headphones_volume=%s\n' "$old_headphones"
        printf 'speaker_volume=%s\n' "$old_speaker"
    } >"$state_tmp"
    chmod 600 "$state_tmp"
    mv "$state_tmp" "$state"
}

start_tuner() {
    requested=$(normalize_frequency "$1")
    new_log=$runtime/tuner-$requested.log
    old_tuner=$tuner
    "$fm_bin" -q -d /dev/radio0 -T forever "$requested" >"$new_log" 2>&1 &
    tuner=$!
    sleep 1
    if ! kill -0 "$tuner" 2>/dev/null; then
        failed_tuner=$tuner
        tuner=$old_tuner
        wait "$failed_tuner" 2>/dev/null || true
        fail "cannot tune $requested MHz"
    fi
    if ! "$fm_bin" -q -d /dev/radio0 on >/dev/null; then
        failed_tuner=$tuner
        kill "$failed_tuner" 2>/dev/null || true
        wait "$failed_tuner" 2>/dev/null || true
        tuner=$old_tuner
        fail "cannot unmute $requested MHz"
    fi
    if [ -n "$old_tuner" ]; then
        kill "$old_tuner" 2>/dev/null || true
        wait "$old_tuner" 2>/dev/null || true
    fi
    current_frequency=$requested
    save_state
}

start_player() {
    GST_DEBUG=audiobasesrc:3 GST_DEBUG_NO_COLOR=1 \
    gst-launch-1.0 -e \
        pulsesrc device="$fm_source" blocksize=1920 latency-time=10000 \
            buffer-time=200000 \
        ! audio/x-raw,format=S16LE,rate=48000,channels=2 \
        ! queue max-size-buffers=0 max-size-bytes=0 \
            max-size-time=1000000000 \
        ! audioconvert ! audioresample \
        ! pulsesink device="$output_sink" volume=1.0 mute=false \
            async=true sync=true >"$runtime/gstreamer.log" 2>&1 &
    player=$!
    sleep 1
    kill -0 "$player" 2>/dev/null || fail 'FM audio pipeline did not start'
}

set_volume() {
    new_volume=$1
    [ "$new_volume" -ge 0 ] || new_volume=0
    [ "$new_volume" -le 100 ] || new_volume=100
    volume=$new_volume
    pactl set-sink-volume "$output_sink" "${volume}%"
    save_state
}

list_stations() {
    if [ ! -s "$stations" ]; then
        printf 'No saved stations. Press s to scan or use t FREQUENCY.\n'
        return
    fi
    awk -F'|' -v current="$current_frequency" '{
      mark = ($1 == current) ? "*" : " "
      printf "%s %2d. %5s MHz  %s\n", mark, NR, $1, $2
    }' "$stations"
}

select_relative() {
    direction=$1
    selected=$(awk -F'|' -v current="$current_frequency" -v dir="$direction" '
      {freq[NR]=$1; total=NR; if ($1 == current) found=NR}
      END {
        if (!total) exit 1
        if (!found) found=1
        if (dir == "next") idx = found == total ? 1 : found + 1
        else idx = found == 1 ? total : found - 1
        print freq[idx]
      }' "$stations") || {
        printf 'No stations saved.\n'
        return
    }
    start_tuner "$selected"
}

save_station() {
    station_name=$1
    [ -n "$station_name" ] || station_name="FM $current_frequency MHz"
    station_name=$(printf '%s' "$station_name" | tr '|\r\n' '-  ')
    merged=$config_dir/.stations.$$
    awk -F'|' -v f="$current_frequency" -v n="$station_name" '
      BEGIN {done=0}
      $1 == f {print f "|" n; done=1; next}
      {print}
      END {if (!done) print f "|" n}
    ' "$stations" | sort -t'|' -k1,1n >"$merged"
    chmod 600 "$merged"
    mv "$merged" "$stations"
    printf 'Saved %s MHz as %s.\n' "$current_frequency" "$station_name"
}

scan_stations() {
    printf 'Scanning 87.5-108.0 MHz at 100 kHz steps; expect about 45 seconds...\n'
    stop_player
    stop_tuner
    scan_log=$runtime/scan.txt
    if ! "$scan_bin" -q -d /dev/radio0 -s 87.5 -e 108.0 -i 0.1 -t 50 \
        >"$scan_log" 2>&1; then
        start_tuner "$current_frequency"
        start_player
        printf 'Scan failed; previous station restored.\n' >&2
        return
    fi
    found=$runtime/found.txt
    awk -F: '/^[0-9]+[.][0-9]+: / {
      f=$1 + 0
      printf "%.1f|FM %.1f MHz\n", f, f
    }' "$scan_log" | sort -t'|' -k1,1n -u >"$found"
    if [ -s "$found" ]; then
        merged=$config_dir/.stations.$$
        if merge_station_files "$stations" "$found" >"$merged" &&
           [ -s "$merged" ]; then
            first=$(awk -F'|' 'NR == 1 {print $1}' "$merged")
            if valid_frequency "$first"; then
                chmod 600 "$merged"
                mv "$merged" "$stations"
                current_frequency=$first
                printf 'Found %s station candidates.\n' \
                    "$(wc -l <"$stations" | tr -d ' ')"
            else
                rm -f "$merged"
                printf 'Invalid scan result; keeping %s MHz.\n' \
                    "$current_frequency" >&2
            fi
        else
            rm -f "$merged"
            printf 'Empty scan result; keeping %s MHz.\n' \
                "$current_frequency" >&2
        fi
    else
        printf 'No service indications found; keeping %s MHz.\n' "$current_frequency"
    fi
    start_tuner "$current_frequency"
    start_player
    pactl set-sink-volume "$output_sink" "${volume}%"
    list_stations
}

start_tuner "$current_frequency"
switched=1
pactl set-card-profile "$card" "$fm_profile"
pactl set-source-volume "$fm_source" 100%
pactl set-source-mute "$fm_source" 0
pactl set-sink-volume "$output_sink" "${volume}%"
pactl set-sink-mute "$output_sink" 0
idle
start_player

cat <<EOF
Vince FM radio: $output output, $current_frequency MHz, volume $volume%.
Headphones must remain connected as the antenna.
Signal is binary service detection, not calibrated RSSI.
EOF

print_help() {
    cat <<'EOF'
Commands:
  s              scan 87.5-108.0 MHz and save candidates
  t FREQUENCY    tune, for example: t 103.7
  NUMBER         tune a numbered saved station
  n / p          next / previous saved station
  a NAME         save or rename the current station
  l              list saved stations
  + / -          output volume by 5 percent
  m              toggle output mute
  h              show this help
  q              quit and restore normal audio
EOF
}

print_help
list_stations

while :; do
    printf 'FM %s MHz [%s%%] > ' "$current_frequency" "$volume"
    if ! IFS= read -r line; then
        break
    fi
    command=${line%% *}
    argument=${line#"$command"}
    argument=${argument# }
    case $command in
        s) scan_stations ;;
        t)
            if valid_frequency "$argument"; then
                start_tuner "$argument"
            else
                printf 'Frequency must be between 87.5 and 108.0 MHz.\n'
            fi
            ;;
        n) select_relative next ;;
        p) select_relative previous ;;
        a) save_station "$argument" ;;
        l) list_stations ;;
        +) set_volume $((volume + 5)) ;;
        -) set_volume $((volume - 5)) ;;
        m)
            pactl set-sink-mute "$output_sink" toggle
            pactl get-sink-mute "$output_sink"
            ;;
        h|'') print_help ;;
        q) break ;;
        *[!0-9]*|*)
            case $command in
                ''|*[!0-9]*) printf 'Unknown command; press h for help.\n' ;;
                *)
                    selected=$(sed -n "${command}p" "$stations" | awk -F'|' '{print $1}')
                    if valid_frequency "$selected" 2>/dev/null; then
                        start_tuner "$selected"
                    else
                        printf 'No saved station number %s.\n' "$command"
                    fi
                    ;;
            esac
            ;;
    esac
done

exit 0
