[Desktop Entry]
Type=Application
Name=FM Radio (Speaker)
Comment=Scan and listen to FM radio through the main speaker
Exec=qmlkonsole -e "vince-fm-radio speaker"
Icon=audio-radio-symbolic
Terminal=false
Categories=AudioVideo;Audio;Player;
StartupNotify=true
X-KDE-FormFactor=desktop;tablet;handset;
