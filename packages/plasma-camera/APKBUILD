21fb52332474cfbcdda9d5cf851095c04da19abfbbd5030a5094d24913a39a6f744fb93db314b55e719f5d8ff1c6cdec75176409875677e9572d6129815a4c14  ../../patches/plasma-camera/0001-one-shot-autofocus.patch
"
