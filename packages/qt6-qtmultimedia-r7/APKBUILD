# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=qt6
# Based on the Alpine recipe maintained by Bart Ribbers <bribbers@disroot.org>.
# Contributor: Kostiantyn Andriiuk <konstantin@andriyuk.com>
maintainer="Kostiantyn Andriiuk <konstantin@andriyuk.com>"
pkgname=qt6-qtmultimedia
pkgver=6.11.1
pkgrel=7
pkgdesc="Classes for audio, video, radio and camera functionality"
url="https://qt.io/"
arch="all"
license="LGPL-2.1-only AND LGPL-3.0-only AND GPL-3.0-only AND Qt-GPL-exception-1.0"
depends_dev="
	$pkgname-ffmpeg=$pkgver-r$pkgrel
	$pkgname-gstreamer=$pkgver-r$pkgrel
	alsa-lib-dev
	ffmpeg-dev
	gst-plugins-bad-dev
	gst-plugins-base-dev
	gstreamer-dev
	libva-glx-dev
	libxrandr-dev
	pulseaudio-dev
	qt6-qtbase-dev
	qt6-qtbase-private-dev
	qt6-qtshadertools-dev
	qt6-qtsvg-dev
	"
makedepends="$depends_dev
	cmake
	perl
	samurai
	"
case "$CARCH" in
	armhf) ;;
	*)
		depends_dev="$depends_dev qt6-qtdeclarative-dev"
		makedepends="$makedepends
			qt6-qtdeclarative-dev
			qt6-qtdeclarative-private-dev
			"
		;;
esac
subpackages="
	$pkgname-dbg
	$pkgname-dev
	$pkgname-ffmpeg
	$pkgname-gstreamer
	"

case $pkgver in
	*_alpha*|*_beta*|*_rc*) _rel=development_releases;;
	*) _rel=official_releases;;
esac

source="https://download.qt.io/$_rel/qt/${pkgver%.*}/${pkgver/_/-}/submodules/qtmultimedia-everywhere-src-${pkgver/_/-}.tar.xz
	../../patches/qtmultimedia/0001-select-header.patch
	../../patches/qtmultimedia/0002-v4l2m2m-encoder-opt-in.patch
	../../patches/qtmultimedia/0003-v4l2m2m-packet-detach.patch
	../../patches/qtmultimedia/0004-v4l2m2m-packet-defer.patch
	../../patches/qtmultimedia/0005-audio-pcm-trace.patch
	../../patches/qtmultimedia/0006-pulseaudio-record-latency.patch
	../../patches/qtmultimedia/0007-pulseaudio-record-maxlength.patch
	../../patches/qtmultimedia/0008-v4l2m2m-quality-bitrate.patch
	"
builddir="$srcdir/qtmultimedia-everywhere-src-${pkgver/_/-}"

build() {
	# alsa disabled due to build failure for now
	# src/multimedia/platform/alsa/qalsaaudiosink.cpp:270:5: error: 'timeStamp' was not declared in this scope
	export CFLAGS="$CFLAGS -g1 -flto=auto"
	export CXXFLAGS="$CXXFLAGS -g1 -flto=auto"
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DINSTALL_BINDIR=lib/qt6/bin \
		-DINSTALL_DOCDIR=share/doc/qt6 \
		-DINSTALL_ARCHDATADIR=lib/qt6 \
		-DINSTALL_DATADIR=share/qt6 \
		-DINSTALL_INCLUDEDIR=include/qt6 \
		-DINSTALL_MKSPECSDIR=lib/qt6/mkspecs \
		-DINSTALL_EXAMPLESDIR=share/doc/qt6/examples \
		-DQT_BUILD_TESTS=ON \
		-DQT_BUILD_TESTS_BY_DEFAULT=OFF \
		-DQT_FEATURE_alsa=OFF \
		-DQT_FEATURE_pulseaudio=ON
	cmake --build build --parallel
}

check() {
	cmake --build build --target tst_qffmpegvideoencoderutils --parallel
	QT_QPA_PLATFORM=offscreen \
		build/tests/auto/unit/plugins/multimedia/ffmpeg/qffmpegvideoencoderutils/tst_qffmpegvideoencoderutils
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

dev() {
	default_dev

	amove usr/lib/qt6/sbom
}

ffmpeg() {
	pkgdesc="$pkgdesc (ffmpeg plugin)"
	# autopull if main dep exists anyway
	install_if="$pkgname=$pkgver-r$pkgrel ffmpeg-libavcodec"

	amove usr/lib/qt6/plugins/multimedia/libffmpegmediaplugin.so
}

gstreamer() {
	pkgdesc="$pkgdesc (gstreamer plugin)"
	# unlike above, these deps are not that obvious.
	# -base is pulled by e.g. gtk4 anyway, but practically nothing
	# would use this unless people added good, etc. so use that
	install_if="$pkgname=$pkgver-r$pkgrel gst-plugins-good"

	amove usr/lib/qt6/plugins/multimedia/libgstreamermediaplugin.so
}

