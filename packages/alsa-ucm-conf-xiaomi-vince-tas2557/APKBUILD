pkgname=alsa-ucm-conf-xiaomi-vince-tas2557
pkgver=1.0
pkgrel=3
pkgdesc="Verified TAS2557/Mic2 and experimental FM UCM profiles for Xiaomi vince"
url="https://github.com/msm8953-mainline/alsa-ucm-conf"
arch="noarch"
license="BSD-3-Clause"
depends="alsa-ucm-conf"
replaces="alsa-ucm-conf soc-qcom-msm8953-ucm"
options="!check"
source="
	HiFi-TAS2557.conf
	FM.conf
	xiaomi-vince.conf
"

package() {
	install -Dm644 "$srcdir/FM.conf" "$pkgdir/usr/share/alsa/ucm2/Xiaomi/vince/FM.conf"
	install -Dm644 "$srcdir/HiFi-TAS2557.conf" \
		"$pkgdir/usr/share/alsa/ucm2/Xiaomi/vince/HiFi-TAS2557.conf"
	install -Dm644 "$srcdir/xiaomi-vince.conf" \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/xiaomi-vince/xiaomi-vince.conf"
}

