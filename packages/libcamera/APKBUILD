# Contributor: Kostiantyn Andriiuk <konstantin@andriyuk.com>
maintainer="Kostiantyn Andriiuk <konstantin@andriyuk.com>"
pkgname=libcamera
pkgver=99991.7.1
pkgrel=3
_realver=0.7.1
pkgdesc="Linux camera framework with handset-local Vince one-shot autofocus"
url="https://libcamera.org/"
arch="aarch64"
license="LGPL-2.1-or-later AND GPL-2.0-or-later"
depends="$pkgname-ipa=$pkgver-r$pkgrel"
makedepends="
	coreutils
	eudev-dev
	libevent-dev
	libyuv-dev
	linux-headers
	meson
	openssl-dev
	py3-jinja2
	py3-ply
	py3-yaml
	yaml-dev
	"
subpackages="
	$pkgname-dev
	$pkgname-ipa:ipa
	$pkgname-tools:tools
	$pkgname-v4l2:v4l2
	"
source="
	https://gitlab.freedesktop.org/camera/libcamera/-/archive/v$_realver/libcamera-v$_realver.tar.gz
	../../patches/libcamera/0001-simple-raw-lens-plumbing.patch
	../../patches/libcamera/0002-software-isp-add-focus-statistics.patch
	../../patches/libcamera/0003-simple-ipa-bounded-one-shot-af.patch
	../../patches/libcamera/0004-simple-ipa-advertise-afstate.patch
	../../patches/libcamera/0005-software-isp-guard-late-lens-callbacks.patch
	../../patches/libcamera/0006-ipa-simple-guard-malformed-sensor-controls.patch
	"
builddir="$srcdir/libcamera-v$_realver"
# IPA signatures cover the final stripped module, so strip manually first.
options="!strip !check"
export SOURCE_DATE_EPOCH=1788589860

build() {
	abuild-meson \
		-Dpipelines=simple \
		-Dipas=simple \
		-Dv4l2=enabled \
		-Dgstreamer=disabled \
		-Dqcam=disabled \
		-Dcam=enabled \
		-Dlc-compliance=disabled \
		-Ddocumentation=disabled \
		-Dpycamera=disabled \
		-Dtest=false \
		-Dwerror=true \
		. output
	meson compile -C output -j 4
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	scanelf --recursive \
		--nobanner \
		--etype "ET_DYN,ET_EXEC" \
		--format "%F" \
		"$pkgdir" \
		| while read -r file; do
			strip "$file"
		done
}

ipa() {
	depends=""
	amove usr/lib/libcamera

	local ipa
	for ipa in "$subpkgdir"/usr/lib/libcamera/ipa/ipa*.so; do
		msg "signing $ipa"
		"$builddir"/src/ipa/ipa-sign.sh \
			"$(find "$builddir"/output -type f -iname "*ipa-priv-key.pem")" \
			"$ipa" \
			"$ipa".sign
	done
}

tools() {
	depends="$pkgname=$pkgver-r$pkgrel"
	amove usr/bin/cam
}

v4l2() {
	depends="$pkgname=$pkgver-r$pkgrel"
	amove usr/libexec/libcamera/v4l2-compat.so
}

