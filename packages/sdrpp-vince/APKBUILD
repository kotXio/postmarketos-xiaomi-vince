# SPDX-License-Identifier: GPL-3.0-only
# Maintainer: Kostiantyn Andriiuk <konstantin@andriyuk.com>
# Corresponds to the existing r3 binary; replacement sources are expressed
# as decoder-compat.patch with the same resulting source content.
pkgname=sdrpp-vince
pkgver=1.3.0_git20260704
pkgrel=3
pkgdesc="SDR++ with amateur-radio decoders for Xiaomi Vince and RTL-SDR"
arch="aarch64"
url="https://github.com/AlexandreRouma/SDRPlusPlus"
license="GPL-3.0-only AND LGPL-2.1-only AND Zlib"
maintainer="Kostiantyn Andriiuk <konstantin@andriyuk.com>"
options="!check"
provides="sdrpp=$pkgver-r$pkgrel"
depends="glfw"
makedepends="
	build-base
	cmake
	fftw-dev
	glfw-dev
	libxkbcommon-dev
	librtlsdr-dev
	libvolk-dev
	mesa-dev
	pkgconf
	rtaudio-dev
	wayland-dev
	zstd-dev
"
source="
	$pkgname-$pkgver.tar.gz
	codec2-1.2.0.tar.gz
	glfw-3.4.tar.gz
	dab-volk-3.1-pointer.patch
	glfw-wayland-touch.patch
	sdrpp-vince-runtime.patch
	decoder-compat.patch
"
builddir="$srcdir/$pkgname-$pkgver"

prepare() {
	patch -d "$builddir" -p1 < "$srcdir/dab-volk-3.1-pointer.patch"
	patch -d "$builddir" -p1 < "$srcdir/sdrpp-vince-runtime.patch"
	patch -d "$srcdir/glfw-3.4" -p1 < "$srcdir/glfw-wayland-touch.patch"
	grep -Fx 'Exec=@CMAKE_INSTALL_PREFIX@/bin/sdrpp' \
		"$builddir/sdrpp.desktop"
	sed -i 's|^Exec=@CMAKE_INSTALL_PREFIX@/bin/sdrpp$|Exec=@CMAKE_INSTALL_PREFIX@/bin/sdrpp --autostart|' \
		"$builddir/sdrpp.desktop"
	grep -Fx 'Exec=@CMAKE_INSTALL_PREFIX@/bin/sdrpp --autostart' \
		"$builddir/sdrpp.desktop"
	patch -d "$builddir" -p1 < "$srcdir/decoder-compat.patch"
}

build() {
	glfw_source="$srcdir/glfw-3.4"
	glfw_build="$glfw_source/build"
	glfw_prefix="$srcdir/glfw-prefix"
	codec2_source="$srcdir/codec2-1.2.0"
	codec2_build="$codec2_source/build"
	codec2_prefix="$srcdir/codec2-prefix"

	cmake -G "Unix Makefiles" -S "$glfw_source" -B "$glfw_build" \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX="$glfw_prefix" \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DGLFW_BUILD_X11=OFF \
		-DGLFW_BUILD_WAYLAND=ON \
		-DGLFW_BUILD_EXAMPLES=OFF \
		-DGLFW_BUILD_TESTS=OFF \
		-DGLFW_BUILD_DOCS=OFF
	cmake --build "$glfw_build" --parallel 4
	cmake --install "$glfw_build"
	test -f "$glfw_prefix/lib/libglfw-vince.so.3.4"
	test "$(readlink "$glfw_prefix/lib/libglfw-vince.so.3")" \
		= libglfw-vince.so.3.4
	grep -Fqx 'Libs: -L${libdir} -lglfw-vince' \
		"$glfw_prefix/lib/pkgconfig/glfw3.pc"

	cmake -G "Unix Makefiles" -S "$codec2_source" -B "$codec2_build" \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX="$codec2_prefix" \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DLPCNET=OFF \
		-DUNITTEST=OFF
	cmake --build "$codec2_build" --parallel 4
	cmake --install "$codec2_build"
	codec2_pc="$codec2_prefix/lib/pkgconfig/codec2.pc"
	grep -Fx 'Cflags: -I${includedir} ' "$codec2_pc"
	sed -i 's|^Cflags: -I${includedir} $|Cflags: -I${includedir} -I${includedir}/.. |' \
		"$codec2_pc"
	grep -Fx 'Cflags: -I${includedir} -I${includedir}/.. ' "$codec2_pc"

	PKG_CONFIG_PATH="$glfw_prefix/lib/pkgconfig:$codec2_prefix/lib/pkgconfig" \
	cmake -G "Unix Makefiles" -S "$builddir" -B "$builddir/build" \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DOPT_BACKEND_GLFW=ON \
		-DOPT_BACKEND_ANDROID=OFF \
		-DOPT_OVERRIDE_STD_FILESYSTEM=OFF \
		-DOPT_BUILD_AIRSPY_SOURCE=OFF \
		-DOPT_BUILD_AIRSPYHF_SOURCE=OFF \
		-DOPT_BUILD_AUDIO_SOURCE=OFF \
		-DOPT_BUILD_BADGESDR_SOURCE=OFF \
		-DOPT_BUILD_BLADERF_SOURCE=OFF \
		-DOPT_BUILD_DRAGONLABS_SOURCE=OFF \
		-DOPT_BUILD_FILE_SOURCE=OFF \
		-DOPT_BUILD_FOBOSSDR_SOURCE=OFF \
		-DOPT_BUILD_HACKRF_SOURCE=OFF \
		-DOPT_BUILD_HAROGIC_SOURCE=OFF \
		-DOPT_BUILD_HERMES_SOURCE=OFF \
		-DOPT_BUILD_HYDRASDR_SOURCE=OFF \
		-DOPT_BUILD_KCSDR_SOURCE=OFF \
		-DOPT_BUILD_LIMESDR_SOURCE=OFF \
		-DOPT_BUILD_NETWORK_SOURCE=OFF \
		-DOPT_BUILD_PERSEUS_SOURCE=OFF \
		-DOPT_BUILD_PLUTOSDR_SOURCE=OFF \
		-DOPT_BUILD_RFNM_SOURCE=OFF \
		-DOPT_BUILD_RFSPACE_SOURCE=OFF \
		-DOPT_BUILD_RTL_SDR_SOURCE=ON \
		-DOPT_BUILD_RTL_TCP_SOURCE=OFF \
		-DOPT_BUILD_SDRPP_SERVER_SOURCE=OFF \
		-DOPT_BUILD_SDRPLAY_SOURCE=OFF \
		-DOPT_BUILD_SOAPY_SOURCE=OFF \
		-DOPT_BUILD_SPECTRAN_SOURCE=OFF \
		-DOPT_BUILD_SPECTRAN_HTTP_SOURCE=OFF \
		-DOPT_BUILD_SPYSERVER_SOURCE=OFF \
		-DOPT_BUILD_USRP_SOURCE=OFF \
		-DOPT_BUILD_ANDROID_AUDIO_SINK=OFF \
		-DOPT_BUILD_AUDIO_SINK=ON \
		-DOPT_BUILD_NETWORK_SINK=OFF \
		-DOPT_BUILD_NEW_PORTAUDIO_SINK=OFF \
		-DOPT_BUILD_PORTAUDIO_SINK=OFF \
		-DOPT_BUILD_ATV_DECODER=ON \
		-DOPT_BUILD_DAB_DECODER=ON \
		-DOPT_BUILD_FALCON9_DECODER=OFF \
		-DOPT_BUILD_KG_SSTV_DECODER=ON \
		-DOPT_BUILD_M17_DECODER=ON \
		-DOPT_BUILD_METEOR_DEMODULATOR=ON \
		-DOPT_BUILD_PAGER_DECODER=ON \
		-DOPT_BUILD_RADIO=ON \
		-DOPT_BUILD_RYFI_DECODER=OFF \
		-DOPT_BUILD_VOR_RECEIVER=ON \
		-DOPT_BUILD_WEATHER_SAT_DECODER=ON \
		-DOPT_BUILD_DISCORD_PRESENCE=OFF \
		-DOPT_BUILD_FREQUENCY_MANAGER=ON \
		-DOPT_BUILD_IQ_EXPORTER=OFF \
		-DOPT_BUILD_RECORDER=ON \
		-DOPT_BUILD_RIGCTL_CLIENT=OFF \
		-DOPT_BUILD_RIGCTL_SERVER=OFF \
		-DOPT_BUILD_SCANNER=ON \
		-DOPT_BUILD_SCHEDULER=OFF \
		-DUSE_INTERNAL_LIBCORRECT=ON \
		-DUSE_BUNDLE_DEFAULTS=OFF
	cmake --build "$builddir/build" --parallel 4
}

package() {
	DESTDIR="$pkgdir" cmake --install "$builddir/build"
	install -d "$pkgdir/usr/lib"
	cp -a "$srcdir"/codec2-prefix/lib/libcodec2.so* "$pkgdir/usr/lib/"
	cp -a "$srcdir"/glfw-prefix/lib/libglfw-vince.so* "$pkgdir/usr/lib/"
}

