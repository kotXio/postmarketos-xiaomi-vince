-
+
+// GLFW has no native touch API.  Translate the first active Wayland touch
+// point into the cursor and left mouse button events expected by ImGui.
+static void releaseTouch(void)
+{
+    _GLFWwindow* window = _glfw.wl.touchFocus;
+    if (!window)
+        return;
+
+    _glfw.wl.touchFocus = NULL;
+    _glfwInputMouseClick(window, GLFW_MOUSE_BUTTON_LEFT, GLFW_RELEASE,
+                         _glfw.wl.xkb.modifiers);
+    _glfwInputCursorEnter(window, GLFW_FALSE);
+}
+
+static void touchHandleDown(void* userData,
+                            struct wl_touch* touch,
+                            uint32_t serial,
+                            uint32_t time,
+                            struct wl_surface* surface,
+                            int32_t id,
+                            wl_fixed_t x,
+                            wl_fixed_t y)
+{
+    if (_glfw.wl.touchFocus || !surface)
+        return;
+
+    if (wl_proxy_get_tag((struct wl_proxy*) surface) != &_glfw.wl.tag)
+        return;
+
+    _GLFWwindow* window = wl_surface_get_user_data(surface);
+    if (surface != window->wl.surface)
+        return;
+
+    const double xpos = wl_fixed_to_double(x);
+    const double ypos = wl_fixed_to_double(y);
+
+    _glfw.wl.serial = serial;
+    _glfw.wl.touchFocus = window;
+    _glfw.wl.touchId = id;
+    window->wl.cursorPosX = xpos;
+    window->wl.cursorPosY = ypos;
+
+    _glfwInputCursorEnter(window, GLFW_TRUE);
+    _glfwInputCursorPos(window, xpos, ypos);
+    _glfwInputMouseClick(window, GLFW_MOUSE_BUTTON_LEFT, GLFW_PRESS,
+                         _glfw.wl.xkb.modifiers);
+}
+
+static void touchHandleUp(void* userData,
+                          struct wl_touch* touch,
+                          uint32_t serial,
+                          uint32_t time,
+                          int32_t id)
+{
+    if (!_glfw.wl.touchFocus || id != _glfw.wl.touchId)
+        return;
+
+    _glfw.wl.serial = serial;
+    releaseTouch();
+}
+
+static void touchHandleMotion(void* userData,
+                              struct wl_touch* touch,
+                              uint32_t time,
+                              int32_t id,
+                              wl_fixed_t x,
+                              wl_fixed_t y)
+{
+    _GLFWwindow* window = _glfw.wl.touchFocus;
+    if (!window || id != _glfw.wl.touchId)
+        return;
+
+    const double xpos = wl_fixed_to_double(x);
+    const double ypos = wl_fixed_to_double(y);
+    window->wl.cursorPosX = xpos;
+    window->wl.cursorPosY = ypos;
+    _glfwInputCursorPos(window, xpos, ypos);
+}
+
+static void touchHandleCancel(void* userData, struct wl_touch* touch)
+{
+    releaseTouch();
+}
+
+// libwayland requires a non-NULL listener for every event supported by the
+// negotiated wl_touch version.  These events do not affect mouse emulation,
+// but they must still be acknowledged by a callable listener.
+static void touchHandleFrame(void* userData, struct wl_touch* touch)
+{
+}
+
+static void touchHandleShape(void* userData,
+                             struct wl_touch* touch,
+                             int32_t id,
+                             wl_fixed_t major,
+                             wl_fixed_t minor)
+{
+}
+
+static void touchHandleOrientation(void* userData,
+                                   struct wl_touch* touch,
+                                   int32_t id,
+                                   wl_fixed_t orientation)
+{
+}
+
+static const struct wl_touch_listener touchListener =
+{
+    .down = touchHandleDown,
+    .up = touchHandleUp,
+    .motion = touchHandleMotion,
+    .frame = touchHandleFrame,
+    .cancel = touchHandleCancel,
+    .shape = touchHandleShape,
+    .orientation = touchHandleOrientation,
+};
+
 static void keyboardHandleKeymap(void* userData,
                                  struct wl_keyboard* keyboard,
                                  uint32_t format,
@@ -1902,6 +2019,18 @@ static void seatHandleCapabilities(void* userData,
         wl_keyboard_destroy(_glfw.wl.keyboard);
         _glfw.wl.keyboard = NULL;
     }
+
+    if ((caps & WL_SEAT_CAPABILITY_TOUCH) && !_glfw.wl.touch)
+    {
+        _glfw.wl.touch = wl_seat_get_touch(seat);
+        wl_touch_add_listener(_glfw.wl.touch, &touchListener, NULL);
+    }
+    else if (!(caps & WL_SEAT_CAPABILITY_TOUCH) && _glfw.wl.touch)
+    {
+        releaseTouch();
+        wl_touch_destroy(_glfw.wl.touch);
+        _glfw.wl.touch = NULL;
+    }
 }
-
