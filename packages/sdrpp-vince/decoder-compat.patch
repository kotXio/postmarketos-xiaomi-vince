+
+        inline uint16_t HIRSSignedToUnsigned(uint16_t n) {
+            return (n & 0x1000) ? (0x1000 + (n & 0xFFF)) : (0xFFF - (n & 0xFFF));
+        }
+
+        class HIRSDemux : public block {
+        public:
+            HIRSDemux() {}
+
+            HIRSDemux(stream<uint8_t>* in) { init(in); }
+
+            void init(stream<uint8_t>* in) {
+                _in = in;
+                block::registerInput(_in);
+                for (int i = 0; i < 20; i++) {
+                    block::registerOutput(&radChannels[i]);
+                }
+
+                // Clear buffers
+                for (int i = 0; i < 20; i++) {
+                    for (int j = 0; j < 56; j++) { radChannels[i].writeBuf[j] = 0xFFF; }
+                }
+                block::_block_init = true;
+            }
+
+            void setInput(stream<uint8_t>* in) {
+                assert(block::_block_init);
+                std::lock_guard<std::recursive_mutex> lck(block::ctrlMtx);
+                block::tempStop();
+                block::unregisterInput(_in);
+                _in = in;
+                block::registerInput(_in);
+                block::tempStart();
+            }
+
+            int run() {
+                int count = _in->read();
+                if (count < 0) { return -1; }
+
+                int element = weather_compat::readBits(19, 6, _in->readBuf);
+
+                // If we've skipped or are on a non image element and there's data available, send it
+                if ((element < lastElement || element > 55) && newImageData) {
+                    newImageData = false;
+                    for (int i = 0; i < 20; i++) {
+                        if (!radChannels[i].swap(56)) { return -1; }
+                    }
+
+                    // Clear buffers
+                    for (int i = 0; i < 20; i++) {
+                        for (int j = 0; j < 56; j++) { radChannels[i].writeBuf[j] = 0xFFF; }
+                    }
+                }
+                lastElement = element;
+
+                // If data is part of a line, save it
+                if (element <= 55) {
+                    newImageData = true;
+
+                    radChannels[0].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(26, 13, _in->readBuf));
+                    radChannels[1].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(52, 13, _in->readBuf));
+                    radChannels[2].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(65, 13, _in->readBuf));
+                    radChannels[3].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(91, 13, _in->readBuf));
+                    radChannels[4].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(221, 13, _in->readBuf));
+                    radChannels[5].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(208, 13, _in->readBuf));
+                    radChannels[6].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(143, 13, _in->readBuf));
+                    radChannels[7].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(156, 13, _in->readBuf));
+                    radChannels[8].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(273, 13, _in->readBuf));
+                    radChannels[9].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(182, 13, _in->readBuf));
+                    radChannels[10].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(119, 13, _in->readBuf));
+                    radChannels[11].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(247, 13, _in->readBuf));
+                    radChannels[12].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(78, 13, _in->readBuf));
+                    radChannels[13].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(195, 13, _in->readBuf));
+                    radChannels[14].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(234, 13, _in->readBuf));
+                    radChannels[15].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(260, 13, _in->readBuf));
+                    radChannels[16].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(39, 13, _in->readBuf));
+                    radChannels[17].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(104, 13, _in->readBuf));
+                    radChannels[18].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(130, 13, _in->readBuf));
+                    radChannels[19].writeBuf[element] = HIRSSignedToUnsigned(weather_compat::readBits(169, 13, _in->readBuf));
+                }
+
+                // If we are writing the last pixel of a line, send it already
+                if (element == 55) {
+                    newImageData = false;
+                    for (int i = 0; i < 20; i++) {
+                        if (!radChannels[i].swap(56)) { return -1; }
+                    }
+
+                    // Clear buffers
+                    for (int i = 0; i < 20; i++) {
+                        for (int j = 0; j < 56; j++) { radChannels[i].writeBuf[j] = 0xFFF; }
+                    }
+                }
+
+                _in->flush();
+                return count;
+            }
+
+            stream<uint16_t> radChannels[20];
+
+        private:
+            stream<uint8_t>* _in;
+            int lastElement = 0;
+            bool newImageData = false;
+        };
+    }
+}
