diff --git a/src/libcamera/software_isp/swstats_cpu_focus.cpp b/src/libcamera/software_isp/swstats_cpu_focus.cpp
new file mode 100644
index 00000000..865df2a6
--- /dev/null
+++ b/src/libcamera/software_isp/swstats_cpu_focus.cpp
@@ -0,0 +1,192 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Kostik
+ *
+ * CPU based software focus statistics helper
+ */
+
+#include "libcamera/internal/software_isp/swstats_cpu_focus.h"
+
+#include <algorithm>
+#include <stdint.h>
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+/**
+ * \class SwStatsCpuFocus
+ * \brief Gather a central raw-Bayer focus statistic during CPU statistics
+ *
+ * The helper receives the averaged green value from every sample already used
+ * by SwStatsCpu. It converts all supported Bayer depths to the same 8-bit
+ * range, then accumulates squared horizontal and vertical differences over the
+ * central 50% of the statistics window. The raw sum and gradient count are
+ * kept separate so the autofocus algorithm can normalize them by sample count
+ * and mean luminance.
+ *
+ * Each CPU worker owns separate line state. merge() restores the vertical
+ * gradients between adjacent worker segments, making the final result
+ * independent of the number of workers.
+ */
+
+namespace {
+
+unsigned int alignUp(unsigned int value, unsigned int alignment)
+{
+	return (value + alignment - 1) & ~(alignment - 1);
+}
+
+unsigned int alignDown(unsigned int value, unsigned int alignment)
+{
+	return value & ~(alignment - 1);
+}
+
+} /* namespace */
+
+void SwStatsCpuFocus::configure(const Rectangle &statsWindow,
+				unsigned int bufferCount)
+{
+	const unsigned int left = alignUp(statsWindow.width / 4, kSampleStep);
+	const unsigned int right = alignDown(statsWindow.width - statsWindow.width / 4,
+					     kSampleStep);
+	const unsigned int top = alignUp(statsWindow.height / 4, kSampleStep);
+	const unsigned int bottom = alignDown(statsWindow.height - statsWindow.height / 4,
+					      kSampleStep);
+
+	window_.x = statsWindow.x + std::min(left, right);
+	window_.y = statsWindow.y + std::min(top, bottom);
+	window_.width = right > left ? right - left : 0;
+	window_.height = bottom > top ? bottom - top : 0;
+
+	sampleColumns_ = window_.width / kSampleStep;
+	buffers_.clear();
+	buffers_.resize(bufferCount);
+	for (BufferState &state : buffers_) {
+		state.firstLine.resize(sampleColumns_);
+		state.previousLine.resize(sampleColumns_);
+	}
+}
+
+void SwStatsCpuFocus::startFrame()
+{
+	for (BufferState &state : buffers_) {
+		state.sampleIndex = 0;
+		state.leftValid = false;
+		state.previousLineValid = false;
+		state.hasLines = false;
+		state.lineActive = false;
+	}
+}
+
+bool SwStatsCpuFocus::processLine(unsigned int y) const
+{
+	return y >= static_cast<unsigned int>(window_.y) &&
+	       y < window_.y + window_.height;
+}
+
+bool SwStatsCpuFocus::processColumn(unsigned int x) const
+{
+	return x >= static_cast<unsigned int>(window_.x) &&
+	       x < window_.x + window_.width;
+}
+
+void SwStatsCpuFocus::startLine(unsigned int bufferIndex)
+{
+	ASSERT(bufferIndex < buffers_.size());
+
+	BufferState &state = buffers_[bufferIndex];
+	state.sampleIndex = 0;
+	state.leftValid = false;
+	state.lineActive = true;
+}
+
+void SwStatsCpuFocus::addSample(unsigned int bufferIndex, SwIspStats &stats,
+				uint16_t green, unsigned int rightShift)
+{
+	ASSERT(bufferIndex < buffers_.size());
+	ASSERT(rightShift < 16);
+
+	BufferState &state = buffers_[bufferIndex];
+	ASSERT(state.lineActive);
+	ASSERT(state.sampleIndex < sampleColumns_);
+
+	const uint8_t value = std::min<unsigned int>(green >> rightShift, 255);
+	stats.focusGreenSum += value;
+	stats.focusGreenSamples++;
+
+	const auto accumulate = [&stats, value](uint8_t neighbour) {
+		const int32_t difference = static_cast<int32_t>(value) - neighbour;
+		stats.focusGradientSum +=
+			static_cast<uint64_t>(difference * difference);
+		stats.focusGradientSamples++;
+	};
+
+	if (state.leftValid)
+		accumulate(state.left);
+	if (state.previousLineValid)
+		accumulate(state.previousLine[state.sampleIndex]);
+
+	state.previousLine[state.sampleIndex] = value;
+	state.sampleIndex++;
+	state.left = value;
+	state.leftValid = true;
+}
+
+void SwStatsCpuFocus::finishLine(unsigned int bufferIndex)
+{
+	ASSERT(bufferIndex < buffers_.size());
+
+	BufferState &state = buffers_[bufferIndex];
+	ASSERT(state.lineActive);
+	ASSERT(state.sampleIndex == sampleColumns_);
+
+	if (!state.hasLines)
+		state.firstLine = state.previousLine;
+	state.hasLines = sampleColumns_ > 0;
+	state.previousLineValid = sampleColumns_ > 0;
+	state.lineActive = false;
+}
+
+void SwStatsCpuFocus::reset(SwIspStats &stats)
+{
+	stats.focusGradientSum = 0;
+	stats.focusGradientSamples = 0;
+	stats.focusGreenSum = 0;
+	stats.focusGreenSamples = 0;
+}
+
+void SwStatsCpuFocus::merge(SwIspStats &destination,
+			    const std::vector<SwIspStats> &sources) const
+{
+	ASSERT(sources.size() == buffers_.size());
+
+	const BufferState *previous = nullptr;
+	for (unsigned int i = 0; i < sources.size(); ++i) {
+		const SwIspStats &source = sources[i];
+		const BufferState &state = buffers_[i];
+
+		destination.focusGradientSum += source.focusGradientSum;
+		destination.focusGradientSamples += source.focusGradientSamples;
+		destination.focusGreenSum += source.focusGreenSum;
+		destination.focusGreenSamples += source.focusGreenSamples;
+
+		if (!state.hasLines)
+			continue;
+
+		if (previous) {
+			for (unsigned int x = 0; x < sampleColumns_; ++x) {
+				const int32_t difference =
+					static_cast<int32_t>(state.firstLine[x]) -
+					previous->previousLine[x];
+				destination.focusGradientSum +=
+					static_cast<uint64_t>(difference * difference);
+				destination.focusGradientSamples++;
+			}
+		}
+
+		previous = &state;
+	}
+}
+
+} /* namespace libcamera */
