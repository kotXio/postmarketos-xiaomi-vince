@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Kostik
+ *
+ * CPU based software focus statistics helper
+ */
+
+#pragma once
+
+#include <stdint.h>
+#include <vector>
+
+#include <libcamera/geometry.h>
+
+#include "libcamera/internal/software_isp/swisp_stats.h"
+
+namespace libcamera {
+
+class SwStatsCpuFocus
+{
+public:
+	static constexpr unsigned int kSampleStep = 4;
+
+	void configure(const Rectangle &statsWindow, unsigned int bufferCount);
+	void startFrame();
+
+	bool processLine(unsigned int y) const;
+	bool processColumn(unsigned int x) const;
+
+	void startLine(unsigned int bufferIndex);
+	void addSample(unsigned int bufferIndex, SwIspStats &stats,
+		       uint16_t green, unsigned int rightShift);
+	void finishLine(unsigned int bufferIndex);
+
+	const Rectangle &window() const { return window_; }
+
+	static void reset(SwIspStats &stats);
+	void merge(SwIspStats &destination,
+		   const std::vector<SwIspStats> &sources) const;
+
+private:
+	struct BufferState {
+		std::vector<uint8_t> firstLine;
+		std::vector<uint8_t> previousLine;
+		unsigned int sampleIndex = 0;
+		uint8_t left = 0;
+		bool leftValid = false;
+		bool previousLineValid = false;
+		bool hasLines = false;
+		bool lineActive = false;
+	};
+
+	Rectangle window_;
+	unsigned int sampleColumns_ = 0;
+	std::vector<BufferState> buffers_;
+};
+
+} /* namespace libcamera */
