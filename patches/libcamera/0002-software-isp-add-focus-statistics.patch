+
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <iostream>
+#include <limits>
+#include <sys/mman.h>
+
+#include <libcamera/camera_manager.h>
+#include <libcamera/formats.h>
+#include <libcamera/stream.h>
+
+#include "libcamera/internal/software_isp/swstats_cpu.h"
+#include "libcamera/internal/software_isp/swstats_cpu_focus.h"
+
+#include "test.h"
+
+using namespace libcamera;
+using namespace std;
+
+namespace {
+
+template<std::size_t Size>
+void addLine(SwStatsCpuFocus &focus, unsigned int bufferIndex,
+	     SwIspStats &stats, const array<uint16_t, Size> &values,
+	     unsigned int rightShift)
+{
+	focus.startLine(bufferIndex);
+	for (uint16_t value : values)
+		focus.addSample(bufferIndex, stats, value, rightShift);
+	focus.finishLine(bufferIndex);
+}
+
+SwIspStats checkerboardMetric(uint16_t high, unsigned int rightShift)
+{
+	SwStatsCpuFocus focus;
+	SwIspStats stats{};
+
+	focus.configure(Rectangle(0, 0, 16, 16), 1);
+	focus.startFrame();
+	SwStatsCpuFocus::reset(stats);
+	addLine(focus, 0, stats, array<uint16_t, 2>{ 0, high }, rightShift);
+	addLine(focus, 0, stats, array<uint16_t, 2>{ high, 0 }, rightShift);
+
+	return stats;
+}
+
+double normalizedMetric(const SwIspStats &stats)
+{
+	const double gradientRms =
+		sqrt(static_cast<double>(stats.focusGradientSum) /
+		     stats.focusGradientSamples);
+	const double meanGreen =
+		static_cast<double>(stats.focusGreenSum) / stats.focusGreenSamples;
+
+	return gradientRms / meanGreen;
+}
+
+bool checkSharedStats(SwStatsCpu &stats)
+{
+	void *mem = mmap(nullptr, sizeof(SwIspStats), PROT_READ, MAP_SHARED,
+			 stats.getStatsFD().get(), 0);
+	if (mem == MAP_FAILED)
+		return false;
+
+	const SwIspStats result = *static_cast<SwIspStats *>(mem);
+	munmap(mem, sizeof(SwIspStats));
+
+	return result.valid && result.focusGradientSum == 260100 &&
+	       result.focusGradientSamples == 4 &&
+	       result.focusGreenSum == 510 && result.focusGreenSamples == 4;
+}
+
+template<typename Pixel>
+bool checkUnpackedFormat(CameraManager &cm, const PixelFormat &format,
+			 uint16_t high)
+{
+	SwStatsCpu stats(cm);
+	StreamConfiguration config{};
+	config.pixelFormat = format;
+	config.size = Size(16, 16);
+	config.stride = sizeof(Pixel) * config.size.width;
+	config.frameSize = config.stride * config.size.height;
+	if (!stats.isValid() || stats.configure(config))
+		return false;
+
+	stats.setWindow(Rectangle(config.size));
+	stats.startFrame(0);
+
+	const array<uint16_t, 4> first{ 64, 0, high, 64 };
+	const array<uint16_t, 4> second{ 64, high, 0, 64 };
+	array<Pixel, 16> firstLine{};
+	array<Pixel, 16> secondLine{};
+	for (unsigned int block = 0; block < first.size(); ++block) {
+		for (unsigned int x = 0; x < 4; ++x) {
+			firstLine[block * 4 + x] = first[block];
+			secondLine[block * 4 + x] = second[block];
+		}
+	}
+
+	const uint8_t *firstLines[] = {
+		nullptr,
+		reinterpret_cast<const uint8_t *>(firstLine.data()),
+		reinterpret_cast<const uint8_t *>(firstLine.data()),
+	};
+	const uint8_t *secondLines[] = {
+		nullptr,
+		reinterpret_cast<const uint8_t *>(secondLine.data()),
+		reinterpret_cast<const uint8_t *>(secondLine.data()),
+	};
+	stats.processLine0(0, 4, firstLines);
+	stats.processLine0(0, 8, secondLines);
+	stats.finishFrame(0, 0);
+
+	return checkSharedStats(stats);
+}
+
+bool checkPacked10Format(CameraManager &cm, const PixelFormat &format)
+{
+	SwStatsCpu stats(cm);
+	StreamConfiguration config{};
+	config.pixelFormat = format;
+	config.size = Size(16, 16);
+	config.stride = config.size.width * 5 / 4;
+	config.frameSize = config.stride * config.size.height;
+	if (!stats.isValid() || stats.configure(config))
+		return false;
+
+	stats.setWindow(Rectangle(config.size));
+	stats.startFrame(0);
+
+	const array<uint8_t, 4> first{ 64, 0, 255, 64 };
+	const array<uint8_t, 4> second{ 64, 255, 0, 64 };
+	array<uint8_t, 20> firstLine{};
+	array<uint8_t, 20> secondLine{};
+	for (unsigned int block = 0; block < first.size(); ++block) {
+		for (unsigned int x = 0; x < 4; ++x) {
+			firstLine[block * 5 + x] = first[block];
+			secondLine[block * 5 + x] = second[block];
+		}
+	}
+
+	const uint8_t *firstLines[] = {
+		nullptr, firstLine.data(), firstLine.data(),
+	};
+	const uint8_t *secondLines[] = {
+		nullptr, secondLine.data(), secondLine.data(),
+	};
+	stats.processLine0(0, 4, firstLines);
+	stats.processLine0(0, 8, secondLines);
+	stats.finishFrame(0, 0);
+
+	return checkSharedStats(stats);
+}
+
+class SwStatsCpuFocusTest : public Test
+{
+protected:
+	int run() override
+	{
+		SwStatsCpuFocus focus;
+		focus.configure(Rectangle(2, 6, 16, 16), 1);
+
+		if (focus.window() != Rectangle(6, 10, 8, 8) ||
+		    focus.processLine(9) || !focus.processLine(10) ||
+		    !focus.processLine(17) || focus.processLine(18) ||
+		    focus.processColumn(5) || !focus.processColumn(6) ||
+		    !focus.processColumn(13) || focus.processColumn(14)) {
+			cerr << "Central focus window geometry is wrong" << endl;
+			return TestFail;
+		}
+
+		focus.configure(Rectangle(0, 0, 4, 4), 1);
+		if (!focus.window().isNull() || focus.processLine(0) ||
+		    focus.processColumn(0)) {
+			cerr << "Undersized focus window is not inert" << endl;
+			return TestFail;
+		}
+
+		const SwIspStats sharp = checkerboardMetric(255, 0);
+		const SwIspStats soft = checkerboardMetric(32, 0);
+		const SwIspStats flat = checkerboardMetric(0, 0);
+		const SwIspStats dark = checkerboardMetric(4, 2);
+		const SwIspStats clipped = checkerboardMetric(1023, 2);
+
+		if (sharp.focusGradientSum != 260100 ||
+		    sharp.focusGradientSamples != 4 ||
+		    sharp.focusGreenSum != 510 || sharp.focusGreenSamples != 4 ||
+		    soft.focusGradientSum != 4096 ||
+		    soft.focusGradientSamples != 4 ||
+		    flat.focusGradientSum != 0 ||
+		    flat.focusGradientSamples != 4 ||
+		    dark.focusGradientSum != 4 ||
+		    dark.focusGradientSamples != 4 ||
+		    clipped.focusGradientSum != sharp.focusGradientSum ||
+		    clipped.focusGradientSamples != sharp.focusGradientSamples ||
+		    clipped.focusGreenSum != sharp.focusGreenSum ||
+		    clipped.focusGreenSamples != sharp.focusGreenSamples) {
+			cerr << "Sharp, soft, flat, dark or clipped metric is wrong" << endl;
+			return TestFail;
+		}
+
+		const SwIspStats eightBit = checkerboardMetric(200, 0);
+		const SwIspStats tenBit = checkerboardMetric(800, 2);
+		const SwIspStats twelveBit = checkerboardMetric(3200, 4);
+		const SwIspStats halfContrast = checkerboardMetric(100, 0);
+		if (eightBit.focusGradientSum != 160000 ||
+		    tenBit.focusGradientSum != eightBit.focusGradientSum ||
+		    twelveBit.focusGradientSum != eightBit.focusGradientSum ||
+		    halfContrast.focusGradientSum * 4 !=
+			eightBit.focusGradientSum ||
+		    abs(normalizedMetric(eightBit) -
+			normalizedMetric(halfContrast)) > 0.000001) {
+			cerr << "Bit-depth scaling or quadratic response is wrong" << endl;
+			return TestFail;
+		}
+
+		SwIspStats first{};
+		SwIspStats second{};
+		SwIspStats merged{};
+		focus.configure(Rectangle(0, 0, 16, 16), 2);
+		focus.startFrame();
+		addLine(focus, 0, first, array<uint16_t, 2>{ 0, 200 }, 0);
+		addLine(focus, 1, second, array<uint16_t, 2>{ 0, 100 }, 0);
+		focus.merge(merged, { first, second });
+		if (first.focusGradientSum != 40000 ||
+		    second.focusGradientSum != 10000 ||
+		    merged.focusGradientSum != 60000 ||
+		    merged.focusGradientSamples != 4 ||
+		    merged.focusGreenSum != 300 ||
+		    merged.focusGreenSamples != 4) {
+			cerr << "Per-buffer state or merge is wrong" << endl;
+			return TestFail;
+		}
+
+		first.sum_ = RGB<uint64_t>({ 1, 2, 3 });
+		first.yHistogram[0] = 7;
+		SwStatsCpuFocus::reset(first);
+		if (first.focusGradientSum || first.focusGradientSamples ||
+		    first.focusGreenSum || first.focusGreenSamples ||
+		    first.sum_.r() != 1 || first.sum_.g() != 2 ||
+		    first.sum_.b() != 3 || first.yHistogram[0] != 7) {
+			cerr << "Focus reset changed existing statistics" << endl;
+			return TestFail;
+		}
+
+		focus.configure(Rectangle(0, 0, 16, 16), 1);
+		focus.startFrame();
+		SwStatsCpuFocus::reset(first);
+		addLine(focus, 0, first, array<uint16_t, 2>{ 0, 200 }, 0);
+		addLine(focus, 0, first, array<uint16_t, 2>{ 0, 200 }, 0);
+		if (first.focusGradientSum != 80000 ||
+		    first.focusGradientSamples != 4) {
+			cerr << "Vertical state did not span sampled rows" << endl;
+			return TestFail;
+		}
+		focus.startFrame();
+		SwStatsCpuFocus::reset(first);
+		addLine(focus, 0, first, array<uint16_t, 2>{ 0, 200 }, 0);
+		if (first.focusGradientSum != 40000 ||
+		    first.focusGradientSamples != 1) {
+			cerr << "Frame reset retained vertical history" << endl;
+			return TestFail;
+		}
+
+		constexpr uint64_t columns = 2048 / SwStatsCpuFocus::kSampleStep;
+		constexpr uint64_t rows = 1536 / SwStatsCpuFocus::kSampleStep;
+		constexpr uint64_t gradients =
+			rows * (columns - 1) + (rows - 1) * columns;
+		constexpr uint64_t maximum = gradients * 255 * 255;
+		if (maximum != 25510608000ULL ||
+		    maximum <= numeric_limits<uint32_t>::max()) {
+			cerr << "Accumulator width does not cover a 4096x3072 frame" << endl;
+			return TestFail;
+		}
+
+		constexpr uint64_t values = rows * columns;
+		constexpr uint64_t greenSum = values / 2 * 255;
+		if (!benchmark(maximum, gradients, greenSum, values))
+			return TestFail;
+
+		CameraManager cm;
+		if (!checkUnpackedFormat<uint8_t>(cm, formats::SBGGR8, 255) ||
+		    !checkUnpackedFormat<uint16_t>(cm, formats::SBGGR10, 1023) ||
+		    !checkUnpackedFormat<uint16_t>(cm, formats::SBGGR12, 4095) ||
+		    !checkPacked10Format(cm, formats::SBGGR10_CSI2P) ||
+		    !checkPacked10Format(cm, formats::SGBRG10_CSI2P)) {
+			cerr << "SwStatsCpu Bayer integration failed" << endl;
+			return TestFail;
+		}
+
+		return TestPass;
+	}
+
+private:
+	bool benchmark(uint64_t expectedSum, uint64_t expectedSamples,
+		       uint64_t expectedGreenSum, uint64_t expectedGreenSamples)
+	{
+		constexpr unsigned int kFrames = 10;
+		constexpr unsigned int kColumns = 2048 / SwStatsCpuFocus::kSampleStep;
+		constexpr unsigned int kRows = 1536 / SwStatsCpuFocus::kSampleStep;
+		SwStatsCpuFocus focus;
+		SwIspStats stats{};
+
+		focus.configure(Rectangle(0, 0, 4096, 3072), 1);
+		const auto begin = chrono::steady_clock::now();
+		for (unsigned int frame = 0; frame < kFrames; ++frame) {
+			focus.startFrame();
+			SwStatsCpuFocus::reset(stats);
+			for (unsigned int y = 0; y < kRows; ++y) {
+				focus.startLine(0);
+				for (unsigned int x = 0; x < kColumns; ++x)
+					focus.addSample(0, stats,
+							((x + y) & 1) ? 1020 : 0, 2);
+				focus.finishLine(0);
+			}
+		}
+		const auto elapsed = chrono::duration_cast<chrono::microseconds>(
+			chrono::steady_clock::now() - begin);
+
+		cout << "Focus helper benchmark: " << kFrames
+		     << " synthetic 4096x3072 frames, central 50% ROI, "
+		     << elapsed.count() / kFrames << " us/frame; final sum="
+		     << stats.focusGradientSum << endl;
+
+		if (stats.focusGradientSum != expectedSum ||
+		    stats.focusGradientSamples != expectedSamples ||
+		    stats.focusGreenSum != expectedGreenSum ||
+		    stats.focusGreenSamples != expectedGreenSamples) {
+			cerr << "Full-size accumulation overflowed or lost samples" << endl;
+			return false;
+		}
+
+		return true;
+	}
+};
+
+} /* namespace */
+
+TEST_REGISTER(SwStatsCpuFocusTest)
