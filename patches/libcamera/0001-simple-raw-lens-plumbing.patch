+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Kostik
+ *
+ * Validated raw lens-command plumbing for the Simple pipeline
+ */
+
+#pragma once
+
+#include <functional>
+#include <optional>
+#include <stdint.h>
+
+#include <libcamera/base/class.h>
+
+#include <libcamera/controls.h>
+
+namespace libcamera {
+
+class SimplePipelineLens
+{
+public:
+	using SetPosition = std::function<int(int32_t)>;
+
+	SimplePipelineLens() = default;
+
+	int configure(const ControlInfoMap &kernelControls, bool enabled,
+		      int32_t minimum, int32_t maximum,
+		      SetPosition setPosition);
+
+	/* The frame identifies the statistics decision that caused the command. */
+	int setPosition(uint32_t frame, int32_t position);
+
+	void reset();
+	void resetSession();
+
+	bool enabled() const { return enabled_; }
+	std::optional<int32_t> position() const { return position_; }
+
+private:
+	LIBCAMERA_DISABLE_COPY_AND_MOVE(SimplePipelineLens)
+
+	bool enabled_ = false;
+	int32_t minimum_ = 0;
+	int32_t maximum_ = 0;
+	SetPosition setPosition_;
+
+	std::optional<uint32_t> lastFrame_;
+	std::optional<int32_t> lastRequestedPosition_;
+	std::optional<int32_t> position_;
+	int lastResult_ = 0;
+};
+
+} /* namespace libcamera */
