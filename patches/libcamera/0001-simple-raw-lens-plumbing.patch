diff --git a/src/libcamera/simple_pipeline_lens.cpp b/src/libcamera/simple_pipeline_lens.cpp
new file mode 100644
index 00000000..418289c1
--- /dev/null
+++ b/src/libcamera/simple_pipeline_lens.cpp
@@ -0,0 +1,116 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Kostik
+ *
+ * Validated raw lens-command plumbing for the Simple pipeline
+ */
+
+#include "libcamera/internal/simple_pipeline_lens.h"
+
+#include <errno.h>
+#include <utility>
+
+#include <linux/v4l2-controls.h>
+
+namespace libcamera {
+
+int SimplePipelineLens::configure(const ControlInfoMap &kernelControls,
+				  bool enabled, int32_t minimum,
+				  int32_t maximum, SetPosition setPosition)
+{
+	reset();
+
+	if (!enabled)
+		return 0;
+
+	if (kernelControls.empty())
+		return -ENODEV;
+
+	auto it = kernelControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+	if (it == kernelControls.end())
+		return -EINVAL;
+
+	const ControlInfo &info = it->second;
+	if (info.min().type() != ControlTypeInteger32 ||
+	    info.max().type() != ControlTypeInteger32 ||
+	    info.min().isArray() || info.max().isArray())
+		return -EINVAL;
+
+	int32_t kernelMinimum = info.min().get<int32_t>();
+	int32_t kernelMaximum = info.max().get<int32_t>();
+	if (kernelMinimum == kernelMaximum)
+		return -EACCES;
+	if (kernelMinimum > kernelMaximum)
+		return -EINVAL;
+
+	if (minimum >= maximum)
+		return -EINVAL;
+	if (minimum < kernelMinimum || maximum > kernelMaximum)
+		return -ERANGE;
+	if (!setPosition)
+		return -EINVAL;
+
+	enabled_ = true;
+	minimum_ = minimum;
+	maximum_ = maximum;
+	setPosition_ = std::move(setPosition);
+	return 0;
+}
+
+int SimplePipelineLens::setPosition(uint32_t frame, int32_t position)
+{
+	if (!enabled_)
+		return -ENODEV;
+
+	if (lastFrame_) {
+		if (frame < *lastFrame_)
+			return -ESTALE;
+
+		if (frame == *lastFrame_) {
+			if (position != *lastRequestedPosition_)
+				return -EALREADY;
+
+			return lastResult_;
+		}
+	}
+
+	if (position < minimum_ || position > maximum_)
+		return -ERANGE;
+
+	lastFrame_ = frame;
+	lastRequestedPosition_ = position;
+
+	if (position_ && position == *position_) {
+		lastResult_ = 0;
+		return 0;
+	}
+
+	int ret = setPosition_(position);
+	if (ret > 0)
+		ret = -EIO;
+
+	lastResult_ = ret;
+	if (!ret)
+		position_ = position;
+
+	return ret;
+}
+
+void SimplePipelineLens::reset()
+{
+	enabled_ = false;
+	minimum_ = 0;
+	maximum_ = 0;
+	setPosition_ = {};
+	resetSession();
+}
+
+void SimplePipelineLens::resetSession()
+{
+	lastFrame_.reset();
+	lastRequestedPosition_.reset();
+	position_.reset();
+	lastResult_ = 0;
+}
+
+} /* namespace libcamera */
