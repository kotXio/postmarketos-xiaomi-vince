--- /dev/null
+++ b/test/simple-pipeline-lens.cpp
@@ -0,0 +1,178 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Copyright (C) 2026, Kostik
+ *
+ * Simple pipeline raw lens-command tests
+ */
+
+#include <errno.h>
+#include <iostream>
+#include <utility>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/controls.h>
+
+#include "libcamera/internal/simple_pipeline_lens.h"
+
+#include "test.h"
+
+using namespace libcamera;
+using namespace std;
+
+namespace {
+
+template<typename T>
+int configureWithControl(SimplePipelineLens &lens, unsigned int id,
+			 const ControlInfo &info, bool enabled,
+			 int32_t minimum, int32_t maximum,
+			 SimplePipelineLens::SetPosition setPosition)
+{
+	Control<T> control(id, "TestControl", "test", ControlId::Direction::In);
+	ControlIdMap idMap{ { id, &control } };
+	ControlInfoMap controls({ { &control, info } }, idMap);
+
+	return lens.configure(controls, enabled, minimum, maximum,
+			      std::move(setPosition));
+}
+
+class SimplePipelineLensTest : public Test
+{
+protected:
+	int run() override
+	{
+		SimplePipelineLens lens;
+		ControlInfoMap noControls;
+		auto success = [](int32_t) { return 0; };
+
+		if (lens.configure(noControls, false, 0, 0, {}) ||
+		    lens.enabled() || lens.setPosition(0, 0) != -ENODEV) {
+			cerr << "Disabled lens configuration is not inert" << endl;
+			return TestFail;
+		}
+
+		if (lens.configure(noControls, true, 242, 726, success) != -ENODEV) {
+			cerr << "Missing lens was not rejected" << endl;
+			return TestFail;
+		}
+
+		if (configureWithControl<int32_t>(lens, V4L2_CID_ZOOM_ABSOLUTE,
+						  ControlInfo(0, 1023, 0), true,
+						  242, 726, success) != -EINVAL) {
+			cerr << "Missing focus control was not rejected" << endl;
+			return TestFail;
+		}
+
+		if (configureWithControl<float>(lens, V4L2_CID_FOCUS_ABSOLUTE,
+					      ControlInfo(0.0f, 1023.0f, 0.0f), true,
+					      242, 726, success) != -EINVAL) {
+			cerr << "Malformed focus control was not rejected" << endl;
+			return TestFail;
+		}
+
+		if (configureWithControl<int32_t>(lens, V4L2_CID_FOCUS_ABSOLUTE,
+						  ControlInfo(517, 517, 517), true,
+						  242, 517, success) != -EACCES) {
+			cerr << "Read-only focus range was not rejected" << endl;
+			return TestFail;
+		}
+
+		if (configureWithControl<int32_t>(lens, V4L2_CID_FOCUS_ABSOLUTE,
+						  ControlInfo(1023, 0, 0), true,
+						  242, 726, success) != -EINVAL) {
+			cerr << "Malformed kernel range was not rejected" << endl;
+			return TestFail;
+		}
+
+		if (configureWithControl<int32_t>(lens, V4L2_CID_FOCUS_ABSOLUTE,
+						  ControlInfo(0, 1023, 0), true,
+						  726, 242, success) != -EINVAL) {
+			cerr << "Malformed configured range was not rejected" << endl;
+			return TestFail;
+		}
+
+		if (configureWithControl<int32_t>(lens, V4L2_CID_FOCUS_ABSOLUTE,
+						  ControlInfo(0, 517, 0), true,
+						  242, 726, success) != -ERANGE) {
+			cerr << "Range outside kernel limits was not rejected" << endl;
+			return TestFail;
+		}
+
+		if (configureWithControl<int32_t>(lens, V4L2_CID_FOCUS_ABSOLUTE,
+						  ControlInfo(0, 1023, 0), true,
+						  242, 726, {}) != -EINVAL) {
+			cerr << "Missing writer was not rejected" << endl;
+			return TestFail;
+		}
+
+		unsigned int writes = 0;
+		int32_t writtenPosition = -1;
+		bool failWrite = false;
+		auto writer = [&](int32_t position) {
+			++writes;
+			writtenPosition = position;
+			return failWrite ? -EIO : 0;
+		};
+
+		if (configureWithControl<int32_t>(lens, V4L2_CID_FOCUS_ABSOLUTE,
+						  ControlInfo(0, 1023, 0), true,
+						  242, 726, writer) ||
+		    !lens.enabled()) {
+			cerr << "Valid configuration failed" << endl;
+			return TestFail;
+		}
+
+		if (lens.setPosition(1, 241) != -ERANGE || writes) {
+			cerr << "Out-of-range position reached the writer" << endl;
+			return TestFail;
+		}
+
+		if (lens.setPosition(10, 242) || writes != 1 ||
+		    writtenPosition != 242 || lens.position() != 242) {
+			cerr << "Valid position was not applied" << endl;
+			return TestFail;
+		}
+
+		if (lens.setPosition(10, 242) || writes != 1 ||
+		    lens.setPosition(10, 250) != -EALREADY ||
+		    lens.setPosition(11, 242) || writes != 1 ||
+		    lens.setPosition(9, 250) != -ESTALE) {
+			cerr << "Duplicate or ordered-command handling failed" << endl;
+			return TestFail;
+		}
+
+		failWrite = true;
+		if (lens.setPosition(12, 300) != -EIO || writes != 2 ||
+		    lens.position() != 242 ||
+		    lens.setPosition(12, 300) != -EIO || writes != 2) {
+			cerr << "Write failure handling failed" << endl;
+			return TestFail;
+		}
+
+		failWrite = false;
+		if (lens.setPosition(13, 300) || writes != 3 ||
+		    lens.position() != 300) {
+			cerr << "Write recovery failed" << endl;
+			return TestFail;
+		}
+
+		lens.resetSession();
+		if (lens.position() || lens.setPosition(1, 300) || writes != 4) {
+			cerr << "Session cleanup did not clear duplicate state" << endl;
+			return TestFail;
+		}
+
+		lens.reset();
+		if (lens.enabled() || lens.position() ||
+		    lens.setPosition(2, 300) != -ENODEV) {
+			cerr << "Full reset did not disable the lens" << endl;
+			return TestFail;
+		}
+
+		return TestPass;
+	}
+};
