 #include "libcamera/internal/pipeline_handler.h"
 #include "libcamera/internal/shared_mem_object.h"
 #include "libcamera/internal/software_isp/debayer_params.h"
+#include "libcamera/internal/software_isp/software_isp_lens_gate.h"
 
 namespace libcamera {
 
@@ -106,6 +107,7 @@ private:
 	DmaBufAllocator dmaHeap_;
 	bool ccmEnabled_;
 
+	SoftwareIspLensGate lensGate_;
 	std::unique_ptr<ipa::soft::IPAProxySoft> ipa_;
 	std::deque<FrameBuffer *> queuedInputBuffers_;
 	std::deque<FrameBuffer *> queuedOutputBuffers_;
diff --git a/include/libcamera/internal/software_isp/software_isp_lens_gate.h b/include/libcamera/internal/software_isp/software_isp_lens_gate.h
new file mode 100644
index 00000000..cb0faf3d
--- /dev/null
+++ b/include/libcamera/internal/software_isp/software_isp_lens_gate.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Kostiantyn Andriiuk
+ *
+ * Software ISP lens lifecycle gate
+ */
+
+#pragma once
+
+#include <utility>
+
+namespace libcamera {
+
+class SoftwareIspLensGate
+{
+public:
+	void start()
+	{
+		running_ = true;
+	}
+
+	void stop()
+	{
+		running_ = false;
+	}
+
+	template<typename Function>
+	bool invoke(Function &&function)
+	{
+		if (!running_)
+			return false;
+
+		std::forward<Function>(function)();
+		return true;
+	}
+
+private:
+	bool running_ = false;
+};
+
+} /* namespace libcamera */
diff --git a/src/libcamera/software_isp/software_isp.cpp b/src/libcamera/software_isp/software_isp.cpp
index 40910303..ffc22fd2 100644
--- a/src/libcamera/software_isp/software_isp.cpp
+++ b/src/libcamera/software_isp/software_isp.cpp
@@ -367,10 +367,15 @@ int SoftwareIsp::start()
 	if (ret)
 		return ret;
 
+	lensGate_.start();
 	ispWorkerThread_.start();
 
-	return debayer_->invokeMethod(&Debayer::start,
-				      ConnectionTypeBlocking);
+	ret = debayer_->invokeMethod(&Debayer::start,
+				     ConnectionTypeBlocking);
+	if (ret)
+		lensGate_.stop();
+
+	return ret;
 }
 
 /**
@@ -381,6 +386,8 @@ int SoftwareIsp::start()
  */
 void SoftwareIsp::stop()
 {
+	lensGate_.stop();
+
 	debayer_->invokeMethod(&Debayer::stop,
 			       ConnectionTypeBlocking);
 
@@ -431,13 +438,17 @@ void SoftwareIsp::setSensorCtrls(const ControlList &sensorControls)
 
 void SoftwareIsp::setLensPositionFromIpa(uint32_t frame, int32_t position)
 {
-	setLensPosition.emit(frame, position);
+	lensGate_.invoke([this, frame, position]() {
+		setLensPosition.emit(frame, position);
+	});
 }
 
 void SoftwareIsp::setLensPositionResult(uint32_t frame, int32_t position,
 					int32_t result)
 {
-	ipa_->setLensPositionResult(frame, position, result);
+	lensGate_.invoke([this, frame, position, result]() {
+		ipa_->setLensPositionResult(frame, position, result);
+	});
 }
 
 void SoftwareIsp::statsReady(uint32_t frame, uint32_t bufferId)
