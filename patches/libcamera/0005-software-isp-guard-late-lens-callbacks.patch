--- /dev/null
+++ b/test/software-isp-lens-gate.cpp
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Copyright (C) 2026, Kostiantyn Andriiuk
+ *
+ * Software ISP lens lifecycle gate tests
+ */
+
+#include <iostream>
+
+#include "libcamera/internal/software_isp/software_isp_lens_gate.h"
+
+#include "test.h"
+
+using namespace libcamera;
+using namespace std;
+
+namespace {
+
+class SoftwareIspLensGateTest : public Test
+{
+protected:
+	int run() override
+	{
+		SoftwareIspLensGate gate;
+		unsigned int commands = 0;
+		unsigned int results = 0;
+
+		auto command = [&commands]() { ++commands; };
+		auto result = [&results]() { ++results; };
+
+		if (gate.invoke(command) || gate.invoke(result) || commands ||
+		    results) {
+			cerr << "Inactive gate forwarded a callback" << endl;
+			return TestFail;
+		}
+
+		gate.start();
+		if (!gate.invoke(command) || !gate.invoke(result) || commands != 1 ||
+		    results != 1) {
+			cerr << "Running gate rejected a callback" << endl;
+			return TestFail;
+		}
+
+		/*
+		 * Model a queued setLensPosition callback drained after stop has
+		 * begun. Neither the physical command nor its proxy result may cross
+		 * the SoftwareIsp boundary during teardown.
+		 */
+		gate.stop();
+		if (gate.invoke(command) || gate.invoke(result) || commands != 1 ||
+		    results != 1) {
+			cerr << "Stopping gate forwarded a late lens callback" << endl;
+			return TestFail;
+		}
+
+		/* A new rear-camera session must reactivate the same object. */
+		gate.start();
+		if (!gate.invoke(command) || !gate.invoke(result) || commands != 2 ||
+		    results != 2) {
+			cerr << "Restarted gate rejected a callback" << endl;
+			return TestFail;
+		}
+
+		gate.stop();
+		if (gate.invoke(command) || commands != 2) {
+			cerr << "Second stop forwarded a late callback" << endl;
+			return TestFail;
+		}
+
+		return TestPass;
+	}
+};
+
+} /* namespace */
+
+TEST_REGISTER(SoftwareIspLensGateTest)
