 test/meson.build                              |  1 +
 test/software-isp-lens-gate.cpp               | 76 +++++++++++++++++++
 6 files changed, 136 insertions(+), 4 deletions(-)
 create mode 100644 include/libcamera/internal/software_isp/software_isp_lens_gate.h
 create mode 100644 test/software-isp-lens-gate.cpp

