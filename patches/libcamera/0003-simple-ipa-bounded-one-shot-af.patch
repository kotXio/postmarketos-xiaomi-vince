+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Kostiantyn Andriiuk
+ *
+ * Bounded one-shot autofocus for the Simple IPA
+ */
+
+#pragma once
+
+#include "af_state.h"
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context,
+		      const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+	bool available() const { return available_; }
+	const AfConfiguration &configuration() const { return configuration_; }
+
+	std::optional<int32_t> takeLensCommand(uint32_t frame);
+	void setLensPositionResult(uint32_t frame, int32_t position,
+				   int32_t result);
+	void resetSession();
+
+private:
+	int validateLensControls(const ControlInfoMap &controls) const;
+	int32_t metadataState() const;
+
+	AfConfiguration configuration_;
+	AfStateMachine stateMachine_;
+	bool available_ = false;
+	std::size_t loggedMetrics_ = 0;
+	AfStatus loggedStatus_ = AfStatus::Idle;
+	AfFailure loggedFailure_ = AfFailure::None;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
diff --git a/src/ipa/simple/algorithms/af_state.cpp b/src/ipa/simple/algorithms/af_state.cpp
new file mode 100644
index 00000000..f8b3b1ec
--- /dev/null
+++ b/src/ipa/simple/algorithms/af_state.cpp
@@ -0,0 +1,573 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Kostiantyn Andriiuk
+ *
+ * Bounded one-shot autofocus state machine for the Simple IPA
+ */
+
+#include "af_state.h"
+
+#include <algorithm>
+#include <cmath>
+#include <errno.h>
+#include <limits>
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+namespace {
+
+double median(std::vector<double> values)
+{
+	const std::size_t middle = values.size() / 2;
+	std::nth_element(values.begin(), values.begin() + middle, values.end());
+	double result = values[middle];
+
+	if (values.size() % 2 == 0) {
+		const auto lower = std::max_element(values.begin(),
+						   values.begin() + middle);
+		result = (*lower + result) * 0.5;
+	}
+
+	return result;
+}
+
+double ratio(const std::vector<double> &values)
+{
+	double minimum = std::numeric_limits<double>::infinity();
+	double maximum = 0.0;
+
+	for (double value : values) {
+		if (!std::isfinite(value) || value <= 0.0)
+			return std::numeric_limits<double>::infinity();
+		minimum = std::min(minimum, value);
+		maximum = std::max(maximum, value);
+	}
+
+	if (!std::isfinite(minimum) || minimum <= 0.0)
+		return std::numeric_limits<double>::infinity();
+
+	return maximum / minimum;
+}
+
+} /* namespace */
+
+bool AfConfiguration::valid() const
+{
+	return infinity >= 0 && macro > infinity &&
+	       macro - infinity <= 768 &&
+	       coarseStep > 0 && fineStep > 0 && fineStep < coarseStep &&
+	       settleFrames <= 60 &&
+	       metricFrames > 0 && metricFrames <= 9 && metricFrames % 2 == 1 &&
+	       aeMinimumFrames > 0 &&
+	       aeWindowFrames > 0 && aeWindowFrames <= aeMinimumFrames &&
+	       aeMaximumFrames >= aeMinimumFrames &&
+	       maximumMetricFrames >= settleFrames + metricFrames &&
+	       aeMaximumRatio >= 1.0 && maximumExposureRatio >= 1.0 &&
+	       minimumFocusSpread >= 0.0 && minimumFocusSpread < 1.0 &&
+	       minimumMean >= 0.0 && maximumMean > minimumMean &&
+	       maximumMean <= 255.0 &&
+	       maximumClippedFraction >= 0.0 &&
+	       maximumClippedFraction <= 1.0 &&
+	       minimumScore >= 0.0 &&
+	       confirmationMinimumRatio > 0.0 &&
+	       confirmationMaximumRatio >= confirmationMinimumRatio;
+}
+
+const char *afFailureName(AfFailure failure)
+{
+	switch (failure) {
+	case AfFailure::None:
+		return "none";
+	case AfFailure::Incomplete:
+		return "incomplete-statistics";
+	case AfFailure::Dark:
+		return "scene-too-dark";
+	case AfFailure::Clipped:
+		return "scene-too-clipped";
+	case AfFailure::Flat:
+		return "focus-curve-too-flat";
+	case AfFailure::Exposure:
+		return "exposure-unstable";
+	case AfFailure::Lens:
+		return "lens-write-failed";
+	case AfFailure::Timeout:
+		return "statistics-timeout";
+	case AfFailure::Confirmation:
+		return "best-position-confirmation-failed";
+	case AfFailure::Protocol:
+		return "lens-command-protocol-error";
+	}
+
+	return "unknown";
+}
+
+std::vector<int32_t> AfStateMachine::scanPositions(int32_t first,
+						   int32_t last,
+						   int32_t step)
+{
+	std::vector<int32_t> positions;
+
+	if (first < 0 || last < first || step <= 0)
+		return positions;
+
+	for (int32_t value = first; value < last;) {
+		positions.push_back(value);
+		if (value > last - step)
+			break;
+		value += step;
+	}
+
+	if (positions.empty() || positions.back() != last)
+		positions.push_back(last);
+
+	return positions;
+}
+
+int AfStateMachine::configure(const AfConfiguration &configuration)
+{
+	if (!configuration.valid())
+		return -EINVAL;
+
+	configuration_ = configuration;
+	configured_ = true;
+	reset();
+	return 0;
+}
+
+void AfStateMachine::reset()
+{
+	status_ = AfStatus::Idle;
+	failure_ = AfFailure::None;
+	phase_ = Phase::Idle;
+	phaseAfterSettle_ = Phase::Idle;
+	command_.reset();
+	pending_.reset();
+	nextCommandFrame_ = 0;
+	restartAfterPending_ = false;
+	cancelledPending_ = false;
+	currentPosition_.reset();
+	bestPosition_.reset();
+	bestScore_ = 0.0;
+	settleFramesRemaining_ = 0;
+	aeFrames_ = 0;
+	metricFrames_ = 0;
+	aeHistory_.clear();
+	scores_.clear();
+	means_.clear();
+	clippedFractions_.clear();
+	exposures_.clear();
+	activePositions_.clear();
+	activePosition_ = 0;
+	metrics_.clear();
+}
+
+void AfStateMachine::beginScan()
+{
+	status_ = AfStatus::Scanning;
+	failure_ = AfFailure::None;
+	phase_ = Phase::WaitLens;
+	phaseAfterSettle_ = Phase::Idle;
+	command_.reset();
+	restartAfterPending_ = false;
+	cancelledPending_ = false;
+	bestPosition_.reset();
+	bestScore_ = 0.0;
+	settleFramesRemaining_ = 0;
+	aeFrames_ = 0;
+	metricFrames_ = 0;
+	aeHistory_.clear();
+	scores_.clear();
+	means_.clear();
+	clippedFractions_.clear();
+	exposures_.clear();
+	activePositions_.clear();
+	activePosition_ = 0;
+	metrics_.clear();
+
+	requestLens(configuration_.infinity, LensRole::Initial);
+}
+
+void AfStateMachine::start()
+{
+	if (!configured_ || status_ == AfStatus::Scanning)
+		return;
+
+	if (pending_) {
+		status_ = AfStatus::Scanning;
+		failure_ = AfFailure::None;
+		phase_ = Phase::RestartWait;
+		command_.reset();
+		restartAfterPending_ = true;
+		cancelledPending_ = false;
+		return;
+	}
+
+	beginScan();
+}
+
+void AfStateMachine::cancel()
+{
+	if (status_ != AfStatus::Scanning)
+		return;
+
+	status_ = AfStatus::Idle;
+	failure_ = AfFailure::None;
+	phase_ = Phase::Idle;
+	command_.reset();
+	restartAfterPending_ = false;
+	cancelledPending_ = pending_.has_value();
+}
+
+void AfStateMachine::requestLens(int32_t position, LensRole role)
+{
+	if (command_ || pending_)
+		return;
+
+	command_ = LensRequest{ 0, position, role };
+	phase_ = Phase::WaitLens;
+}
+
+std::optional<int32_t> AfStateMachine::takeLensCommand(uint32_t frame)
+{
+	if (!command_ || pending_ || frame < nextCommandFrame_)
+		return std::nullopt;
+
+	command_->frame = frame;
+	pending_ = command_;
+	command_.reset();
+	nextCommandFrame_ = frame + 1;
+	return pending_->position;
+}
+
+void AfStateMachine::enterSettling(Phase next)
+{
+	phaseAfterSettle_ = next;
+	settleFramesRemaining_ = configuration_.settleFrames;
+	phase_ = settleFramesRemaining_ ? Phase::Settle : next;
+	metricFrames_ = 0;
+	scores_.clear();
+	means_.clear();
+	clippedFractions_.clear();
+	exposures_.clear();
+}
+
+bool AfStateMachine::setLensPositionResult(uint32_t frame, int32_t position,
+					    int32_t result)
+{
+	if (!pending_ || pending_->frame != frame ||
+	    pending_->position != position) {
+		if (status_ == AfStatus::Scanning)
+			fail(AfFailure::Protocol);
+		return false;
+	}
+
+	const LensRole role = pending_->role;
+	pending_.reset();
+
+	if (!result)
+		currentPosition_ = position;
+
+	if (cancelledPending_) {
+		cancelledPending_ = false;
+		return true;
+	}
+
+	if (restartAfterPending_) {
+		restartAfterPending_ = false;
+		beginScan();
+		return true;
+	}
+
+	if (role == LensRole::Safe)
+		return true;
+
+	if (result) {
+		fail(AfFailure::Lens);
+		return true;
+	}
+
+	if (status_ != AfStatus::Scanning)
+		return true;
+
+	switch (role) {
+	case LensRole::Initial:
+		enterSettling(Phase::SettleAe);
+		break;
+	case LensRole::Scan:
+		enterSettling(Phase::Collect);
+		break;
+	case LensRole::Winner:
+		enterSettling(Phase::Confirm);
+		break;
+	case LensRole::Safe:
+		break;
+	}
+
+	return true;
+}
+
+AfFailure AfStateMachine::validateFrame(const AfFrameStats &stats) const
+{
+	if (!stats.complete || !std::isfinite(stats.score) ||
+	    !std::isfinite(stats.mean) ||
+	    !std::isfinite(stats.clippedFraction) ||
+	    !std::isfinite(stats.exposureProduct) ||
+	    stats.exposureProduct <= 0.0)
+		return AfFailure::Incomplete;
+
+	if (stats.mean < configuration_.minimumMean)
+		return AfFailure::Dark;
+	if (stats.mean > configuration_.maximumMean ||
+	    stats.clippedFraction > configuration_.maximumClippedFraction)
+		return AfFailure::Clipped;
+	if (stats.score < configuration_.minimumScore)
+		return AfFailure::Flat;
+
+	return AfFailure::None;
+}
+
+AfPositionMetric AfStateMachine::aggregatePosition(int32_t position) const
+{
+	return {
+		position,
+		median(scores_),
+		median(means_),
+		median(clippedFractions_),
+		median(exposures_),
+	};
+}
+
+AfFailure
+AfStateMachine::validateCurve(const std::vector<AfPositionMetric> &metrics) const
+{
+	if (metrics.empty())
+		return AfFailure::Incomplete;
+
+	std::vector<double> exposures;
+	exposures.reserve(metrics.size());
+	double minimumScore = std::numeric_limits<double>::infinity();
+	double maximumScore = 0.0;
+
+	for (const AfPositionMetric &metric : metrics) {
+		exposures.push_back(metric.exposureProduct);
+		minimumScore = std::min(minimumScore, metric.score);
+		maximumScore = std::max(maximumScore, metric.score);
+	}
+
+	if (ratio(exposures) > configuration_.maximumExposureRatio)
+		return AfFailure::Exposure;
+	if (maximumScore <= std::numeric_limits<double>::epsilon() ||
+	    (maximumScore - minimumScore) / maximumScore <
+		    configuration_.minimumFocusSpread)
+		return AfFailure::Flat;
+
+	return AfFailure::None;
+}
+
+void AfStateMachine::startCoarseScan()
+{
+	activePositions_ = scanPositions(configuration_.infinity,
+					 configuration_.macro,
+					 configuration_.coarseStep);
+	activePosition_ = 0;
+	scanStage_ = ScanStage::Coarse;
+	requestLens(activePositions_.front(), LensRole::Scan);
+}
+
+void AfStateMachine::finishPosition()
+{
+	metrics_.push_back(aggregatePosition(activePositions_[activePosition_]));
+
+	++activePosition_;
+	if (activePosition_ < activePositions_.size()) {
+		requestLens(activePositions_[activePosition_], LensRole::Scan);
+		return;
+	}
+
+	finishScanStage();
+}
+
+void AfStateMachine::finishScanStage()
+{
+	const AfFailure validation = validateCurve(metrics_);
+	if (validation != AfFailure::None) {
+		fail(validation);
+		return;
+	}
+
+	if (scanStage_ == ScanStage::Coarse) {
+		const auto best = std::max_element(
+			metrics_.begin(), metrics_.end(),
+			[](const AfPositionMetric &left,
+			   const AfPositionMetric &right) {
+				return left.score < right.score;
+			});
+		const int32_t first = std::max(configuration_.infinity,
+					       best->position -
+						       configuration_.coarseStep);
+		const int32_t last = std::min(configuration_.macro,
+					      best->position +
+						      configuration_.coarseStep);
+		const std::vector<int32_t> candidates =
+			scanPositions(first, last, configuration_.fineStep);
+
+		activePositions_.clear();
+		for (int32_t position : candidates) {
+			const bool sampled = std::any_of(
+				metrics_.begin(), metrics_.end(),
+				[position](const AfPositionMetric &metric) {
+					return metric.position == position;
+				});
+			if (!sampled)
+				activePositions_.push_back(position);
+		}
+
+		scanStage_ = ScanStage::Fine;
+		activePosition_ = 0;
+		if (!activePositions_.empty()) {
+			requestLens(activePositions_.front(), LensRole::Scan);
+			return;
+		}
+	}
+
+	startWinnerConfirmation();
+}
+
+void AfStateMachine::startWinnerConfirmation()
+{
+	const auto best = std::max_element(
+		metrics_.begin(), metrics_.end(),
+		[](const AfPositionMetric &left, const AfPositionMetric &right) {
+			return left.score < right.score;
+		});
+
+	bestPosition_ = best->position;
+	bestScore_ = best->score;
+	requestLens(*bestPosition_, LensRole::Winner);
+}
+
+void AfStateMachine::finishConfirmation()
+{
+	const AfPositionMetric confirmation =
+		aggregatePosition(bestPosition_.value());
+	const double confirmationRatio = confirmation.score / bestScore_;
+
+	std::vector<double> exposures;
+	exposures.reserve(metrics_.size() + 1);
+	for (const AfPositionMetric &metric : metrics_)
+		exposures.push_back(metric.exposureProduct);
+	exposures.push_back(confirmation.exposureProduct);
+
+	if (ratio(exposures) > configuration_.maximumExposureRatio) {
+		fail(AfFailure::Exposure);
+		return;
+	}
+
+	if (confirmationRatio < configuration_.confirmationMinimumRatio ||
+	    confirmationRatio > configuration_.confirmationMaximumRatio) {
+		fail(AfFailure::Confirmation);
+		return;
+	}
+
+	status_ = AfStatus::Focused;
+	failure_ = AfFailure::None;
+	phase_ = Phase::Terminal;
+}
+
+void AfStateMachine::fail(AfFailure failure)
+{
+	status_ = AfStatus::Failed;
+	failure_ = failure;
+	phase_ = Phase::Terminal;
+	command_.reset();
+	pending_.reset();
+	restartAfterPending_ = false;
+	cancelledPending_ = false;
+
+	if (currentPosition_ &&
+	    *currentPosition_ != configuration_.infinity)
+		requestLens(configuration_.infinity, LensRole::Safe);
+}
+
+void AfStateMachine::process(const AfFrameStats &stats)
+{
+	if (status_ != AfStatus::Scanning)
+		return;
+
+	if (phase_ == Phase::Settle) {
+		if (settleFramesRemaining_)
+			--settleFramesRemaining_;
+		if (!settleFramesRemaining_)
+			phase_ = phaseAfterSettle_;
+		return;
+	}
+
+	if (phase_ == Phase::SettleAe) {
+		++aeFrames_;
+		if (!std::isfinite(stats.exposureProduct) ||
+		    stats.exposureProduct <= 0.0 ||
+		    stats.exposure <= 0 || !std::isfinite(stats.gain) ||
+		    stats.gain <= 0.0) {
+			fail(AfFailure::Incomplete);
+			return;
+		}
+
+		aeHistory_.push_back(stats.exposureProduct);
+		if (aeFrames_ >= configuration_.aeMinimumFrames &&
+		    aeHistory_.size() >= configuration_.aeWindowFrames) {
+			const auto first = aeHistory_.end() -
+					   configuration_.aeWindowFrames;
+			const std::vector<double> window(first, aeHistory_.end());
+			if (ratio(window) <= configuration_.aeMaximumRatio) {
+				startCoarseScan();
+				return;
+			}
+		}
+
+		if (aeFrames_ >= configuration_.aeMaximumFrames)
+			fail(AfFailure::Timeout);
+		return;
+	}
+
+	if (phase_ != Phase::Collect && phase_ != Phase::Confirm)
+		return;
+
+	++metricFrames_;
+	if (metricFrames_ > configuration_.maximumMetricFrames) {
+		fail(AfFailure::Timeout);
+		return;
+	}
+
+	if (!stats.valid)
+		return;
+
+	const AfFailure validation = validateFrame(stats);
+	if (validation != AfFailure::None) {
+		fail(validation);
+		return;
+	}
+
+	scores_.push_back(stats.score);
+	means_.push_back(stats.mean);
+	clippedFractions_.push_back(stats.clippedFraction);
+	exposures_.push_back(stats.exposureProduct);
+
+	if (scores_.size() < configuration_.metricFrames)
+		return;
+
+	if (ratio(exposures_) > configuration_.maximumExposureRatio) {
+		fail(AfFailure::Exposure);
+		return;
+	}
+
+	if (phase_ == Phase::Confirm)
+		finishConfirmation();
+	else
+		finishPosition();
+}
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
