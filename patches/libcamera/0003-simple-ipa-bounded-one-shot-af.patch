+++ b/test/simple-ipa-af.cpp
@@ -0,0 +1,479 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Copyright (C) 2026, Kostiantyn Andriiuk
+ *
+ * Simple IPA bounded one-shot autofocus tests
+ */
+
+#include <cmath>
+#include <errno.h>
+#include <functional>
+#include <iostream>
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/control_ids.h>
+#include <libcamera/controls.h>
+
+#include "libcamera/internal/value_node.h"
+
+#include "../src/ipa/simple/algorithms/af.h"
+
+#include "test.h"
+
+using namespace libcamera;
+using namespace libcamera::ipa::soft;
+using namespace libcamera::ipa::soft::algorithms;
+using namespace std;
+
+namespace {
+
+AfConfiguration configuration()
+{
+	return {
+		.infinity = 242,
+		.macro = 726,
+		.coarseStep = 48,
+		.fineStep = 8,
+		.settleFrames = 2,
+		.metricFrames = 3,
+		.aeMinimumFrames = 12,
+		.aeWindowFrames = 12,
+		.aeMaximumFrames = 180,
+		.maximumMetricFrames = 60,
+		.aeMaximumRatio = 1.05,
+		.maximumExposureRatio = 1.25,
+		.minimumFocusSpread = 0.05,
+		.minimumMean = 8.0,
+		.maximumMean = 247.0,
+		.maximumClippedFraction = 0.30,
+		.minimumScore = 0.01,
+		.confirmationMinimumRatio = 0.80,
+		.confirmationMaximumRatio = 1.25,
+	};
+}
+
+unique_ptr<ValueNode> tuningData()
+{
+	const AfConfiguration config = configuration();
+	auto data = make_unique<ValueNode>();
+
+	data->add("infinity", make_unique<ValueNode>(config.infinity));
+	data->add("macro", make_unique<ValueNode>(config.macro));
+	data->add("coarseStep", make_unique<ValueNode>(config.coarseStep));
+	data->add("fineStep", make_unique<ValueNode>(config.fineStep));
+	data->add("settleFrames", make_unique<ValueNode>(config.settleFrames));
+	data->add("metricFrames", make_unique<ValueNode>(config.metricFrames));
+	data->add("aeMinimumFrames",
+		  make_unique<ValueNode>(config.aeMinimumFrames));
+	data->add("aeWindowFrames",
+		  make_unique<ValueNode>(config.aeWindowFrames));
+	data->add("aeMaximumFrames",
+		  make_unique<ValueNode>(config.aeMaximumFrames));
+	data->add("maximumMetricFrames",
+		  make_unique<ValueNode>(config.maximumMetricFrames));
+	data->add("aeMaximumRatio",
+		  make_unique<ValueNode>(config.aeMaximumRatio));
+	data->add("maximumExposureRatio",
+		  make_unique<ValueNode>(config.maximumExposureRatio));
+	data->add("minimumFocusSpread",
+		  make_unique<ValueNode>(config.minimumFocusSpread));
+	data->add("minimumMean", make_unique<ValueNode>(config.minimumMean));
+	data->add("maximumMean", make_unique<ValueNode>(config.maximumMean));
+	data->add("maximumClippedFraction",
+		  make_unique<ValueNode>(config.maximumClippedFraction));
+	data->add("minimumScore", make_unique<ValueNode>(config.minimumScore));
+	data->add("confirmationMinimumRatio",
+		  make_unique<ValueNode>(config.confirmationMinimumRatio));
+	data->add("confirmationMaximumRatio",
+		  make_unique<ValueNode>(config.confirmationMaximumRatio));
+
+	return data;
+}
+
+AfFrameStats frameStats(int32_t position, uint32_t frame,
+			double exposureProduct = 1000.0)
+{
+	const double distance = std::abs(position - 538);
+	return {
+		.valid = frame % 4 == 0,
+		.complete = true,
+		.score = 0.12 - distance * 0.00015,
+		.mean = 80.0,
+		.clippedFraction = 0.0,
+		.exposureProduct = exposureProduct,
+		.exposure = static_cast<int32_t>(exposureProduct),
+		.gain = 1.0,
+	};
+}
+
+struct DriveResult {
+	vector<int32_t> commands;
+	uint32_t nextFrame = 1;
+};
+
+using StatsFactory =
+	function<AfFrameStats(int32_t position, uint32_t frame)>;
+using LensResult =
+	function<int(int32_t position, const vector<int32_t> &commands)>;
+
+DriveResult drive(AfStateMachine &machine, unsigned int maximumFrames,
+		  StatsFactory statsFactory,
+		  LensResult lensResult = {})
+{
+	DriveResult result;
+	int32_t position = 242;
+
+	for (unsigned int iteration = 0;
+	     iteration < maximumFrames &&
+	     machine.status() == AfStatus::Scanning;
+	     ++iteration, ++result.nextFrame) {
+		const optional<int32_t> command =
+			machine.takeLensCommand(result.nextFrame);
+		if (command) {
+			result.commands.push_back(*command);
+			const int ret = lensResult
+					      ? lensResult(*command,
+							   result.commands)
+					      : 0;
+			if (!ret)
+				position = *command;
+			if (!machine.setLensPositionResult(result.nextFrame,
+							   *command, ret))
+				break;
+			continue;
+		}
+
+		machine.process(statsFactory(position, result.nextFrame));
+	}
+
+	/*
+	 * A Failed state can still have one queued best-effort safe-infinity
+	 * command. Consume it without changing the terminal state.
+	 */
+	if (const optional<int32_t> command =
+		    machine.takeLensCommand(result.nextFrame)) {
+		result.commands.push_back(*command);
+		machine.setLensPositionResult(result.nextFrame, *command, 0);
+	}
+
+	return result;
+}
+
+bool allBounded(const vector<int32_t> &commands)
+{
+	for (int32_t position : commands) {
+		if (position < 242 || position > 726)
+			return false;
+	}
+	return true;
+}
+
+class SimpleIpaAfTest : public Test
+{
+protected:
+	int run() override
+	{
+		if (!testConfiguration() || !testAlgorithmOptIn() ||
+		    !testSuccess() ||
+		    !testCancel() || !testLensFailure() ||
+		    !testSceneFailures() || !testExposureFailures() ||
+		    !testProtocolFailure())
+			return TestFail;
+
+		return TestPass;
+	}
+
+	bool testAlgorithmOptIn()
+	{
+		Control<int32_t> focus(V4L2_CID_FOCUS_ABSOLUTE, "Focus",
+				       "v4l2", ControlId::Direction::In);
+		ControlIdMap idMap{ { V4L2_CID_FOCUS_ABSOLUTE, &focus } };
+		ControlInfoMap lensControls(
+			{ { &focus, ControlInfo(0, 726, 214) } }, idMap);
+
+		IPAContext context(16);
+		context.lensControls = &lensControls;
+		Af algorithm;
+		unique_ptr<ValueNode> tuning = tuningData();
+		if (algorithm.init(context, *tuning) || !algorithm.available() ||
+		    context.ctrlMap.count(&controls::AfMode) != 1 ||
+		    context.ctrlMap.count(&controls::AfTrigger) != 1) {
+			cerr << "Valid lens and tuning did not advertise AF" << endl;
+			return false;
+		}
+
+		const ControlInfo &modes = context.ctrlMap.at(&controls::AfMode);
+		if (modes.values().size() != 1 ||
+		    modes.values().front().get<int32_t>() !=
+			    controls::AfModeAuto) {
+			cerr << "AF advertised unsupported modes" << endl;
+			return false;
+		}
+
+		IPAContext noLensContext(16);
+		Af noLensAlgorithm;
+		tuning = tuningData();
+		if (noLensAlgorithm.init(noLensContext, *tuning) ||
+		    noLensAlgorithm.available() ||
+		    !noLensContext.ctrlMap.empty()) {
+			cerr << "AF did not stay inert without a linked lens" << endl;
+			return false;
+		}
+
+		IPAContext shortLensContext(16);
+		ControlInfoMap shortLens(
+			{ { &focus, ControlInfo(0, 517, 214) } }, idMap);
+		shortLensContext.lensControls = &shortLens;
+		Af shortLensAlgorithm;
+		tuning = tuningData();
+		if (shortLensAlgorithm.init(shortLensContext, *tuning) ||
+		    shortLensAlgorithm.available()) {
+			cerr << "AF accepted a kernel range below macro" << endl;
+			return false;
+		}
+
+		return true;
+	}
+
+private:
+	bool testConfiguration()
+	{
+		AfConfiguration config = configuration();
+		if (!config.valid()) {
+			cerr << "Accepted Vince configuration is invalid" << endl;
+			return false;
+		}
+
+		config.macro = config.infinity;
+		if (config.valid()) {
+			cerr << "Empty focus interval was accepted" << endl;
+			return false;
+		}
+
+		if (AfStateMachine::scanPositions(242, 726, 48) !=
+		    vector<int32_t>{ 242, 290, 338, 386, 434, 482,
+				     530, 578, 626, 674, 722, 726 } ||
+		    !AfStateMachine::scanPositions(726, 242, 8).empty()) {
+			cerr << "Bounded endpoint generation is wrong" << endl;
+			return false;
+		}
+
+		return true;
+	}
+
+	bool testSuccess()
+	{
+		AfStateMachine machine;
+		if (machine.configure(configuration())) {
+			cerr << "Valid AF configuration failed" << endl;
+			return false;
+		}
+
+		machine.start();
+		machine.start();
+		const DriveResult result = drive(
+			machine, 2000,
+			[](int32_t position, uint32_t frame) {
+				return frameStats(position, frame);
+			});
+
+		if (machine.status() != AfStatus::Focused ||
+		    machine.failure() != AfFailure::None ||
+		    machine.bestPosition() != 538 ||
+		    machine.currentPosition() != 538 ||
+		    machine.metrics().size() != 22 ||
+		    result.commands.empty() || !allBounded(result.commands)) {
+			cerr << "Successful coarse/fine scan result is wrong" << endl;
+			return false;
+		}
+
+		return true;
+	}
+
+	bool testCancel()
+	{
+		AfStateMachine machine;
+		machine.configure(configuration());
+		machine.start();
+
+		const optional<int32_t> command = machine.takeLensCommand(1);
+		if (!command || *command != 242) {
+			cerr << "Initial infinity command is missing" << endl;
+			return false;
+		}
+
+		machine.cancel();
+		if (machine.status() != AfStatus::Idle ||
+		    machine.takeLensCommand(2) ||
+		    !machine.setLensPositionResult(1, 242, 0) ||
+		    machine.currentPosition() != 242 ||
+		    machine.takeLensCommand(3)) {
+			cerr << "Cancel issued an unrelated movement" << endl;
+			return false;
+		}
+
+		return true;
+	}
+
+	bool testLensFailure()
+	{
+		AfStateMachine machine;
+		machine.configure(configuration());
+		machine.start();
+
+		const DriveResult result = drive(
+			machine, 1000,
+			[](int32_t position, uint32_t frame) {
+				return frameStats(position, frame);
+			},
+			[](int32_t position, const vector<int32_t> &) {
+				return position == 338 ? -EIO : 0;
+			});
+
+		if (machine.status() != AfStatus::Failed ||
+		    machine.failure() != AfFailure::Lens ||
+		    result.commands.size() < 2 ||
+		    result.commands.back() != 242 ||
+		    machine.currentPosition() != 242 ||
+		    !allBounded(result.commands)) {
+			cerr << "Lens failure did not fail safe at infinity" << endl;
+			return false;
+		}
+
+		return true;
+	}
+
+	bool testSceneFailures()
+	{
+		struct Case {
+			AfFailure expected;
+			StatsFactory factory;
+		};
+
+		const vector<Case> cases{
+			{
+				AfFailure::Incomplete,
+				[](int32_t position, uint32_t frame) {
+					AfFrameStats stats =
+						frameStats(position, frame);
+					if (stats.valid)
+						stats.complete = false;
+					return stats;
+				},
+			},
+			{
+				AfFailure::Dark,
+				[](int32_t position, uint32_t frame) {
+					AfFrameStats stats =
+						frameStats(position, frame);
+					stats.mean = 2.0;
+					return stats;
+				},
+			},
+			{
+				AfFailure::Clipped,
+				[](int32_t position, uint32_t frame) {
+					AfFrameStats stats =
+						frameStats(position, frame);
+					stats.clippedFraction = 0.5;
+					return stats;
+				},
+			},
+			{
+				AfFailure::Flat,
+				[](int32_t position, uint32_t frame) {
+					AfFrameStats stats =
+						frameStats(position, frame);
+					stats.score = 0.005;
+					return stats;
+				},
+			},
+		};
+
+		for (const Case &test : cases) {
+			AfStateMachine machine;
+			machine.configure(configuration());
+			machine.start();
+			const DriveResult result =
+				drive(machine, 1000, test.factory);
+			if (machine.status() != AfStatus::Failed ||
+			    machine.failure() != test.expected ||
+			    result.commands.empty() ||
+			    result.commands.back() != 242) {
+				cerr << "Scene rejection failed for "
+				     << afFailureName(test.expected) << endl;
+				return false;
+			}
+		}
+
+		return true;
+	}
+
+	bool testExposureFailures()
+	{
+		AfConfiguration config = configuration();
+		config.aeMinimumFrames = 12;
+		config.aeWindowFrames = 12;
+		config.aeMaximumFrames = 16;
+
+		AfStateMachine timeout;
+		timeout.configure(config);
+		timeout.start();
+		const DriveResult timeoutResult = drive(
+			timeout, 100,
+			[](int32_t position, uint32_t frame) {
+				return frameStats(position, frame,
+						  frame % 2 ? 1000.0 : 2000.0);
+			});
+		if (timeout.status() != AfStatus::Failed ||
+		    timeout.failure() != AfFailure::Timeout ||
+		    timeoutResult.commands.back() != 242) {
+			cerr << "AE convergence timeout was not rejected" << endl;
+			return false;
+		}
+
+		AfStateMachine drift;
+		drift.configure(configuration());
+		drift.start();
+		const DriveResult driftResult = drive(
+			drift, 1500,
+			[](int32_t position, uint32_t frame) {
+				const double exposure =
+					position == 242 ? 1000.0 : 1400.0;
+				return frameStats(position, frame, exposure);
+			});
+		if (drift.status() != AfStatus::Failed ||
+		    drift.failure() != AfFailure::Exposure ||
+		    driftResult.commands.back() != 242) {
+			cerr << "Whole-scan exposure drift was not rejected" << endl;
+			return false;
+		}
+
+		return true;
+	}
+
+	bool testProtocolFailure()
+	{
+		AfStateMachine machine;
+		machine.configure(configuration());
+		machine.start();
+		const optional<int32_t> command = machine.takeLensCommand(10);
+		if (!command ||
+		    machine.setLensPositionResult(11, *command, 0) ||
+		    machine.status() != AfStatus::Failed ||
+		    machine.failure() != AfFailure::Protocol) {
+			cerr << "Mismatched lens acknowledgement was accepted" << endl;
+			return false;
+		}
+
+		return true;
+	}
+};
+
+} /* namespace */
+
+TEST_REGISTER(SimpleIpaAfTest)
