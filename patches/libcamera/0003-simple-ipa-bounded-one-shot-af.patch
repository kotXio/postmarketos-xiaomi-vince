diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
new file mode 100644
index 00000000..c1735ab1
--- /dev/null
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -0,0 +1,317 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Kostiantyn Andriiuk
+ *
+ * Bounded one-shot autofocus for the Simple IPA
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <errno.h>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+namespace ipa::soft::algorithms {
+
+namespace {
+
+template<typename T>
+bool readRequired(const ValueNode &data, const char *name, T *value)
+{
+	const std::optional<T> parsed = data[name].get<T>();
+	if (!parsed)
+		return false;
+
+	*value = *parsed;
+	return true;
+}
+
+} /* namespace */
+
+int Af::validateLensControls(const ControlInfoMap &controls) const
+{
+	if (controls.empty())
+		return -ENODEV;
+
+	const auto it = controls.find(V4L2_CID_FOCUS_ABSOLUTE);
+	if (it == controls.end())
+		return -ENODEV;
+
+	const ControlInfo &info = it->second;
+	if (info.min().type() != ControlTypeInteger32 ||
+	    info.max().type() != ControlTypeInteger32 ||
+	    info.min().isArray() || info.max().isArray())
+		return -EINVAL;
+
+	const int32_t minimum = info.min().get<int32_t>();
+	const int32_t maximum = info.max().get<int32_t>();
+	if (minimum == maximum)
+		return -EACCES;
+	if (minimum > maximum)
+		return -EINVAL;
+	if (configuration_.infinity < minimum ||
+	    configuration_.macro > maximum)
+		return -ERANGE;
+
+	return 0;
+}
+
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+	if (!tuningData.isDictionary()) {
+		LOG(IPASoftAf, Error) << "Af tuning data must be a dictionary";
+		return -EINVAL;
+	}
+
+	bool valid =
+		readRequired(tuningData, "infinity", &configuration_.infinity) &&
+		readRequired(tuningData, "macro", &configuration_.macro) &&
+		readRequired(tuningData, "coarseStep", &configuration_.coarseStep) &&
+		readRequired(tuningData, "fineStep", &configuration_.fineStep) &&
+		readRequired(tuningData, "settleFrames", &configuration_.settleFrames) &&
+		readRequired(tuningData, "metricFrames", &configuration_.metricFrames) &&
+		readRequired(tuningData, "aeMinimumFrames",
+			     &configuration_.aeMinimumFrames) &&
+		readRequired(tuningData, "aeWindowFrames",
+			     &configuration_.aeWindowFrames) &&
+		readRequired(tuningData, "aeMaximumFrames",
+			     &configuration_.aeMaximumFrames) &&
+		readRequired(tuningData, "maximumMetricFrames",
+			     &configuration_.maximumMetricFrames) &&
+		readRequired(tuningData, "aeMaximumRatio",
+			     &configuration_.aeMaximumRatio) &&
+		readRequired(tuningData, "maximumExposureRatio",
+			     &configuration_.maximumExposureRatio) &&
+		readRequired(tuningData, "minimumFocusSpread",
+			     &configuration_.minimumFocusSpread) &&
+		readRequired(tuningData, "minimumMean",
+			     &configuration_.minimumMean) &&
+		readRequired(tuningData, "maximumMean",
+			     &configuration_.maximumMean) &&
+		readRequired(tuningData, "maximumClippedFraction",
+			     &configuration_.maximumClippedFraction) &&
+		readRequired(tuningData, "minimumScore",
+			     &configuration_.minimumScore) &&
+		readRequired(tuningData, "confirmationMinimumRatio",
+			     &configuration_.confirmationMinimumRatio) &&
+		readRequired(tuningData, "confirmationMaximumRatio",
+			     &configuration_.confirmationMaximumRatio);
+
+	if (!valid || !configuration_.valid()) {
+		LOG(IPASoftAf, Error)
+			<< "Af tuning data is missing a required value or is invalid";
+		return -EINVAL;
+	}
+
+	int ret = context.lensControls
+			  ? validateLensControls(*context.lensControls)
+			  : -ENODEV;
+	if (ret) {
+		LOG(IPASoftAf, Warning)
+			<< "Af tuning is present but no compatible writable lens "
+			   "is linked: "
+			<< ret;
+		return 0;
+	}
+
+	ret = stateMachine_.configure(configuration_);
+	if (ret)
+		return ret;
+
+	const std::array<ControlValue, 1> modes{ controls::AfModeAuto };
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(Span<const ControlValue>{ modes },
+			    controls::AfModeAuto);
+	context.ctrlMap[&controls::AfTrigger] =
+		ControlInfo(controls::AfTriggerValues);
+
+	available_ = true;
+	LOG(IPASoftAf, Info)
+		<< "Enabled handset-local one-shot AF over raw lens interval "
+		<< configuration_.infinity << "-" << configuration_.macro;
+	return 0;
+}
+
+int Af::configure([[maybe_unused]] IPAContext &context,
+		  const IPAConfigInfo &configInfo)
+{
+	loggedMetrics_ = 0;
+	loggedStatus_ = AfStatus::Idle;
+	loggedFailure_ = AfFailure::None;
+
+	if (!available_)
+		return 0;
+
+	int ret = validateLensControls(configInfo.lensControls);
+	if (ret) {
+		LOG(IPASoftAf, Error)
+			<< "Linked lens controls changed after AF initialization: "
+			<< ret;
+		return ret;
+	}
+
+	ret = stateMachine_.configure(configuration_);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+void Af::queueRequest([[maybe_unused]] IPAContext &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!available_)
+		return;
+
+	const std::optional<int32_t> mode = controls.get(controls::AfMode);
+	if (mode && *mode != controls::AfModeAuto) {
+		LOG(IPASoftAf, Warning)
+			<< "Ignoring unsupported AF mode " << *mode;
+	}
+
+	const std::optional<int32_t> trigger = controls.get(controls::AfTrigger);
+	if (trigger) {
+		if (*trigger == controls::AfTriggerStart)
+			stateMachine_.start();
+		else if (*trigger == controls::AfTriggerCancel)
+			stateMachine_.cancel();
+	}
+}
+
+int32_t Af::metadataState() const
+{
+	switch (stateMachine_.status()) {
+	case AfStatus::Idle:
+		return controls::AfStateIdle;
+	case AfStatus::Scanning:
+		return controls::AfStateScanning;
+	case AfStatus::Focused:
+		return controls::AfStateFocused;
+	case AfStatus::Failed:
+		return controls::AfStateFailed;
+	}
+
+	return controls::AfStateFailed;
+}
+
+void Af::process([[maybe_unused]] IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	if (!available_)
+		return;
+
+	AfFrameStats afStats;
+	afStats.valid = stats->valid;
+	afStats.exposure = frameContext.sensor.appliedExposure;
+	afStats.gain = frameContext.sensor.appliedGain;
+	afStats.exposureProduct =
+		static_cast<double>(afStats.exposure) * afStats.gain;
+
+	if (stats->valid && stats->focusGradientSamples &&
+	    stats->focusGreenSamples &&
+	    stats->focusClippedSamples <= stats->focusGreenSamples) {
+		const double gradient =
+			std::sqrt(static_cast<double>(stats->focusGradientSum) /
+				  stats->focusGradientSamples);
+		const double mean =
+			static_cast<double>(stats->focusGreenSum) /
+			stats->focusGreenSamples;
+
+		afStats.complete = true;
+		afStats.mean = mean;
+		afStats.score = gradient / std::max(mean, 1.0);
+		afStats.clippedFraction =
+			static_cast<double>(stats->focusClippedSamples) /
+			stats->focusGreenSamples;
+	}
+
+	stateMachine_.process(afStats);
+
+	if (stateMachine_.metrics().size() > loggedMetrics_) {
+		const AfPositionMetric &metric = stateMachine_.metrics().back();
+		LOG(IPASoftAf, Debug)
+			<< "AF metric position=" << metric.position
+			<< " score=" << metric.score
+			<< " mean=" << metric.mean
+			<< " clipped=" << metric.clippedFraction
+			<< " exposure=" << metric.exposureProduct;
+		loggedMetrics_ = stateMachine_.metrics().size();
+	}
+
+	if (stateMachine_.status() != loggedStatus_ ||
+	    stateMachine_.failure() != loggedFailure_) {
+		LOG(IPASoftAf, Info)
+			<< "AF state=" << metadataState()
+			<< " failure="
+			<< afFailureName(stateMachine_.failure());
+		loggedStatus_ = stateMachine_.status();
+		loggedFailure_ = stateMachine_.failure();
+	}
+
+	metadata.set(controls::AfMode, controls::AfModeAuto);
+	metadata.set(controls::AfState, metadataState());
+}
+
+std::optional<int32_t> Af::takeLensCommand(uint32_t frame)
+{
+	const std::optional<int32_t> position =
+		stateMachine_.takeLensCommand(frame);
+	if (position) {
+		LOG(IPASoftAf, Debug)
+			<< "Requesting raw lens position " << *position
+			<< " from AF decision frame " << frame;
+	}
+	return position;
+}
+
+void Af::setLensPositionResult(uint32_t frame, int32_t position,
+			       int32_t result)
+{
+	if (!available_)
+		return;
+
+	if (!stateMachine_.setLensPositionResult(frame, position, result)) {
+		LOG(IPASoftAf, Error)
+			<< "Unexpected raw lens result for frame " << frame
+			<< " at position " << position;
+	} else if (result) {
+		LOG(IPASoftAf, Error)
+			<< "Raw lens command for frame " << frame
+			<< " at position " << position
+			<< " failed: " << result;
+	} else {
+		LOG(IPASoftAf, Debug)
+			<< "Raw lens command for frame " << frame
+			<< " applied at position " << position;
+	}
+}
+
+void Af::resetSession()
+{
+	stateMachine_.reset();
+	loggedMetrics_ = 0;
+	loggedStatus_ = AfStatus::Idle;
+	loggedFailure_ = AfFailure::None;
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
