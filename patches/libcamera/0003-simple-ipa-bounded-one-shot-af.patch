+	double minimumFocusSpread = 0.0;
+	double minimumMean = 0.0;
+	double maximumMean = 0.0;
+	double maximumClippedFraction = 0.0;
+	double minimumScore = 0.0;
+	double confirmationMinimumRatio = 0.0;
+	double confirmationMaximumRatio = 0.0;
+
+	bool valid() const;
+};
+
+struct AfFrameStats {
+	bool valid = false;
+	bool complete = false;
+	double score = 0.0;
+	double mean = 0.0;
+	double clippedFraction = 0.0;
+	double exposureProduct = 0.0;
+	int32_t exposure = 0;
+	double gain = 0.0;
+};
+
+struct AfPositionMetric {
+	int32_t position = 0;
+	double score = 0.0;
+	double mean = 0.0;
+	double clippedFraction = 0.0;
+	double exposureProduct = 0.0;
+};
+
+enum class AfStatus {
+	Idle,
+	Scanning,
+	Focused,
+	Failed,
+};
+
+enum class AfFailure {
+	None,
+	Incomplete,
+	Dark,
+	Clipped,
+	Flat,
+	Exposure,
+	Lens,
+	Timeout,
+	Confirmation,
+	Protocol,
+};
+
+const char *afFailureName(AfFailure failure);
+
+class AfStateMachine
+{
+public:
+	AfStateMachine() = default;
+
+	int configure(const AfConfiguration &configuration);
+	void reset();
+
+	void start();
+	void cancel();
+	void process(const AfFrameStats &stats);
+
+	std::optional<int32_t> takeLensCommand(uint32_t frame);
+	bool setLensPositionResult(uint32_t frame, int32_t position, int32_t result);
+
+	AfStatus status() const { return status_; }
+	AfFailure failure() const { return failure_; }
+	std::optional<int32_t> currentPosition() const { return currentPosition_; }
+	std::optional<int32_t> bestPosition() const { return bestPosition_; }
+	const std::vector<AfPositionMetric> &metrics() const { return metrics_; }
+
+	static std::vector<int32_t> scanPositions(int32_t first, int32_t last,
+						  int32_t step);
+
+private:
+	enum class Phase {
+		Idle,
+		WaitLens,
+		Settle,
+		SettleAe,
+		Collect,
+		Confirm,
+		RestartWait,
+		Terminal,
+	};
+
+	enum class LensRole {
+		Initial,
+		Scan,
+		Winner,
+		Safe,
+	};
+
+	enum class ScanStage {
+		Coarse,
+		Fine,
+	};
+
+	struct LensRequest {
+		uint32_t frame;
+		int32_t position;
+		LensRole role;
+	};
+
+	void beginScan();
+	void requestLens(int32_t position, LensRole role);
+	void enterSettling(Phase next);
+	void startCoarseScan();
+	void finishPosition();
+	void finishScanStage();
+	void startWinnerConfirmation();
+	void finishConfirmation();
+	void fail(AfFailure failure);
+
+	AfFailure validateFrame(const AfFrameStats &stats) const;
+	AfFailure validateCurve(const std::vector<AfPositionMetric> &metrics) const;
+	AfPositionMetric aggregatePosition(int32_t position) const;
+
+	AfConfiguration configuration_;
+	bool configured_ = false;
+	AfStatus status_ = AfStatus::Idle;
+	AfFailure failure_ = AfFailure::None;
+	Phase phase_ = Phase::Idle;
+	Phase phaseAfterSettle_ = Phase::Idle;
+	ScanStage scanStage_ = ScanStage::Coarse;
+
+	std::optional<LensRequest> command_;
+	std::optional<LensRequest> pending_;
+	uint32_t nextCommandFrame_ = 0;
+	bool restartAfterPending_ = false;
+	bool cancelledPending_ = false;
+
+	std::optional<int32_t> currentPosition_;
+	std::optional<int32_t> bestPosition_;
+	double bestScore_ = 0.0;
+
+	unsigned int settleFramesRemaining_ = 0;
+	unsigned int aeFrames_ = 0;
+	unsigned int metricFrames_ = 0;
+	std::vector<double> aeHistory_;
+	std::vector<double> scores_;
+	std::vector<double> means_;
+	std::vector<double> clippedFractions_;
+	std::vector<double> exposures_;
+
+	std::vector<int32_t> activePositions_;
+	std::size_t activePosition_ = 0;
+	std::vector<AfPositionMetric> metrics_;
+
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
