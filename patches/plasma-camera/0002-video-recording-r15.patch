@@ -107,8 +107,126 @@ void Worker::unsetCamera()
 
 void Worker::capture()
 {
-    m_stillCaptureFrames.clear();
+    if (m_state != State::Running || m_mode != CaptureMode::ViewFinder
+        || !m_stillCapturePolicy.beginCapture()) {
+        qWarning() << "Ignoring still capture while camera is not ready";
+        return;
+    }
+
+    {
+        const QMutexLocker lock(&m_stillCaptureFramesMutex);
+        m_stillCaptureFrames.clear();
+    }
+
     setMode(CaptureMode::StillImage);
+    qInfo() << "Starting full-resolution still capture";
+
+    if (!stopStream() || !startStream(libcamera::StreamRole::StillCapture, false)) {
+        m_stillCapturePolicy.reset();
+        setMode(CaptureMode::None);
+        return;
+    }
+}
+
+void Worker::prepareVideoRecording(const QSize &outputSize)
+{
+    if (m_state != State::Running || m_mode != CaptureMode::ViewFinder) {
+        qWarning() << "Ignoring video stream preparation while camera is not ready";
+        Q_EMIT videoRecordingStreamFailed();
+        return;
+    }
+
+    const std::optional<VideoStreamPolicy::Size> requested =
+        m_videoStreamPolicy.beginRecording({
+            static_cast<unsigned int>(outputSize.width()),
+            static_cast<unsigned int>(outputSize.height()),
+        });
+    if (!requested) {
+        qWarning() << "No proved native video source for output" << outputSize;
+        Q_EMIT videoRecordingStreamFailed();
+        return;
+    }
+
+    const QSize sourceSize{
+        static_cast<int>(requested->width),
+        static_cast<int>(requested->height),
+    };
+    qInfo() << "Preparing processed video stream for output" << outputSize
+            << "with requested source" << sourceSize;
+
+    setMode(CaptureMode::None);
+    if (!stopStream() || !startStream(libcamera::StreamRole::Viewfinder, false, sourceSize)) {
+        m_videoStreamPolicy.reset();
+        Q_EMIT videoRecordingStreamFailed();
+        return;
+    }
+
+    if (!m_videoStreamPolicy.recordingStreamReady()) {
+        setError(QStringLiteral("Video stream policy rejected recording readiness"));
+        m_videoStreamPolicy.reset();
+        Q_EMIT videoRecordingStreamFailed();
+        return;
+    }
+
+    setMode(CaptureMode::Video);
+    qInfo() << "Processed video stream ready at" << m_size;
+    Q_EMIT videoRecordingStreamReady(m_size);
+}
+
+void Worker::restoreViewFinderAfterVideo()
+{
+    if (m_state != State::Running || m_mode != CaptureMode::Video) {
+        qWarning() << "Ignoring preview restore outside video mode";
+        Q_EMIT viewFinderRestoreAfterVideoFailed();
+        return;
+    }
+
+    const std::optional<VideoStreamPolicy::Size> requested = m_videoStreamPolicy.beginRestore();
+    if (!requested) {
+        qWarning() << "Video stream policy rejected preview restore";
+        Q_EMIT viewFinderRestoreAfterVideoFailed();
+        return;
+    }
+
+    const QSize previewSize{
+        static_cast<int>(requested->width),
+        static_cast<int>(requested->height),
+    };
+    qInfo() << "Restoring processed preview stream at" << previewSize
+            << "without autofocus retrigger";
+
+    setMode(CaptureMode::None);
+    if (!stopStream() || !startStream(libcamera::StreamRole::Viewfinder, false, previewSize)) {
+        m_videoStreamPolicy.reset();
+        Q_EMIT viewFinderRestoreAfterVideoFailed();
+        return;
+    }
+
+    if (!m_videoStreamPolicy.previewStreamReady()) {
+        setError(QStringLiteral("Video stream policy rejected preview readiness"));
+        m_videoStreamPolicy.reset();
+        Q_EMIT viewFinderRestoreAfterVideoFailed();
+        return;
+    }
+
+    setMode(CaptureMode::ViewFinder);
+    qInfo() << "Processed preview stream restored at" << m_size;
+    Q_EMIT viewFinderRestoredAfterVideo(m_size);
