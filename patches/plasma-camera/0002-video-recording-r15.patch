diff --git a/src/tests/stillcapturepolicytest.cpp b/src/tests/stillcapturepolicytest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6094fbb3a2550db9dccb0ec3ec3d43012ab96c2b
--- /dev/null
+++ b/src/tests/stillcapturepolicytest.cpp
@@ -0,0 +1,70 @@
+// SPDX-FileCopyrightText: 2026 Kostiantyn Andriiuk
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <iostream>
+
+#include "src/plasmacamera/stillcapturepolicy.h"
+
+namespace
+{
+
+bool testPreviewLimit()
+{
+    if (StillCapturePolicy::maximumViewfinderWidth() != 952
+        || StillCapturePolicy::maximumViewfinderHeight() != 540) {
+        std::cerr << "Unexpected viewfinder limit\n";
+        return false;
+    }
+
+    return true;
+}
+
+bool testSingleCaptureCycle()
+{
+    StillCapturePolicy policy;
+    if (policy.captureInProgress() || !policy.beginCapture() || policy.beginCapture()) {
+        std::cerr << "Capture cycle did not start exactly once\n";
+        return false;
+    }
+
+    for (unsigned int frame = 0; frame < 4; ++frame) {
+        if (policy.consumeStillFrame() != StillCapturePolicy::FrameDecision::Skip) {
+            std::cerr << "Warm-up frame was not skipped\n";
+            return false;
+        }
+    }
+
+    if (policy.consumeStillFrame() != StillCapturePolicy::FrameDecision::CaptureAndRestore
+        || !policy.captureInProgress()
+        || policy.consumeStillFrame() != StillCapturePolicy::FrameDecision::Ignore
+        || policy.beginCapture()) {
+        std::cerr << "Fifth frame did not transition to restore exactly once\n";
+        return false;
+    }
+
+    policy.viewfinderRestored();
+    if (policy.captureInProgress() || !policy.beginCapture()) {
+        std::cerr << "A restored viewfinder did not accept the next capture\n";
+        return false;
+    }
+
+    policy.reset();
+    if (policy.captureInProgress()
+        || policy.consumeStillFrame() != StillCapturePolicy::FrameDecision::Ignore) {
+        std::cerr << "Reset did not cancel capture state\n";
+        return false;
+    }
+
+    return true;
+}
+
+}
+
+int main()
+{
+    if (!testPreviewLimit() || !testSingleCaptureCycle()) {
+        return 1;
+    }
+
+    return 0;
+}
diff --git a/src/tests/videoframesubmissionpolicytest.cpp b/src/tests/videoframesubmissionpolicytest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a2d967e6f8cba53af97ec9fd73f82065ad6d9116
--- /dev/null
+++ b/src/tests/videoframesubmissionpolicytest.cpp
@@ -0,0 +1,194 @@
+// SPDX-FileCopyrightText: 2026 Kostiantyn Andriiuk
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <cstddef>
+#include <cstdint>
+#include <iostream>
+
+#include "src/plasmacamera/videoframesubmissionpolicy.h"
+
+namespace
+{
+
+bool testPreviewPresentationState()
+{
+    VideoFrameSubmissionPolicy policy;
+    if (!policy.shouldPresentPreview()) {
+        std::cerr << "Idle preview presentation was suppressed\n";
+        return false;
+    }
+
+    policy.startSession(30.0);
+    constexpr bool expectedPresentation[] = {
+        true,
+        false,
+        false,
+        false,
+        false,
+        false,
+        true,
+        false,
+        false,
+        false,
+        false,
+        false,
+        true,
+    };
+    for (std::size_t index = 0;
+         index < sizeof(expectedPresentation) / sizeof(expectedPresentation[0]);
+         ++index) {
+        if (policy.shouldPresentPreview() != expectedPresentation[index]) {
+            std::cerr << "Recording preview cadence mismatch at frame " << index
+                      << '\n';
+            return false;
+        }
+    }
+
+    policy.stopSession();
+    if (!policy.shouldPresentPreview()) {
+        std::cerr << "Preview presentation was not restored after recording\n";
+        return false;
+    }
+
+    policy.startSession(30.0);
+    if (!policy.shouldPresentPreview() || policy.shouldPresentPreview()) {
+        std::cerr << "Recording preview cadence did not reset for a new session\n";
+        return false;
+    }
+    policy.stopSession();
+
+    return true;
+}
+
+bool testUniqueFramesAndBackpressure()
+{
+    VideoFrameSubmissionPolicy policy;
+    policy.startSession(24.0);
+
+    if (!policy.offerFrame(1, 1'000'000)) {
+        std::cerr << "First camera frame was not accepted\n";
+        return false;
+    }
+
+    const auto first = policy.pendingFrame();
+    if (!first || first->sequence != 1 || first->startTimeUs != 0
+        || first->endTimeUs != 41'666) {
+        std::cerr << "First frame timing is not session-relative\n";
+        return false;
+    }
+
+    policy.frameSubmitted();
+    if (policy.pendingFrame()) {
+        std::cerr << "A submitted frame could be sent twice\n";
+        return false;
+    }
+    if (policy.offerFrame(1, 1'000'000)) {
+        std::cerr << "A submitted source-frame sequence was accepted twice\n";
+        return false;
+    }
+
+    if (!policy.offerFrame(2, 1'033'000)) {
+        std::cerr << "Second unique camera frame was not accepted\n";
+        return false;
+    }
+
+    const auto second = policy.pendingFrame();
+    if (!second || second->sequence != 2 || second->startTimeUs != 33'000
+        || second->endTimeUs != 74'666) {
+        std::cerr << "Second frame did not retain capture cadence\n";
+        return false;
+    }
+
+    // Simulate a full recorder queue: do not acknowledge frame 2. A readiness
+    // callback must expose the same pending frame, not invent a duplicate.
+    const auto retry = policy.pendingFrame();
+    if (!retry || retry->sequence != 2 || retry->startTimeUs != second->startTimeUs) {
+        std::cerr << "Backpressure retry changed the pending frame\n";
+        return false;
+    }
+
+    if (!policy.offerFrame(3, 1'066'000)) {
+        std::cerr << "Latest camera frame did not replace a blocked frame\n";
+        return false;
+    }
+
+    const auto replacement = policy.pendingFrame();
+    if (!replacement || replacement->sequence != 3
+        || replacement->startTimeUs != 66'000) {
+        std::cerr << "Backpressure did not retain only the latest unique frame\n";
+        return false;
+    }
+
+    policy.frameSubmitted();
+    if (policy.pendingFrame()) {
+        std::cerr << "Replacement frame remained pending after submission\n";
+        return false;
+    }
+
+    if (!policy.offerFrame(4, 1'100'000)) {
+        std::cerr << "Frame after backpressure recovery was not accepted\n";
+        return false;
+    }
+
+    const auto recovered = policy.pendingFrame();
+    if (!recovered || recovered->sequence != 4
+        || recovered->startTimeUs != 100'000) {
+        std::cerr << "Dropped pending frame incorrectly changed the timestamp epoch\n";
+        return false;
+    }
+
+    return true;
+}
+
+bool testPerSessionTimestamps()
+{
+    VideoFrameSubmissionPolicy policy;
+    policy.startSession(30.0);
+    policy.offerFrame(10, 8'000'000);
+    const auto firstSession = policy.pendingFrame();
+    if (!firstSession || firstSession->startTimeUs != 0
+        || firstSession->endTimeUs != 33'332) {
+        std::cerr << "First session did not start at zero\n";
+        return false;
+    }
+    policy.frameSubmitted();
+    policy.stopSession();
+
+    if (policy.offerFrame(11, 8'100'000) || policy.pendingFrame()) {
+        std::cerr << "Stopped recording accepted a camera frame\n";
+        return false;
+    }
+
+    policy.startSession(30.0);
+    policy.offerFrame(20, 20'000'000);
+    const auto secondSession = policy.pendingFrame();
+    if (!secondSession || secondSession->sequence != 20
+        || secondSession->startTimeUs != 0
+        || secondSession->endTimeUs != 33'332) {
+        std::cerr << "Second recording leaked the prior timestamp epoch\n";
+        return false;
+    }
+
+    policy.frameSubmitted();
+    policy.offerFrame(21, 20'000'000);
+    const auto equalArrival = policy.pendingFrame();
+    if (!equalArrival || equalArrival->startTimeUs != 1
+        || equalArrival->endTimeUs != 33'333) {
+        std::cerr << "Equal capture times were not made strictly monotonic\n";
+        return false;
+    }
+
+    return true;
+}
+
+}
+
+int main()
+{
+    if (!testPreviewPresentationState() || !testUniqueFramesAndBackpressure()
+        || !testPerSessionTimestamps()) {
+        return 1;
+    }
+
+    return 0;
+}
