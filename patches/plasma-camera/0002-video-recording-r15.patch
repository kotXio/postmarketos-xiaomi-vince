+// SPDX-FileCopyrightText: 2026 Kostiantyn Andriiuk
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <iostream>
+
+#include "src/plasmacamera/videostreampolicy.h"
+
+namespace
+{
+
+bool testSupportedSourceMapping()
+{
+    const VideoStreamPolicy::Size preview = VideoStreamPolicy::previewSize();
+    if (preview.width != 952 || preview.height != 540) {
+        std::cerr << "Accepted preview size changed\n";
+        return false;
+    }
+
+    const auto source720p = VideoStreamPolicy::sourceSizeForOutput({1280, 720});
+    if (!source720p || source720p->width != 1272 || source720p->height != 720) {
+        std::cerr << "720p was not mapped to the measured-safe recording request\n";
+        return false;
+    }
+
+    if (VideoStreamPolicy::sourceSizeForOutput({960, 540})
+        || VideoStreamPolicy::sourceSizeForOutput({1920, 1080})
+        || VideoStreamPolicy::sourceSizeForOutput({2560, 1440})
+        || VideoStreamPolicy::sourceSizeForOutput({3840, 2160})) {
+        std::cerr << "An unproved recording size entered the native path\n";
+        return false;
+    }
+
+    return true;
+}
+
+bool testRecordingAndRestoreCycle()
+{
+    VideoStreamPolicy policy;
+    if (policy.recording() || policy.transitionInProgress()) {
+        std::cerr << "Policy did not start in preview\n";
+        return false;
+    }
+
+    const auto requested = policy.beginRecording({1280, 720});
+    if (!requested || requested->width != 1272 || requested->height != 720
+        || policy.recording() || !policy.transitionInProgress()
+        || policy.beginRecording({1280, 720})) {
+        std::cerr << "720p preparation did not start exactly once\n";
+        return false;
+    }
+
+    if (!policy.recordingStreamReady() || !policy.recording()
+        || policy.transitionInProgress() || policy.recordingStreamReady()) {
+        std::cerr << "Recording stream readiness transition is invalid\n";
+        return false;
+    }
+
+    const auto restore = policy.beginRestore();
+    if (!restore || restore->width != 952 || restore->height != 540
+        || policy.recording() || !policy.transitionInProgress()
+        || policy.beginRestore()) {
+        std::cerr << "Preview restore did not start exactly once\n";
+        return false;
+    }
+
+    if (!policy.previewStreamReady() || policy.recording()
+        || policy.transitionInProgress() || policy.previewStreamReady()) {
+        std::cerr << "Preview readiness transition is invalid\n";
+        return false;
+    }
+
+    return true;
+}
+
+bool testUnsupportedAndReset()
+{
+    VideoStreamPolicy policy;
+    if (policy.beginRecording({1920, 1080}) || policy.transitionInProgress()) {
+        std::cerr << "Unproved 1080p source was accepted\n";
+        return false;
+    }
+
+    if (!policy.beginRecording({1280, 720})) {
+        std::cerr << "Supported recording did not begin\n";
+        return false;
+    }
+    policy.reset();
+    if (policy.recording() || policy.transitionInProgress()
+        || !policy.beginRecording({1280, 720})) {
+        std::cerr << "Reset did not return to preview\n";
+        return false;
+    }
+
+    return true;
+}
+
+}
+
+int main()
+{
+    if (!testSupportedSourceMapping() || !testRecordingAndRestoreCycle()
+        || !testUnsupportedAndReset()) {
+        return 1;
+    }
+
+    return 0;
+}
