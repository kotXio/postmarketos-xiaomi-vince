+bool PlasmaCamera::prepareVideoRecording(const QSize &outputSize)
+{
+    if (m_state != State::Running || m_busy || !outputSize.isValid()) {
+        return false;
+    }
+
+    setBusy(true);
+    QMetaObject::invokeMethod(
+        m_cameraWorker,
+        "prepareVideoRecording",
+        Qt::QueuedConnection,
+        Q_ARG(QSize, outputSize));
+    return true;
+}
+
+bool PlasmaCamera::restoreViewFinderAfterVideo()
+{
+    if (m_state != State::Running || m_busy) {
+        return false;
+    }
+
+    setBusy(true);
+    QMetaObject::invokeMethod(
+        m_cameraWorker,
+        "restoreViewFinderAfterVideo",
+        Qt::QueuedConnection);
+    return true;
+}
+
+bool PlasmaCamera::triggerAutofocus()
+{
+    if (m_state != State::Running || m_busy || !m_camera) {
+        return false;
+    }
+
+    const std::optional<int> location = m_camera->properties().get(libcamera::properties::Location);
+    const bool rearCamera = location && *location == libcamera::properties::CameraLocationBack;
+
+    OneShotAutofocusPolicy capability;
+    capability.beginSession(rearCamera, m_camera->controls());
+    if (!capability.supported()) {
+        return false;
+    }
+
+    QMetaObject::invokeMethod(m_cameraWorker, "triggerAutofocus", Qt::QueuedConnection);
+    return true;
+}
