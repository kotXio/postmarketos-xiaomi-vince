diff --git a/src/plasmacamera/stillcapturepolicy.h b/src/plasmacamera/stillcapturepolicy.h
new file mode 100644
index 0000000000000000000000000000000000000000..9acfc1db141fe8a1481fb1d73593a456e848630a
--- /dev/null
+++ b/src/plasmacamera/stillcapturepolicy.h
@@ -0,0 +1,81 @@
+// SPDX-FileCopyrightText: 2026 Kostiantyn Andriiuk
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+class StillCapturePolicy
+{
+public:
+    enum class FrameDecision {
+        Ignore,
+        Skip,
+        CaptureAndRestore,
+    };
+
+    static constexpr unsigned int maximumViewfinderWidth()
+    {
+        return 952;
+    }
+
+    static constexpr unsigned int maximumViewfinderHeight()
+    {
+        return 540;
+    }
+
+    bool beginCapture()
+    {
+        if (phase_ != Phase::Viewfinder) {
+            return false;
+        }
+
+        phase_ = Phase::StillCapture;
+        framesSeen_ = 0;
+        return true;
+    }
+
+    FrameDecision consumeStillFrame()
+    {
+        if (phase_ != Phase::StillCapture) {
+            return FrameDecision::Ignore;
+        }
+
+        ++framesSeen_;
+        if (framesSeen_ <= warmupFrames_) {
+            return FrameDecision::Skip;
+        }
+
+        phase_ = Phase::RestoringViewfinder;
+        return FrameDecision::CaptureAndRestore;
+    }
+
+    void viewfinderRestored()
+    {
+        if (phase_ == Phase::RestoringViewfinder) {
+            phase_ = Phase::Viewfinder;
+            framesSeen_ = 0;
+        }
+    }
+
+    void reset()
+    {
+        phase_ = Phase::Viewfinder;
+        framesSeen_ = 0;
+    }
+
+    bool captureInProgress() const
+    {
+        return phase_ != Phase::Viewfinder;
+    }
+
+private:
+    enum class Phase {
+        Viewfinder,
+        StillCapture,
+        RestoringViewfinder,
+    };
+
+    static constexpr unsigned int warmupFrames_ = 4;
+
+    Phase phase_ = Phase::Viewfinder;
+    unsigned int framesSeen_ = 0;
+};
diff --git a/src/plasmacamera/videoframesubmissionpolicy.h b/src/plasmacamera/videoframesubmissionpolicy.h
new file mode 100644
index 0000000000000000000000000000000000000000..6e372dd31a5812e54c87eb9cd0840e8670d890b2
--- /dev/null
+++ b/src/plasmacamera/videoframesubmissionpolicy.h
@@ -0,0 +1,114 @@
+// SPDX-FileCopyrightText: 2026 Kostiantyn Andriiuk
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+
+class VideoFrameSubmissionPolicy
+{
+public:
+    struct PendingFrame {
+        std::uint64_t sequence;
+        std::int64_t startTimeUs;
+        std::int64_t endTimeUs;
+    };
+
+    void startSession(double frameRate)
+    {
+        recording_ = true;
+        pending_ = false;
+        recordingPreviewFrameIndex_ = 0;
+        firstSubmittedCaptureTimeUs_.reset();
+        lastSubmittedSequence_.reset();
+        lastStartTimeUs_ = -1;
+        frameDurationUs_ = std::max<std::int64_t>(
+            1, std::llround(1'000'000.0 / std::max(frameRate, 1.0)));
+    }
+
+    void stopSession()
+    {
+        recording_ = false;
+        pending_ = false;
+        recordingPreviewFrameIndex_ = 0;
+    }
+
+    bool shouldPresentPreview()
+    {
+        if (!recording_) {
+            return true;
+        }
+
+        // Keep a usable recording preview without letting QML/KWin
+        // presentation compete with every frame submitted to the encoder.
+        const bool shouldPresent = recordingPreviewFrameIndex_ == 0;
+        recordingPreviewFrameIndex_ =
+            (recordingPreviewFrameIndex_ + 1) % recordingPreviewIntervalFrames_;
+        return shouldPresent;
+    }
+
+    bool offerFrame(std::uint64_t sequence, std::int64_t captureTimeUs)
+    {
+        if (!recording_
+            || (lastSubmittedSequence_ && sequence == *lastSubmittedSequence_)
+            || (pending_ && sequence == pendingSequence_)) {
+            return false;
+        }
+
+        pending_ = true;
+        pendingSequence_ = sequence;
+        pendingCaptureTimeUs_ = captureTimeUs;
+        return true;
+    }
+
+    std::optional<PendingFrame> pendingFrame() const
+    {
+        if (!recording_ || !pending_) {
+            return std::nullopt;
+        }
+
+        std::int64_t startTimeUs = 0;
+        if (firstSubmittedCaptureTimeUs_) {
+            startTimeUs = std::max(
+                pendingCaptureTimeUs_ - *firstSubmittedCaptureTimeUs_,
+                lastStartTimeUs_ + 1);
+        }
+
+        return PendingFrame{
+            pendingSequence_,
+            startTimeUs,
+            startTimeUs + frameDurationUs_ - 1,
+        };
+    }
+
+    void frameSubmitted()
+    {
+        const std::optional<PendingFrame> frame = pendingFrame();
+        if (!frame) {
+            return;
+        }
+
+        if (!firstSubmittedCaptureTimeUs_) {
+            firstSubmittedCaptureTimeUs_ = pendingCaptureTimeUs_;
+        }
+        lastSubmittedSequence_ = pendingSequence_;
+        lastStartTimeUs_ = frame->startTimeUs;
+        pending_ = false;
+    }
+
+private:
+    static constexpr std::uint64_t recordingPreviewIntervalFrames_ = 6;
+
+    bool recording_ = false;
+    bool pending_ = false;
+    std::uint64_t recordingPreviewFrameIndex_ = 0;
+    std::uint64_t pendingSequence_ = 0;
+    std::int64_t pendingCaptureTimeUs_ = 0;
+    std::int64_t frameDurationUs_ = 1;
+    std::int64_t lastStartTimeUs_ = -1;
+    std::optional<std::int64_t> firstSubmittedCaptureTimeUs_;
+    std::optional<std::uint64_t> lastSubmittedSequence_;
+};
diff --git a/src/plasmacamera/videostreampolicy.h b/src/plasmacamera/videostreampolicy.h
new file mode 100644
index 0000000000000000000000000000000000000000..fb91a4e8d60cdcb82f1d9b8e4fa60d049ca50fc4
--- /dev/null
+++ b/src/plasmacamera/videostreampolicy.h
@@ -0,0 +1,106 @@
+// SPDX-FileCopyrightText: 2026 Kostiantyn Andriiuk
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <optional>
+
+class VideoStreamPolicy
+{
+public:
+    struct Size {
+        unsigned int width = 0;
+        unsigned int height = 0;
+
+        constexpr bool operator==(const Size &) const = default;
+    };
+
+    static constexpr Size previewSize()
+    {
+        return {952, 540};
+    }
+
+    /*
+     * Only enable source modes already proved stable through the complete
+     * libcamera processed path. Higher encoder sizes retain the accepted
+     * scaled-preview fallback until their source path passes independently.
+     */
+    static constexpr std::optional<Size> sourceSizeForOutput(const Size output)
+    {
+        if (output == Size{1280, 720}) {
+            return Size{1272, 720};
+        }
+
+        return std::nullopt;
+    }
+
+    std::optional<Size> beginRecording(const Size output)
+    {
+        if (phase_ != Phase::Preview) {
+            return std::nullopt;
+        }
+
+        const std::optional<Size> source = sourceSizeForOutput(output);
+        if (!source) {
+            return std::nullopt;
+        }
+
+        phase_ = Phase::PreparingRecording;
+        return source;
+    }
+
+    bool recordingStreamReady()
+    {
+        if (phase_ != Phase::PreparingRecording) {
+            return false;
+        }
+
+        phase_ = Phase::Recording;
+        return true;
+    }
+
+    std::optional<Size> beginRestore()
+    {
+        if (phase_ != Phase::Recording) {
+            return std::nullopt;
+        }
+
+        phase_ = Phase::RestoringPreview;
+        return previewSize();
+    }
+
+    bool previewStreamReady()
+    {
+        if (phase_ != Phase::RestoringPreview) {
+            return false;
+        }
+
+        phase_ = Phase::Preview;
+        return true;
+    }
+
+    void reset()
+    {
+        phase_ = Phase::Preview;
+    }
+
+    bool recording() const
+    {
+        return phase_ == Phase::Recording;
+    }
+
+    bool transitionInProgress() const
+    {
+        return phase_ == Phase::PreparingRecording || phase_ == Phase::RestoringPreview;
+    }
+
+private:
+    enum class Phase {
+        Preview,
+        PreparingRecording,
+        Recording,
+        RestoringPreview,
+    };
+
+    Phase phase_ = Phase::Preview;
+};
diff --git a/src/plasmacamera/worker.cpp b/src/plasmacamera/worker.cpp
