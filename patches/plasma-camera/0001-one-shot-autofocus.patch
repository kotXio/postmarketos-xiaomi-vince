--- /dev/null
+++ b/src/tests/autofocuspolicytest.cpp
@@ -0,0 +1,143 @@
+// SPDX-FileCopyrightText: 2026 Kostiantyn Andriiuk
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <array>
+#include <cstdint>
+#include <iostream>
+#include <optional>
+#include <utility>
+
+#include <libcamera/control_ids.h>
+#include <libcamera/controls.h>
+
+#include "src/plasmacamera/autofocuspolicy.h"
+
+namespace
+{
+
+libcamera::ControlInfoMap controls(bool includeMode, int32_t mode,
+                                   bool includeTrigger, int32_t trigger)
+{
+    libcamera::ControlInfoMap::Map map;
+
+    if (includeMode) {
+        const std::array<libcamera::ControlValue, 1> values{ mode };
+        map.emplace(&libcamera::controls::AfMode,
+                    libcamera::ControlInfo(libcamera::Span<const libcamera::ControlValue>{ values }, mode));
+    }
+
+    if (includeTrigger) {
+        const std::array<libcamera::ControlValue, 1> values{ trigger };
+        map.emplace(&libcamera::controls::AfTrigger,
+                    libcamera::ControlInfo(libcamera::Span<const libcamera::ControlValue>{ values }, trigger));
+    }
+
+    return libcamera::ControlInfoMap(std::move(map), libcamera::controls::controls);
+}
+
+bool hasStartupControls(const libcamera::ControlList &requestControls)
+{
+    const std::optional<int32_t> mode = requestControls.get(libcamera::controls::AfMode);
+    const std::optional<int32_t> trigger = requestControls.get(libcamera::controls::AfTrigger);
+
+    return mode && *mode == libcamera::controls::AfModeAuto
+        && trigger && *trigger == libcamera::controls::AfTriggerStart;
+}
+
+bool testOneShot()
+{
+    StartupAutofocusPolicy policy;
+    const libcamera::ControlInfoMap available = controls(
+        true, libcamera::controls::AfModeAuto,
+        true, libcamera::controls::AfTriggerStart);
+
+    policy.beginSession(true, available);
+    if (!policy.supported() || !policy.pending()) {
+        std::cerr << "Rear Auto/Trigger session was not armed\n";
+        return false;
+    }
+
+    libcamera::ControlList first(libcamera::controls::controls);
+    if (!policy.apply(first) || !hasStartupControls(first) || policy.pending()) {
+        std::cerr << "First request did not consume the startup trigger\n";
+        return false;
+    }
+
+    libcamera::ControlList second(libcamera::controls::controls);
+    if (policy.apply(second) || !second.empty()) {
+        std::cerr << "Startup trigger was repeated\n";
+        return false;
+    }
+
+    policy.beginSession(true, available);
+    libcamera::ControlList nextSession(libcamera::controls::controls);
+    if (!policy.apply(nextSession) || !hasStartupControls(nextSession)) {
+        std::cerr << "A new rear session was not re-armed\n";
+        return false;
+    }
+
+    return true;
+}
+
+bool testCapabilityGates()
+{
+    const libcamera::ControlInfoMap available = controls(
+        true, libcamera::controls::AfModeAuto,
+        true, libcamera::controls::AfTriggerStart);
+    const libcamera::ControlInfoMap noMode = controls(
+        false, 0, true, libcamera::controls::AfTriggerStart);
+    const libcamera::ControlInfoMap manualOnly = controls(
+        true, libcamera::controls::AfModeManual,
+        true, libcamera::controls::AfTriggerStart);
+    const libcamera::ControlInfoMap noTrigger = controls(
+        true, libcamera::controls::AfModeAuto, false, 0);
+    const libcamera::ControlInfoMap cancelOnly = controls(
+        true, libcamera::controls::AfModeAuto,
+        true, libcamera::controls::AfTriggerCancel);
+
+    StartupAutofocusPolicy policy;
+    for (const auto &[rear, info] : {
+             std::pair{ false, &available },
+             std::pair{ true, &noMode },
+             std::pair{ true, &manualOnly },
+             std::pair{ true, &noTrigger },
+             std::pair{ true, &cancelOnly },
+         }) {
+        policy.beginSession(rear, *info);
+        libcamera::ControlList request(libcamera::controls::controls);
+        if (policy.supported() || policy.pending() || policy.apply(request)
+            || !request.empty()) {
+            std::cerr << "Unsupported/front session was armed\n";
+            return false;
+        }
+    }
+
+    policy.beginSession(true, available);
+    policy.beginSession(false, available);
+    libcamera::ControlList switched(libcamera::controls::controls);
+    if (policy.apply(switched)) {
+        std::cerr << "Rear pending trigger leaked into a front session\n";
+        return false;
+    }
+
+    policy.beginSession(true, available);
+    policy.endSession();
+    libcamera::ControlList stopped(libcamera::controls::controls);
+    if (policy.supported() || policy.pending() || policy.apply(stopped)) {
+        std::cerr << "Stopped session retained a pending trigger\n";
+        return false;
+    }
+
+    return true;
+}
+
+}
+
+int main()
+{
+    if (!testOneShot() || !testCapabilityGates()) {
+        return 1;
+    }
+
+    return 0;
+}
