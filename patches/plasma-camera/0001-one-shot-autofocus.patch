+void Worker::logAutofocusState(const libcamera::ControlList &metadata)
+{
+    const std::optional<int32_t> state = metadata.get(libcamera::controls::AfState);
+    if (!state || state == m_lastAutofocusState) {
+        return;
+    }
+
+    m_lastAutofocusState = state;
+    qInfo() << "Autofocus state:" << autofocusStateName(*state) << "(" << *state << ")";
+}
