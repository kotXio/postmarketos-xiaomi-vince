--- /dev/null
+++ b/src/plasmacamera/autofocuspolicy.h
@@ -0,0 +1,72 @@
+// SPDX-FileCopyrightText: 2026 Kostiantyn Andriiuk
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+#include <libcamera/control_ids.h>
+#include <libcamera/controls.h>
+
+class StartupAutofocusPolicy
+{
+public:
+    void beginSession(bool rearCamera, const libcamera::ControlInfoMap &controls)
+    {
+        supported_ = rearCamera
+            && supportsValue(controls, libcamera::controls::AfMode, libcamera::controls::AfModeAuto)
+            && supportsValue(controls, libcamera::controls::AfTrigger, libcamera::controls::AfTriggerStart);
+        pending_ = supported_;
+    }
+
+    void endSession()
+    {
+        supported_ = false;
+        pending_ = false;
+    }
+
+    bool apply(libcamera::ControlList &controls)
+    {
+        if (!pending_) {
+            return false;
+        }
+
+        controls.set(libcamera::controls::AfMode, libcamera::controls::AfModeAuto);
+        controls.set(libcamera::controls::AfTrigger, libcamera::controls::AfTriggerStart);
+        pending_ = false;
+        return true;
+    }
+
+    bool supported() const
+    {
+        return supported_;
+    }
+
+    bool pending() const
+    {
+        return pending_;
+    }
+
+private:
+    static bool supportsValue(const libcamera::ControlInfoMap &controls,
+                              const libcamera::Control<int32_t> &control,
+                              int32_t value)
+    {
+        const auto it = controls.find(&control);
+        if (it == controls.end()) {
+            return false;
+        }
+
+        const std::vector<libcamera::ControlValue> &values = it->second.values();
+        return std::any_of(values.begin(), values.end(), [value](const libcamera::ControlValue &candidate) {
+            return candidate.type() == libcamera::ControlTypeInteger32
+                && !candidate.isArray()
+                && candidate.get<int32_t>() == value;
+        });
+    }
+
+    bool supported_ = false;
+    bool pending_ = false;
+};
