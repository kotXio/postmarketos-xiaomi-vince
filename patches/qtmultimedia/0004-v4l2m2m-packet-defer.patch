diff --git a/src/plugins/multimedia/ffmpeg/recordingengine/qffmpegpacketutils.cpp b/src/plugins/multimedia/ffmpeg/recordingengine/qffmpegpacketutils.cpp
index 8b6e9f3..5d9f08a 100644
--- a/src/plugins/multimedia/ffmpeg/recordingengine/qffmpegpacketutils.cpp
+++ b/src/plugins/multimedia/ffmpeg/recordingengine/qffmpegpacketutils.cpp
@@ -9,11 +9,14 @@ QT_BEGIN_NAMESPACE
 
 namespace QFFmpeg {
 
-AVPacketUPtr detachAVPacketPayload(AVPacketUPtr packet)
+AVPacketUPtr V4L2M2MPacketPayloadDetacher::detach(AVPacketUPtr packet)
 {
     if (!packet || !packet->buf)
         return packet;
 
+    if (packet->size < 0)
+        return nullptr;
+
     AVPacketUPtr detached(av_packet_alloc());
     if (!detached || av_new_packet(detached.get(), packet->size) < 0)
         return nullptr;
@@ -24,6 +27,8 @@ AVPacketUPtr detachAVPacketPayload(AVPacketUPtr packet)
     if (av_packet_copy_props(detached.get(), packet.get()) < 0)
         return nullptr;
 
+    // Keep this V4L2-backed packet until the next packet has already been received and copied.
+    m_deferredPacket = std::move(packet);
     return detached;
 }
 
