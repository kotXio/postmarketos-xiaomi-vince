 namespace {
@@ -35,6 +36,51 @@ void markPacketPayloadReleased(void *opaque, uint8_t *data)
     av_free(data);
 }
 
+AVPacketUPtr makePacket(bool &payloadReleased, uint8_t firstPayloadByte, int64_t pts)
+{
+    constexpr int payloadSize = 8;
+    auto *data = static_cast<uint8_t *>(av_malloc(payloadSize + AV_INPUT_BUFFER_PADDING_SIZE));
+    if (!data)
+        return {};
+
+    for (int i = 0; i < payloadSize; ++i)
+        data[i] = static_cast<uint8_t>(firstPayloadByte + i);
+    std::memset(data + payloadSize, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+
+    AVBufferRef *buffer = av_buffer_create(data, payloadSize, markPacketPayloadReleased,
+                                           &payloadReleased, 0);
+    if (!buffer) {
+        av_free(data);
+        return {};
+    }
+
+    AVPacketUPtr packet(av_packet_alloc());
+    if (!packet) {
+        av_buffer_unref(&buffer);
+        return {};
+    }
+
+    packet->buf = buffer;
+    packet->data = buffer->data;
+    packet->size = payloadSize;
+    packet->pts = pts;
+    packet->dts = pts - 34;
+    packet->duration = 40;
+    packet->stream_index = 2;
+    packet->flags = AV_PKT_FLAG_KEY;
+    packet->pos = 55;
+    packet->time_base = AVRational{ 1, 30000 };
+
+    auto *sideData = av_packet_new_side_data(packet.get(), AV_PKT_DATA_NEW_EXTRADATA, 3);
+    if (!sideData)
+        return {};
+    sideData[0] = 0xaa;
+    sideData[1] = 0xbb;
+    sideData[2] = 0xcc;
+
+    return packet;
+}
+
 } // namespace
 
