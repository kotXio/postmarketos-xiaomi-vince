+void tst_QFFmpegVideoEncoderUtils::v4l2M2MPacketPayload_isDetached()
+{
+    constexpr int payloadSize = 8;
+    auto *data = static_cast<uint8_t *>(av_malloc(payloadSize + AV_INPUT_BUFFER_PADDING_SIZE));
+    QVERIFY(data);
+
+    for (int i = 0; i < payloadSize; ++i)
+        data[i] = static_cast<uint8_t>(i + 1);
+    std::memset(data + payloadSize, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+
+    bool sourcePayloadReleased = false;
+    AVBufferRef *buffer = av_buffer_create(data, payloadSize, markPacketPayloadReleased,
+                                           &sourcePayloadReleased, 0);
+    if (!buffer) {
+        av_free(data);
+        QFAIL("Could not allocate the source AVBufferRef");
+    }
+
+    AVPacketUPtr source(av_packet_alloc());
+    QVERIFY(source);
+    source->buf = buffer;
+    source->data = buffer->data;
+    source->size = payloadSize;
+    source->pts = 1234;
+    source->dts = 1200;
+    source->duration = 40;
+    source->stream_index = 2;
+    source->flags = AV_PKT_FLAG_KEY;
+    source->pos = 55;
+    source->time_base = AVRational{ 1, 30000 };
+
+    auto *sideData = av_packet_new_side_data(source.get(), AV_PKT_DATA_NEW_EXTRADATA, 3);
+    QVERIFY(sideData);
+    sideData[0] = 0xaa;
+    sideData[1] = 0xbb;
+    sideData[2] = 0xcc;
+
+    const uint8_t *sourceData = source->data;
+    auto detached = detachAVPacketPayload(std::move(source));
+
+    QVERIFY(detached);
+    QVERIFY2(sourcePayloadReleased,
+             "The source AVBufferRef is still retained after packet detachment");
+    QVERIFY(detached->data != sourceData);
+    QCOMPARE(detached->size, payloadSize);
+    for (int i = 0; i < payloadSize; ++i)
+        QCOMPARE(detached->data[i], static_cast<uint8_t>(i + 1));
+    QCOMPARE(detached->pts, int64_t(1234));
+    QCOMPARE(detached->dts, int64_t(1200));
+    QCOMPARE(detached->duration, int64_t(40));
+    QCOMPARE(detached->stream_index, 2);
+    QCOMPARE(detached->flags, AV_PKT_FLAG_KEY);
+    QCOMPARE(detached->pos, int64_t(55));
+    QCOMPARE(detached->time_base.num, 1);
+    QCOMPARE(detached->time_base.den, 30000);
+    QCOMPARE(detached->side_data_elems, 1);
+    QCOMPARE(detached->side_data[0].type, AV_PKT_DATA_NEW_EXTRADATA);
+    QCOMPARE(detached->side_data[0].size, size_t(3));
+    QCOMPARE(detached->side_data[0].data[0], uint8_t(0xaa));
+    QCOMPARE(detached->side_data[0].data[1], uint8_t(0xbb));
+    QCOMPARE(detached->side_data[0].data[2], uint8_t(0xcc));
+}
