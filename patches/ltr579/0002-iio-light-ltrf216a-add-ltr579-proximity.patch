From e8be4c5548a80bb5d861349e17609c2dc13228c9 Mon Sep 17 00:00:00 2001
From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Date: Fri, 18 Sep 2026 19:41:03 +0300
Subject: [PATCH 2/3] iio: light: ltrf216a: add LTR579 proximity support

LTR579 shares the LTRF216A ambient-light register family and adds an
11-bit proximity converter. Expose its raw proximity channel while
leaving thresholds and interrupt handling disabled for polling tests.

Signed-off-by: Kostiantyn Andriiuk <konstantin@andriyuk.com>
---
 drivers/iio/light/ltrf216a.c | 94 +++++++++++++++++++++++++++++++-----
 1 file changed, 83 insertions(+), 11 deletions(-)

diff --git a/drivers/iio/light/ltrf216a.c b/drivers/iio/light/ltrf216a.c
index 5f27f754fe1c..e183e0034715 100644
--- a/drivers/iio/light/ltrf216a.c
+++ b/drivers/iio/light/ltrf216a.c
@@ -31,11 +31,15 @@
 #define LTRF216A_ALS_RESET_MASK		BIT(4)
 #define LTRF216A_ALS_DATA_STATUS	BIT(3)
 #define LTRF216A_ALS_ENABLE_MASK	BIT(1)
+#define LTR579_PS_DATA_STATUS		BIT(0)
+#define LTR579_PS_ENABLE_MASK		BIT(0)
 #define LTRF216A_MAIN_CTRL		0x00
 #define LTRF216A_ALS_MEAS_RES		0x04
 #define LTRF216A_ALS_GAIN		0x05
 #define LTRF216A_PART_ID		0x06
 #define LTRF216A_MAIN_STATUS		0x07
+#define LTR579_PS_DATA_0		0x08
+#define LTR579_PS_DATA_1		0x09
 #define LTRF216A_ALS_CLEAR_DATA_0	0x0a
 #define LTRF216A_ALS_CLEAR_DATA_1	0x0b
 #define LTRF216A_ALS_CLEAR_DATA_2	0x0c
@@ -69,6 +73,9 @@ static const int ltrf216a_int_time_reg[][2] = {
 };
 
 struct ltr_chip_info {
+	/* IIO device name */
+	const char	*name;
+	bool		has_proximity;
 	/* Chip contains CLEAR_DATA_0/1/2 registers at offset 0xa..0xc */
 	bool		has_clear_data;
 	/* Lux calculation multiplier for ALS data */
@@ -109,6 +116,22 @@ static const struct iio_chan_spec ltrf216a_channels[] = {
 	},
 };
 
+static const struct iio_chan_spec ltr579_channels[] = {
+	{
+		.type = IIO_LIGHT,
+		.info_mask_separate =
+			BIT(IIO_CHAN_INFO_RAW) |
+			BIT(IIO_CHAN_INFO_PROCESSED) |
+			BIT(IIO_CHAN_INFO_INT_TIME),
+		.info_mask_separate_available =
+			BIT(IIO_CHAN_INFO_INT_TIME),
+	},
+	{
+		.type = IIO_PROXIMITY,
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),
+	},
+};
+
 static void ltrf216a_reset(struct iio_dev *indio_dev)
 {
 	struct ltrf216a_data *data = iio_priv(indio_dev);
@@ -124,11 +147,15 @@ static int ltrf216a_enable(struct iio_dev *indio_dev)
 {
 	struct ltrf216a_data *data = iio_priv(indio_dev);
 	struct device *dev = &data->client->dev;
+	unsigned int enable_mask = LTRF216A_ALS_ENABLE_MASK;
 	int ret;
 
+	if (data->info->has_proximity)
+		enable_mask |= LTR579_PS_ENABLE_MASK;
+
 	/* enable sensor */
 	ret = regmap_set_bits(data->regmap,
-			      LTRF216A_MAIN_CTRL, LTRF216A_ALS_ENABLE_MASK);
+			      LTRF216A_MAIN_CTRL, enable_mask);
 	if (ret) {
 		dev_err(dev, "failed to enable sensor: %d\n", ret);
 		return ret;
@@ -214,14 +241,15 @@ static int ltrf216a_set_power_state(struct ltrf216a_data *data, bool on)
 	return ret;
 }
 
-static int ltrf216a_read_data(struct ltrf216a_data *data, u8 addr)
+static int ltrf216a_read_data(struct ltrf216a_data *data, u8 status_mask,
+			      u8 addr, size_t count)
 {
 	struct device *dev = &data->client->dev;
 	int ret, val;
-	u8 buf[3];
+	u8 buf[3] = {};
 
 	ret = regmap_read_poll_timeout(data->regmap, LTRF216A_MAIN_STATUS,
-				       val, val & LTRF216A_ALS_DATA_STATUS,
+				       val, val & status_mask,
 				       LTRF216A_ALS_READ_DATA_DELAY_US,
 				       LTRF216A_ALS_READ_DATA_DELAY_US * 50);
 	if (ret) {
@@ -229,12 +257,15 @@ static int ltrf216a_read_data(struct ltrf216a_data *data, u8 addr)
 		return ret;
 	}
 
-	ret = regmap_bulk_read(data->regmap, addr, buf, sizeof(buf));
+	ret = regmap_bulk_read(data->regmap, addr, buf, count);
 	if (ret) {
 		dev_err(dev, "failed to read measurement data: %d\n", ret);
 		return ret;
 	}
 
+	if (count == 2)
+		return get_unaligned_le16(buf) & GENMASK(10, 0);
+
 	return get_unaligned_le24(&buf[0]);
 }
 
@@ -247,7 +278,9 @@ static int ltrf216a_get_lux(struct ltrf216a_data *data)
 	if (ret)
 		return ret;
 
-	greendata = ltrf216a_read_data(data, LTRF216A_ALS_DATA_0);
+	greendata = ltrf216a_read_data(data, LTRF216A_ALS_DATA_STATUS,
+				       LTRF216A_ALS_DATA_0,
+				       3);
 	if (greendata < 0)
 		return greendata;
 
@@ -267,11 +300,20 @@ static int ltrf216a_read_raw(struct iio_dev *indio_dev,
 
 	switch (mask) {
 	case IIO_CHAN_INFO_RAW:
+		if (chan->type != IIO_LIGHT && chan->type != IIO_PROXIMITY)
+			return -EINVAL;
+
 		ret = ltrf216a_set_power_state(data, true);
 		if (ret)
 			return ret;
 		mutex_lock(&data->lock);
-		ret = ltrf216a_read_data(data, LTRF216A_ALS_DATA_0);
+		if (chan->type == IIO_PROXIMITY)
+			ret = ltrf216a_read_data(data, LTR579_PS_DATA_STATUS,
+						 LTR579_PS_DATA_0, 2);
+		else
+			ret = ltrf216a_read_data(data,
+						 LTRF216A_ALS_DATA_STATUS,
+						 LTRF216A_ALS_DATA_0, 3);
 		mutex_unlock(&data->lock);
 		ltrf216a_set_power_state(data, false);
 		if (ret < 0)
@@ -279,6 +321,8 @@ static int ltrf216a_read_raw(struct iio_dev *indio_dev,
 		*val = ret;
 		return IIO_VAL_INT;
 	case IIO_CHAN_INFO_PROCESSED:
+		if (chan->type != IIO_LIGHT)
+			return -EINVAL;
 		mutex_lock(&data->lock);
 		ret = ltrf216a_get_lux(data);
 		mutex_unlock(&data->lock);
@@ -288,6 +332,8 @@ static int ltrf216a_read_raw(struct iio_dev *indio_dev,
 		*val2 = data->als_gain_fac * data->int_time_fac;
 		return IIO_VAL_FRACTIONAL;
 	case IIO_CHAN_INFO_INT_TIME:
+		if (chan->type != IIO_LIGHT)
+			return -EINVAL;
 		mutex_lock(&data->lock);
 		ret = ltrf216a_get_int_time(data, val, val2);
 		mutex_unlock(&data->lock);
@@ -306,6 +352,8 @@ static int ltrf216a_write_raw(struct iio_dev *indio_dev,
 
 	switch (mask) {
 	case IIO_CHAN_INFO_INT_TIME:
+		if (chan->type != IIO_LIGHT)
+			return -EINVAL;
 		if (val != 0)
 			return -EINVAL;
 		mutex_lock(&data->lock);
@@ -324,6 +372,8 @@ static int ltrf216a_read_available(struct iio_dev *indio_dev,
 {
 	switch (mask) {
 	case IIO_CHAN_INFO_INT_TIME:
+		if (chan->type != IIO_LIGHT)
+			return -EINVAL;
 		*length = ARRAY_SIZE(ltrf216a_int_time_available) * 2;
 		*vals = (const int *)ltrf216a_int_time_available;
 		*type = IIO_VAL_INT_PLUS_MICRO;
@@ -366,6 +416,9 @@ static bool ltrf216a_readable_reg(struct device *dev, unsigned int reg)
 	case LTRF216A_ALS_CLEAR_DATA_1:
 	case LTRF216A_ALS_CLEAR_DATA_2:
 		return data->info->has_clear_data;
+	case LTR579_PS_DATA_0:
+	case LTR579_PS_DATA_1:
+		return data->info->has_proximity;
 	default:
 		return false;
 	}
@@ -410,6 +463,9 @@ static bool ltrf216a_volatile_reg(struct device *dev, unsigned int reg)
 	case LTRF216A_ALS_CLEAR_DATA_1:
 	case LTRF216A_ALS_CLEAR_DATA_2:
 		return data->info->has_clear_data;
+	case LTR579_PS_DATA_0:
+	case LTR579_PS_DATA_1:
+		return data->info->has_proximity;
 	default:
 		return false;
 	}
@@ -457,9 +513,14 @@ static int ltrf216a_probe(struct i2c_client *client)
 	mutex_init(&data->lock);
 
 	indio_dev->info = &ltrf216a_info;
-	indio_dev->name = "ltrf216a";
-	indio_dev->channels = ltrf216a_channels;
-	indio_dev->num_channels = ARRAY_SIZE(ltrf216a_channels);
+	indio_dev->name = data->info->name;
+	if (data->info->has_proximity) {
+		indio_dev->channels = ltr579_channels;
+		indio_dev->num_channels = ARRAY_SIZE(ltr579_channels);
+	} else {
+		indio_dev->channels = ltrf216a_channels;
+		indio_dev->num_channels = ARRAY_SIZE(ltrf216a_channels);
+	}
 	indio_dev->modes = INDIO_DIRECT_MODE;
 
 	ret = pm_runtime_set_active(&client->dev);
@@ -541,18 +602,28 @@ static DEFINE_RUNTIME_DEV_PM_OPS(ltrf216a_pm_ops, ltrf216a_runtime_suspend,
 				 ltrf216a_runtime_resume, NULL);
 
 static const struct ltr_chip_info ltr308_chip_info = {
+	.name			= "ltrf216a",
 	.has_clear_data		= false,
 	.lux_multiplier		= 60,
 };
 
 static const struct ltr_chip_info ltrf216a_chip_info = {
+	.name			= "ltrf216a",
 	.has_clear_data		= true,
 	.lux_multiplier		= 45,
 };
 
+static const struct ltr_chip_info ltr579_chip_info = {
+	.name			= "ltr579",
+	.has_proximity		= true,
+	.has_clear_data		= false,
+	.lux_multiplier		= 45,
+};
+
 static const struct i2c_device_id ltrf216a_id[] = {
 	{ "ltr308", .driver_data = (kernel_ulong_t)&ltr308_chip_info },
 	{ "ltrf216a", .driver_data = (kernel_ulong_t)&ltrf216a_chip_info },
+	{ "ltr579", .driver_data = (kernel_ulong_t)&ltr579_chip_info },
 	{ }
 };
 MODULE_DEVICE_TABLE(i2c, ltrf216a_id);
@@ -560,6 +631,7 @@ MODULE_DEVICE_TABLE(i2c, ltrf216a_id);
 static const struct of_device_id ltrf216a_of_match[] = {
 	{ .compatible = "liteon,ltr308", .data = &ltr308_chip_info },
 	{ .compatible = "liteon,ltrf216a", .data = &ltrf216a_chip_info },
+	{ .compatible = "liteon,ltr579", .data = &ltr579_chip_info },
 	/* For Valve's Steamdeck device, an ACPI platform using PRP0001 */
 	{ .compatible = "ltr,ltrf216a", .data = &ltrf216a_chip_info },
 	{ }
@@ -579,5 +651,5 @@ module_i2c_driver(ltrf216a_driver);
 
 MODULE_AUTHOR("Shreeya Patel <shreeya.patel@collabora.com>");
 MODULE_AUTHOR("Shi Zhigang <Zhigang.Shi@liteon.com>");
-MODULE_DESCRIPTION("LTRF216A ambient light sensor driver");
+MODULE_DESCRIPTION("LTRF216A ambient light and LTR579 proximity sensor driver");
 MODULE_LICENSE("GPL");
-- 
2.43.0

