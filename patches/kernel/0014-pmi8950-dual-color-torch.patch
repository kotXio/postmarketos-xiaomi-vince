From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Subject: [PATCH] leds: qcom: add PMI8950 dual-color torch for Vince

Add a small legacy-PMI8950 continuous-torch backend and expose the two
physical emitters as one standard Linux multicolor LED.  Xiaomi Redmi 5 Plus
opts into a tested 50 mA per-channel cap; photo flash and V4L2 strobe remain
out of scope.

Register definitions and protection sequencing are based on Qualcomm/Xiaomi's
GPLv2 QPNP flash driver and pinned PMI8950 Device Tree.  The user-facing ABI
uses the standard Linux multicolor LED class and matches Plasma Mobile's
*:torch discovery behavior.

Hardware references:
https://github.com/xiaomi-msm8953-devs/android_kernel_xiaomi_msm8953/blob/dcaf331bd84a5faf23b8641ff195e4833a5c47bc/drivers/leds/leds-qpnp-flash.c
https://android.googlesource.com/kernel/msm/+/f492c5d87df6daa7c010dd4d14a7f34da06d9757/arch/arm64/boot/dts/qcom/pmi8950.dtsi

Interface references:
https://docs.kernel.org/leds/leds-class-multicolor.html
https://github.com/KDE/plasma-mobile/blob/master/quicksettings/flashlight/flashlightutil.cpp

---
diff --git a/Documentation/devicetree/bindings/leds/qcom,pmi8950-flash-led.yaml b/Documentation/devicetree/bindings/leds/qcom,pmi8950-flash-led.yaml
new file mode 100644
index 000000000000..5c1eb893983e
--- /dev/null
+++ b/Documentation/devicetree/bindings/leds/qcom,pmi8950-flash-led.yaml
@@ -0,0 +1,55 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/qcom,pmi8950-flash-led.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm PMI8950 flash LED controller
+
+maintainers:
+  - Kostiantyn Andriiuk <konstantin@andriyuk.com>
+
+description: |
+  The Qualcomm PMI8950 contains a legacy two-channel flash LED controller.
+  Its register layout predates and differs from the three- and four-channel
+  controllers handled by qcom,spmi-flash-led.
+
+  The Linux driver exposes the two physical channels as one continuous white
+  multicolor-class torch. Their cool and warm intensities can be controlled
+  independently. Photo-flash and camera-triggered strobe are intentionally
+  not part of this binding.
+
+properties:
+  compatible:
+    const: qcom,pmi8950-flash-led
+
+  reg:
+    maxItems: 1
+
+  qcom,torch-max-microamp:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Hard continuous-current cap for each physical torch channel. The Vince
+      value is limited to 50 mA per channel after bounded hardware tests.
+    const: 50000
+
+required:
+  - compatible
+  - reg
+  - qcom,torch-max-microamp
+
+additionalProperties: false
+
+examples:
+  - |
+    pmic {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        led-controller@d300 {
+            compatible = "qcom,pmi8950-flash-led";
+            reg = <0xd300>;
+            qcom,torch-max-microamp = <50000>;
+        };
+    };
+...
diff --git a/arch/arm64/boot/dts/qcom/msm8953-xiaomi-vince.dts b/arch/arm64/boot/dts/qcom/msm8953-xiaomi-vince.dts
index 1b3ea96262d3..fc35daa4b0c8 100644
--- a/arch/arm64/boot/dts/qcom/msm8953-xiaomi-vince.dts
+++ b/arch/arm64/boot/dts/qcom/msm8953-xiaomi-vince.dts
@@ -288,6 +288,12 @@ &pm8953_l23 {
 	regulator-min-microvolt = <1200000>;
 };
 
+&pmi8950_flash_led {
+	qcom,torch-max-microamp = <50000>;
+
+	status = "okay";
+};
+
 &pmi8950_haptics {
 	qcom,actuator-type = <HAP_TYPE_ERM>;
 	qcom,brake-pattern = <0x3 0x3 0x0 0x0>;
diff --git a/arch/arm64/boot/dts/qcom/pmi8950.dtsi b/arch/arm64/boot/dts/qcom/pmi8950.dtsi
index 6bc431199afc..14e4a5bfa5aa 100644
--- a/arch/arm64/boot/dts/qcom/pmi8950.dtsi
+++ b/arch/arm64/boot/dts/qcom/pmi8950.dtsi
@@ -216,6 +216,13 @@ pmi8950_haptics: haptics@c000 {
 			status = "disabled";
 		};
 
+		pmi8950_flash_led: led-controller@d300 {
+			compatible = "qcom,pmi8950-flash-led";
+			reg = <0xd300>;
+
+			status = "disabled";
+		};
+
 		pmi8950_wled: leds@d800 {
 			compatible = "qcom,pmi8950-wled";
 			reg = <0xd800>, <0xd900>;
