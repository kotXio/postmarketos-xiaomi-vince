index 26db86974c68..c32164f52384 100644
--- a/drivers/leds/Kconfig
+++ b/drivers/leds/Kconfig
@@ -619,6 +619,20 @@ config LEDS_PCA995X
 	  LED driver chips accessed via the I2C bus. Supported
 	  devices include PCA9955BTW, PCA9952TW and PCA9955TW.
 
+config LEDS_QCOM_PMI8950_TORCH
+	tristate "Qualcomm PMI8950 torch support"
+	depends on LEDS_CLASS_MULTICOLOR
+	depends on OF
+	depends on SPMI
+	help
+	  This driver provides continuous torch control of the two channels in
+	  the legacy Qualcomm PMI8950 flash block. The channels form one
+	  multicolor LED whose cool and warm intensities can be adjusted
+	  independently.
+
+	  This driver intentionally provides neither photo-flash nor
+	  camera/V4L2 integration.
+
 config LEDS_QNAP_MCU
 	tristate "LED Support for QNAP MCU controllers"
 	depends on LEDS_CLASS
