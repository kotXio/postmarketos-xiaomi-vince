+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/ovti,ov12a10.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OmniVision OV12A10 CMOS image sensor
+
+maintainers:
+  - Kostiantyn Andriiuk <konstantin@andriyuk.com>
+
+description: |
+  The OmniVision OV12A10 is a 12-megapixel Bayer image sensor controlled over
+  I2C/SCCB. It outputs 10-bit raw image data over a four-lane MIPI CSI-2 bus.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: ovti,ov12a10
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: External 24 MHz sensor clock.
+    maxItems: 1
+
+  avdd-supply:
+    description: Analog voltage supply, 2.8 V.
+
+  dvdd-supply:
+    description: Digital core voltage supply, 1.2 V.
+
+  dovdd-supply:
+    description: Digital I/O voltage supply, 1.8 V.
+
+  vaf-supply:
+    description: Voice-coil motor voltage supply, 2.85 V.
+
+  reset-gpios:
+    description: Active-low sensor reset line.
+    maxItems: 1
+
+  vana-enable-gpios:
+    description:
+      Active-high board switch for the analog supply, asserted after AVDD has
+      settled.
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            minItems: 4
+            maxItems: 4
+
+          link-frequencies:
+            items:
+              - const: 585000000
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - avdd-supply
+  - dvdd-supply
+  - dovdd-supply
+  - vaf-supply
+  - reset-gpios
+  - vana-enable-gpios
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/qcom,gcc-msm8953.h>
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@10 {
+            compatible = "ovti,ov12a10";
+            reg = <0x10>;
+
+            clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
+            assigned-clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
+            assigned-clock-rates = <24000000>;
+
+            reset-gpios = <&tlmm 33 GPIO_ACTIVE_LOW>;
+            vana-enable-gpios = <&tlmm 62 GPIO_ACTIVE_HIGH>;
+
+            avdd-supply = <&camera_avdd>;
+            dvdd-supply = <&camera_dvdd>;
+            dovdd-supply = <&camera_dovdd>;
+            vaf-supply = <&camera_vaf>;
+
+            orientation = <1>;
+            rotation = <90>;
+
+            port {
+                camera_out: endpoint {
+                    remote-endpoint = <&csiphy0_in>;
+                    clock-lanes = <7>;
+                    data-lanes = <0 1 2 3>;
+                    link-frequencies = /bits/ 64 <585000000>;
+                };
+            };
+        };
+    };
+...
