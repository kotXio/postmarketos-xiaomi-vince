+static void ov12a10_disable_power(struct ov12a10 *ov12a10,
+				  struct ov12a10_power_state *state)
+{
+	if (state->xclk) {
+		clk_disable_unprepare(ov12a10->xclk);
+		state->xclk = false;
+	}
+
+	gpiod_set_value_cansleep(ov12a10->reset_gpio, 1);
+	usleep_range(1000, 1100);
+
+	if (state->vaf) {
+		regulator_disable(ov12a10->vaf);
+		state->vaf = false;
+		usleep_range(1000, 1100);
+	}
+
+	if (state->dovdd) {
+		regulator_disable(ov12a10->dovdd);
+		state->dovdd = false;
+	}
+
+	if (state->avdd) {
+		regulator_disable(ov12a10->avdd);
+		state->avdd = false;
+	}
+
+	if (state->dvdd) {
+		regulator_disable(ov12a10->dvdd);
+		state->dvdd = false;
+		usleep_range(1000, 1100);
+	}
+
+	gpiod_set_value_cansleep(ov12a10->vana_enable_gpio, 0);
+}
+
+static int ov12a10_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov12a10 *ov12a10 = to_ov12a10(sd);
+	struct ov12a10_power_state state = {
+		.avdd = true,
+		.dvdd = true,
+		.dovdd = true,
+		.vaf = true,
+		.xclk = true,
+	};
+
+	ov12a10_disable_power(ov12a10, &state);
+
+	return 0;
+}
+
+static int ov12a10_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov12a10 *ov12a10 = to_ov12a10(sd);
+	struct ov12a10_power_state state = {};
+	int ret;
+
+	gpiod_set_value_cansleep(ov12a10->reset_gpio, 1);
+	gpiod_set_value_cansleep(ov12a10->vana_enable_gpio, 0);
+	usleep_range(1000, 1100);
+
+	ret = regulator_enable(ov12a10->avdd);
+	if (ret)
+		goto error;
+	state.avdd = true;
+	usleep_range(1000, 1100);
+
+	gpiod_set_value_cansleep(ov12a10->vana_enable_gpio, 1);
+	usleep_range(1000, 1100);
+
+	ret = regulator_enable(ov12a10->dvdd);
+	if (ret)
+		goto error;
+	state.dvdd = true;
+	usleep_range(1000, 1100);
+
+	ret = regulator_enable(ov12a10->dovdd);
+	if (ret)
+		goto error;
+	state.dovdd = true;
+	usleep_range(1000, 1100);
+
+	ret = regulator_enable(ov12a10->vaf);
+	if (ret)
+		goto error;
+	state.vaf = true;
+
+	ret = clk_prepare_enable(ov12a10->xclk);
+	if (ret)
+		goto error;
+	state.xclk = true;
+	usleep_range(1000, 1100);
+
+	gpiod_set_value_cansleep(ov12a10->reset_gpio, 0);
+	usleep_range(10000, 11000);
+
+	return 0;
+
+error:
+	ov12a10_disable_power(ov12a10, &state);
+	return ret;
+}
+
+static int ov12a10_set_supply_voltage(struct device *dev,
+				      struct regulator *supply,
+				      const char *name, int microvolts)
+{
+	int ret;
+
+	ret = regulator_set_voltage(supply, microvolts, microvolts);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set %s to %d uV\n",
+				     name, microvolts);
+
+	return 0;
+}
+
+static int ov12a10_get_resources(struct ov12a10 *ov12a10)
+{
+	struct device *dev = ov12a10->dev;
+	int ret;
+
+	ov12a10->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ov12a10->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ov12a10->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	ov12a10->vana_enable_gpio =
+		devm_gpiod_get(dev, "vana-enable", GPIOD_OUT_LOW);
+	if (IS_ERR(ov12a10->vana_enable_gpio))
+		return dev_err_probe(dev, PTR_ERR(ov12a10->vana_enable_gpio),
+				     "failed to get VANA-enable GPIO\n");
+
+	ov12a10->avdd = devm_regulator_get(dev, "avdd");
+	if (IS_ERR(ov12a10->avdd))
+		return dev_err_probe(dev, PTR_ERR(ov12a10->avdd),
+				     "failed to get AVDD\n");
+
+	ov12a10->dvdd = devm_regulator_get(dev, "dvdd");
+	if (IS_ERR(ov12a10->dvdd))
+		return dev_err_probe(dev, PTR_ERR(ov12a10->dvdd),
+				     "failed to get DVDD\n");
+
+	ov12a10->dovdd = devm_regulator_get(dev, "dovdd");
+	if (IS_ERR(ov12a10->dovdd))
+		return dev_err_probe(dev, PTR_ERR(ov12a10->dovdd),
+				     "failed to get DOVDD\n");
+
+	ov12a10->vaf = devm_regulator_get(dev, "vaf");
+	if (IS_ERR(ov12a10->vaf))
+		return dev_err_probe(dev, PTR_ERR(ov12a10->vaf),
+				     "failed to get VAF\n");
+
+	ret = ov12a10_set_supply_voltage(dev, ov12a10->avdd, "AVDD",
+					 OV12A10_AVDD_UV);
+	if (ret)
+		return ret;
+	ret = ov12a10_set_supply_voltage(dev, ov12a10->dvdd, "DVDD",
+					 OV12A10_DVDD_UV);
+	if (ret)
+		return ret;
+	ret = ov12a10_set_supply_voltage(dev, ov12a10->dovdd, "DOVDD",
+					 OV12A10_DOVDD_UV);
+	if (ret)
+		return ret;
+
+	return ov12a10_set_supply_voltage(dev, ov12a10->vaf, "VAF",
+					    OV12A10_VAF_UV);
+}
+
+static int ov12a10_check_hwcfg(struct ov12a10 *ov12a10)
+{
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct device *dev = ov12a10->dev;
+	struct fwnode_handle *endpoint;
+	unsigned long link_freq_bitmap;
+	int ret;
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(dev), 0, 0, 0);
+	if (!endpoint)
+		return dev_err_probe(dev, -EPROBE_DEFER,
+				     "waiting for firmware graph endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &bus_cfg);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to parse endpoint\n");
+
+	ret = v4l2_link_freq_to_bitmap(dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       ov12a10_link_freq_menu,
+				       ARRAY_SIZE(ov12a10_link_freq_menu),
+				       &link_freq_bitmap);
+	if (ret)
+		goto out;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != OV12A10_DATA_LANES) {
+		ret = dev_err_probe(dev, -EINVAL,
+				    "expected %u CSI-2 lanes, got %u\n",
+				    OV12A10_DATA_LANES,
+				    bus_cfg.bus.mipi_csi2.num_data_lanes);
+		goto out;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	return ret;
+}
+
+static int ov12a10_identify(struct ov12a10 *ov12a10)
+{
+	u64 chip_id;
+	int ret;
+
+	ret = cci_read(ov12a10->regmap, OV12A10_REG_CHIP_ID, &chip_id, NULL);
+	if (ret)
+		return ret;
+
+	if (chip_id != OV12A10_CHIP_ID)
+		return dev_err_probe(ov12a10->dev, -ENXIO,
+				     "chip ID 0x%04llx, expected 0x%04x\n",
+				     chip_id, OV12A10_CHIP_ID);
+
+	return 0;
+}
+
+static void ov12a10_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ov12a10 *ov12a10 = to_ov12a10(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(ov12a10->dev);
+
+	if (!pm_runtime_status_suspended(ov12a10->dev)) {
+		ov12a10_power_off(ov12a10->dev);
+		pm_runtime_set_suspended(ov12a10->dev);
+	}
+}
+
+static int ov12a10_probe(struct i2c_client *client)
+{
+	struct ov12a10 *ov12a10;
+	unsigned long xclk_rate;
+	int ret;
+
+	ov12a10 = devm_kzalloc(&client->dev, sizeof(*ov12a10), GFP_KERNEL);
+	if (!ov12a10)
+		return -ENOMEM;
+
+	ov12a10->dev = &client->dev;
+	v4l2_i2c_subdev_init(&ov12a10->sd, client, &ov12a10_subdev_ops);
+
+	ov12a10->xclk = devm_v4l2_sensor_clk_get(ov12a10->dev, NULL);
+	if (IS_ERR(ov12a10->xclk))
+		return dev_err_probe(ov12a10->dev, PTR_ERR(ov12a10->xclk),
+				     "failed to get external clock\n");
+
+	xclk_rate = clk_get_rate(ov12a10->xclk);
+	if (xclk_rate != OV12A10_XCLK_RATE)
+		return dev_err_probe(ov12a10->dev, -EINVAL,
+				     "external clock is %lu Hz, expected %u Hz\n",
+				     xclk_rate, OV12A10_XCLK_RATE);
+
+	ret = ov12a10_check_hwcfg(ov12a10);
+	if (ret)
+		return ret;
+
+	ret = ov12a10_get_resources(ov12a10);
+	if (ret)
+		return ret;
+
+	ov12a10->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(ov12a10->regmap))
+		return PTR_ERR(ov12a10->regmap);
+
+	ret = ov12a10_power_on(ov12a10->dev);
+	if (ret)
+		return dev_err_probe(ov12a10->dev, ret,
+				     "failed to power on sensor\n");
+
+	ret = ov12a10_identify(ov12a10);
+	if (ret)
+		goto power_off;
+
+	ret = ov12a10_init_controls(ov12a10);
+	if (ret)
+		goto power_off;
+
+	ov12a10->sd.state_lock = ov12a10->ctrl_handler.lock;
+	ov12a10->sd.internal_ops = &ov12a10_internal_ops;
+	ov12a10->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	ov12a10->sd.entity.ops = &ov12a10_entity_ops;
+	ov12a10->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	ov12a10->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&ov12a10->sd.entity, 1, &ov12a10->pad);
+	if (ret)
+		goto free_controls;
+
+	ret = v4l2_subdev_init_finalize(&ov12a10->sd);
+	if (ret)
+		goto cleanup_entity;
+
+	pm_runtime_set_active(ov12a10->dev);
+	pm_runtime_enable(ov12a10->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&ov12a10->sd);
+	if (ret)
+		goto cleanup_subdev;
+
+	pm_runtime_set_autosuspend_delay(ov12a10->dev, 1000);
+	pm_runtime_use_autosuspend(ov12a10->dev);
+	pm_runtime_idle(ov12a10->dev);
+
+	return 0;
+
+cleanup_subdev:
+	v4l2_subdev_cleanup(&ov12a10->sd);
+	pm_runtime_disable(ov12a10->dev);
+	pm_runtime_set_suspended(ov12a10->dev);
+cleanup_entity:
+	media_entity_cleanup(&ov12a10->sd.entity);
+free_controls:
+	v4l2_ctrl_handler_free(ov12a10->sd.ctrl_handler);
+power_off:
+	ov12a10_power_off(ov12a10->dev);
+
+	return ret;
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(ov12a10_pm_ops, ov12a10_power_off,
+				 ov12a10_power_on, NULL);
+
+static const struct of_device_id ov12a10_of_match[] = {
+	{ .compatible = "ovti,ov12a10" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ov12a10_of_match);
+
+static struct i2c_driver ov12a10_i2c_driver = {
+	.driver = {
+		.name = "ov12a10",
+		.pm = pm_sleep_ptr(&ov12a10_pm_ops),
+		.of_match_table = ov12a10_of_match,
+	},
+	.probe = ov12a10_probe,
+	.remove = ov12a10_remove,
+};
+module_i2c_driver(ov12a10_i2c_driver);
+
+MODULE_AUTHOR("Kostiantyn Andriiuk <konstantin@andriyuk.com>");
+MODULE_DESCRIPTION("OmniVision OV12A10 sensor driver");
+MODULE_LICENSE("GPL");
