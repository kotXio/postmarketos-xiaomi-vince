+#define OV12A10_DOVDD_UV		1800000
+#define OV12A10_VAF_UV			2850000
+
+struct ov12a10 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *xclk;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *vana_enable_gpio;
+	struct regulator *avdd;
+	struct regulator *dvdd;
+	struct regulator *dovdd;
+	struct regulator *vaf;
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *analogue_gain;
+};
+
+struct ov12a10_power_state {
+	bool avdd;
+	bool dvdd;
+	bool dovdd;
+	bool vaf;
+	bool xclk;
+};
+
+static inline struct ov12a10 *to_ov12a10(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct ov12a10, sd);
+}
