+
+static int ov12a10_release_group_hold(struct ov12a10 *ov12a10)
+{
+	int first_error = 0;
+	int ret;
+
+	ret = cci_write(ov12a10->regmap, CCI_REG8(0x3208), 0x10, NULL);
+	if (ret && !first_error)
+		first_error = ret;
+	ret = cci_write(ov12a10->regmap, CCI_REG8(0x320b), 0x00, NULL);
+	if (ret && !first_error)
+		first_error = ret;
+	ret = cci_write(ov12a10->regmap, CCI_REG8(0x3208), 0xa0, NULL);
+	if (ret && !first_error)
+		first_error = ret;
+
+	return first_error;
+}
+
+static int ov12a10_write_exposure_group(struct ov12a10 *ov12a10)
+{
+	int release_ret;
+	int ret = 0;
+
+	/* This is the exact grouped order proved by the vendor callback. */
+	cci_write(ov12a10->regmap, CCI_REG8(0x3208), 0x00, &ret);
+	cci_write(ov12a10->regmap, CCI_REG16(0x380e),
+		  OV12A10_HEIGHT + ov12a10->vblank->val, &ret);
+	cci_write(ov12a10->regmap, CCI_REG24(0x3500),
+		  ov12a10->exposure->val << 4, &ret);
+	cci_write(ov12a10->regmap, CCI_REG16(0x3508),
+		  ov12a10->analogue_gain->val, &ret);
+
+	/* Always attempt the complete launch sequence, even after a write error. */
+	release_ret = ov12a10_release_group_hold(ov12a10);
+
+	return ret ? ret : release_ret;
+}
+
+static int ov12a10_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ov12a10 *ov12a10 =
+		container_of(ctrl->handler, struct ov12a10, ctrl_handler);
+	int ret;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		__v4l2_ctrl_modify_range(ov12a10->exposure,
+					 ov12a10->exposure->minimum,
+					 OV12A10_HEIGHT + ctrl->val -
+					 OV12A10_EXPOSURE_MARGIN,
+					 ov12a10->exposure->step,
+					 ov12a10->exposure->default_value);
+
+	if (!pm_runtime_get_if_active(ov12a10->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_VBLANK:
+	case V4L2_CID_EXPOSURE:
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = ov12a10_write_exposure_group(ov12a10);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(ov12a10->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops ov12a10_ctrl_ops = {
+	.s_ctrl = ov12a10_set_ctrl,
+};
+
+static int ov12a10_init_controls(struct ov12a10 *ov12a10)
+{
+	struct v4l2_ctrl_handler *handler = &ov12a10->ctrl_handler;
+	struct v4l2_fwnode_device_properties props;
+	int ret;
+
+	v4l2_ctrl_handler_init(handler, 8);
+
+	ov12a10->link_freq =
+		v4l2_ctrl_new_int_menu(handler, &ov12a10_ctrl_ops,
+				       V4L2_CID_LINK_FREQ,
+				       ARRAY_SIZE(ov12a10_link_freq_menu) - 1,
+				       0, ov12a10_link_freq_menu);
+	if (ov12a10->link_freq)
+		ov12a10->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ov12a10->pixel_rate =
+		v4l2_ctrl_new_std(handler, &ov12a10_ctrl_ops,
+				  V4L2_CID_PIXEL_RATE, OV12A10_PIXEL_RATE,
+				  OV12A10_PIXEL_RATE, 1, OV12A10_PIXEL_RATE);
+	if (ov12a10->pixel_rate)
+		ov12a10->pixel_rate->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ov12a10->hblank =
+		v4l2_ctrl_new_std(handler, &ov12a10_ctrl_ops, V4L2_CID_HBLANK,
+				  OV12A10_HBLANK, OV12A10_HBLANK, 1,
+				  OV12A10_HBLANK);
+	if (ov12a10->hblank)
+		ov12a10->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ov12a10->vblank =
+		v4l2_ctrl_new_std(handler, &ov12a10_ctrl_ops, V4L2_CID_VBLANK,
+				  OV12A10_VTS - OV12A10_HEIGHT,
+				  OV12A10_VTS_MAX - OV12A10_HEIGHT, 1,
+				  OV12A10_VTS - OV12A10_HEIGHT);
+
+	ov12a10->exposure =
+		v4l2_ctrl_new_std(handler, &ov12a10_ctrl_ops, V4L2_CID_EXPOSURE,
+				  OV12A10_EXPOSURE_MIN,
+				  OV12A10_VTS - OV12A10_EXPOSURE_MARGIN,
+				  OV12A10_EXPOSURE_STEP,
+				  OV12A10_EXPOSURE_DEFAULT);
+
+	ov12a10->analogue_gain =
+		v4l2_ctrl_new_std(handler, &ov12a10_ctrl_ops,
+				  V4L2_CID_ANALOGUE_GAIN,
+				  OV12A10_ANAL_GAIN_MIN,
+				  OV12A10_ANAL_GAIN_MAX,
+				  OV12A10_ANAL_GAIN_STEP,
+				  OV12A10_ANAL_GAIN_DEFAULT);
+
+	if (handler->error) {
+		ret = handler->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(ov12a10->dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(handler, &ov12a10_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error;
+
+	ov12a10->sd.ctrl_handler = handler;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(handler);
+	return ret;
+}
