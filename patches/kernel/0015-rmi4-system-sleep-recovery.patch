From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Date: Sat, 12 Sep 2026 09:00:00 +0000
Subject: [PATCH 1/2] Input: rmi4: recover Vince controllers after system
 resume

Opt in only on the Vince board to reset-aware RMI system-sleep recovery.
Pair suspend/resume bookkeeping, IRQ and regulator handling and serialize
pending-status recovery. Retry at 20 ms intervals, bounded at 200 ms.

Preserve the existing failed-suspend active-state guard and report
unrecoverable errors without leaving the touchscreen powered off.

Signed-off-by: Kostiantyn Andriiuk <konstantin@andriyuk.com>
---
 .../devicetree/bindings/input/syna,rmi4.yaml  |   9 ++
 .../boot/dts/qcom/msm8953-xiaomi-vince.dts    |   2 +
 drivers/input/rmi4/rmi_driver.c               |  36 +++---
 drivers/input/rmi4/rmi_driver.h               |   9 +-
 drivers/input/rmi4/rmi_i2c.c                  | 105 +++++++++++++++---
 5 files changed, 133 insertions(+), 28 deletions(-)

diff --git a/Documentation/devicetree/bindings/input/syna,rmi4.yaml b/Documentation/devicetree/bindings/input/syna,rmi4.yaml
index 8685ef4481f4ab0850943715a4abd9ca84106018..bb49266ecdad0a5f5dfdb639f43344d897c8a855 100644
--- a/Documentation/devicetree/bindings/input/syna,rmi4.yaml
+++ b/Documentation/devicetree/bindings/input/syna,rmi4.yaml
@@ -49,6 +49,15 @@ properties:
     description:
       Delay to wait after powering on the device.
 
+  syna,reset-on-system-suspend:
+    type: boolean
+    description:
+      The platform can reset or make the controller temporarily unavailable
+      before the RMI function suspend callbacks run. Skip the function sleep
+      command during system suspend and use bounded target-NACK recovery while
+      the controller is reconfigured during system resume. Runtime power
+      management is unaffected.
+
   vdd-supply: true
   vio-supply: true
 
diff --git a/arch/arm64/boot/dts/qcom/msm8953-xiaomi-vince.dts b/arch/arm64/boot/dts/qcom/msm8953-xiaomi-vince.dts
index fc35daa4b0c8bbbc30737440f6b9277a77643ffe..6c209ba8d0955857f6045aa289570f356f06ca0d 100644
--- a/arch/arm64/boot/dts/qcom/msm8953-xiaomi-vince.dts
+++ b/arch/arm64/boot/dts/qcom/msm8953-xiaomi-vince.dts
@@ -316,6 +316,8 @@ dai@127 {
 };
 
 &rmi4_ts {
+	syna,reset-on-system-suspend;
+
 	status = "disabled";
 };
 
diff --git a/drivers/input/rmi4/rmi_driver.c b/drivers/input/rmi4/rmi_driver.c
index 7821728addfaed5f6863f5f4cfde99b64924916d..00ba3ee2522739fb367aee0cfb64656f7056da13 100644
--- a/drivers/input/rmi4/rmi_driver.c
+++ b/drivers/input/rmi4/rmi_driver.c
@@ -873,13 +873,14 @@ static int rmi_create_function(struct rmi_device *rmi_dev,
 	return RMI_SCAN_CONTINUE;
 }
 
-void rmi_enable_irq(struct rmi_device *rmi_dev, bool clear_wake)
+int rmi_enable_irq(struct rmi_device *rmi_dev, bool clear_wake)
 {
 	struct rmi_device_platform_data *pdata = rmi_get_platform_data(rmi_dev);
 	struct rmi_driver_data *data = dev_get_drvdata(&rmi_dev->dev);
 	int irq = pdata->irq;
 	int irq_flags;
-	int retval;
+	int retval = 0;
+	int error;
 
 	mutex_lock(&data->enabled_mutex);
 
@@ -889,11 +890,11 @@ void rmi_enable_irq(struct rmi_device *rmi_dev, bool clear_wake)
 	enable_irq(irq);
 	data->enabled = true;
 	if (clear_wake && device_may_wakeup(rmi_dev->xport->dev)) {
-		retval = disable_irq_wake(irq);
-		if (retval)
+		error = disable_irq_wake(irq);
+		if (error)
 			dev_warn(&rmi_dev->dev,
 				 "Failed to disable irq for wake: %d\n",
-				 retval);
+				 error);
 	}
 
 	/*
@@ -902,10 +903,12 @@ void rmi_enable_irq(struct rmi_device *rmi_dev, bool clear_wake)
 	 */
 	irq_flags = irq_get_trigger_type(pdata->irq);
 	if (irq_flags & IRQ_TYPE_EDGE_BOTH)
-		rmi_process_interrupt_requests(rmi_dev);
+		retval = rmi_process_interrupt_requests(rmi_dev);
 
 out:
 	mutex_unlock(&data->enabled_mutex);
+
+	return retval;
 }
 
 void rmi_disable_irq(struct rmi_device *rmi_dev, bool enable_wake)
@@ -946,11 +949,13 @@ int rmi_driver_suspend(struct rmi_device *rmi_dev, bool enable_wake)
 {
 	int retval;
 
-	retval = rmi_suspend_functions(rmi_dev);
-	if (retval) {
-		dev_warn(&rmi_dev->dev, "Failed to suspend functions: %d\n",
-			retval);
-		return retval;
+	if (!enable_wake || !rmi_has_system_suspend_reset(rmi_dev)) {
+		retval = rmi_suspend_functions(rmi_dev);
+		if (retval) {
+			dev_warn(&rmi_dev->dev,
+				 "Failed to suspend functions: %d\n", retval);
+			return retval;
+		}
 	}
 
 	rmi_disable_irq(rmi_dev, enable_wake);
@@ -962,7 +967,13 @@ int rmi_driver_resume(struct rmi_device *rmi_dev, bool clear_wake)
 {
 	int retval;
 
-	rmi_enable_irq(rmi_dev, clear_wake);
+	retval = rmi_enable_irq(rmi_dev, clear_wake);
+	if (retval && clear_wake && rmi_has_system_suspend_reset(rmi_dev)) {
+		dev_warn(&rmi_dev->dev,
+			 "System resume pending-status recovery failed: %d\n",
+			 retval);
+		return retval;
+	}
 
 	retval = rmi_resume_functions(rmi_dev);
 	if (retval)
@@ -1128,7 +1139,6 @@ static int rmi_driver_probe(struct device *dev)
 		if (retval)
 			return retval;
 	}
-
 	data = devm_kzalloc(dev, sizeof(struct rmi_driver_data), GFP_KERNEL);
 	if (!data)
 		return -ENOMEM;
diff --git a/drivers/input/rmi4/rmi_driver.h b/drivers/input/rmi4/rmi_driver.h
index 5af5a82128a7fe430600bfcd5be777133f0d46d3..312065592b30004e777bf1d6d5c87954bf4f5814 100644
--- a/drivers/input/rmi4/rmi_driver.h
