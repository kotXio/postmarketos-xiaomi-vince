From 8b1a3186ddc39b94e358a3f87c017c498f0f7da7 Mon Sep 17 00:00:00 2001
From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Date: Wed, 2 Sep 2026 15:26:21 +0300
Subject: [PATCH 1/4] dt-bindings: media: add DW9763 actuator

---
 .../bindings/media/i2c/dongwoon,dw9768.yaml   | 26 +++++++++++++++----
 1 file changed, 21 insertions(+), 5 deletions(-)

diff --git a/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9768.yaml b/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9768.yaml
index a0855d3b7577..583a924271e2 100644
--- a/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9768.yaml
+++ b/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9768.yaml
@@ -5,14 +5,14 @@
 $id: http://devicetree.org/schemas/media/i2c/dongwoon,dw9768.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Dongwoon Anatech DW9768 Voice Coil Motor (VCM) Lens
+title: Dongwoon DW9763/DW9768 and Giantec GT9769 Voice Coil Motors
 
 maintainers:
   - Dongchun Zhu <dongchun.zhu@mediatek.com>
 
 description: |-
-  The Dongwoon DW9768 is a single 10-bit digital-to-analog (DAC) converter
-  with 100 mA output current sink capability. VCM current is controlled with
+  The Dongwoon DW9763 and DW9768 are single 10-bit digital-to-analog (DAC)
+  converters with 100 mA output current sink capability. VCM current is controlled with
   a linear mode driver. The DAC is controlled via a 2-wire (I2C-compatible)
   serial interface that operates at clock rates up to 1MHz. This chip
   integrates Advanced Actuator Control (AAC) technology and is intended for
@@ -21,6 +21,7 @@ description: |-
 properties:
   compatible:
     enum:
+      - dongwoon,dw9763 # for DW9763 VCM
       - dongwoon,dw9768 # for DW9768 VCM
       - giantec,gt9769  # for GT9769 VCM
 
@@ -35,6 +36,10 @@ properties:
     description:
       Definition of the regulator used as Digital core voltage supply.
 
+  vaf-supply:
+    description:
+      Definition of the regulator used as the actuator voltage supply.
+
   dongwoon,aac-mode:
     description:
       Indication of AAC mode select.
@@ -72,8 +77,19 @@ properties:
 required:
   - compatible
   - reg
-  - vin-supply
-  - vdd-supply
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          const: dongwoon,dw9763
+    then:
+      required:
+        - vaf-supply
+    else:
+      required:
+        - vin-supply
+        - vdd-supply
 
 additionalProperties: false
 
-- 
2.43.0


From 840e2def01efc9783021224a21e3a38a07b83551 Mon Sep 17 00:00:00 2001
From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Date: Wed, 2 Sep 2026 15:26:21 +0300
Subject: [PATCH 2/4] media: i2c: dw9768: add DW9763 support

---
 drivers/media/i2c/dw9768.c | 113 ++++++++++++++++++++++++++++---------
 1 file changed, 86 insertions(+), 27 deletions(-)

diff --git a/drivers/media/i2c/dw9768.c b/drivers/media/i2c/dw9768.c
index d434721ba8ed..1923bf9664da 100644
--- a/drivers/media/i2c/dw9768.c
+++ b/drivers/media/i2c/dw9768.c
@@ -13,7 +13,7 @@
 #include <media/v4l2-subdev.h>
 
 #define DW9768_NAME				"dw9768"
-#define DW9768_MAX_FOCUS_POS			(1024 - 1)
+#define DW9768_MAX_SUPPLIES			2
 /*
  * This sets the minimum granularity for the focus positions.
  * A value of 1 gives maximum accuracy for a desired focus position
@@ -97,12 +97,50 @@ static const char * const dw9768_supply_names[] = {
 	"vdd",	/* Digital core power */
 };
 
+static const char * const dw9763_supply_names[] = {
+	"vaf",	/* Voice coil motor power */
+};
+
+struct dw9768_chip_info {
+	const char * const *supply_names;
+	unsigned int num_supplies;
+	u32 supply_voltage_uv;
+	u16 max_focus_pos;
+	u16 default_focus_pos;
+	u8 aac_mode;
+	u8 aac_timing;
+	u8 clock_presc;
+	bool write_aac_preset;
+};
+
+static const struct dw9768_chip_info dw9768_chip = {
+	.supply_names = dw9768_supply_names,
+	.num_supplies = ARRAY_SIZE(dw9768_supply_names),
+	.max_focus_pos = 1023,
+	.aac_mode = DW9768_AAC_MODE_DEFAULT,
+	.aac_timing = DW9768_AAC_TIME_DEFAULT,
+	.clock_presc = DW9768_CLOCK_PRE_SCALE_DEFAULT,
+};
+
+static const struct dw9768_chip_info dw9763_chip = {
+	.supply_names = dw9763_supply_names,
+	.num_supplies = ARRAY_SIZE(dw9763_supply_names),
+	.supply_voltage_uv = 2850000,
+	.max_focus_pos = 517,
+	.default_focus_pos = 214,
+	.aac_mode = 5,
+	.aac_timing = 0x38,
+	.clock_presc = 1,
+	.write_aac_preset = true,
+};
+
 /* dw9768 device structure */
 struct dw9768 {
-	struct regulator_bulk_data supplies[ARRAY_SIZE(dw9768_supply_names)];
+	struct regulator_bulk_data supplies[DW9768_MAX_SUPPLIES];
 	struct v4l2_ctrl_handler ctrls;
 	struct v4l2_ctrl *focus;
 	struct v4l2_subdev sd;
+	const struct dw9768_chip_info *chip;
 
 	u32 aac_mode;
 	u32 aac_timing;
@@ -239,20 +277,28 @@ static int dw9768_init(struct dw9768 *dw9768)
 	if (ret < 0)
 		return ret;
 
-	/* Set AAC mode */
-	ret = dw9768_mod_reg(dw9768, DW9768_AAC_PRESC_REG,
-			     DW9768_AAC_MODE_SEL_MASK,
-			     dw9768->aac_mode << 5);
-	if (ret < 0)
-		return ret;
-
-	/* Set clock presc */
-	if (dw9768->clock_presc != DW9768_CLOCK_PRE_SCALE_DEFAULT) {
+	if (dw9768->chip->write_aac_preset) {
+		ret = i2c_smbus_write_byte_data(client, DW9768_AAC_PRESC_REG,
+						(dw9768->aac_mode << 5) |
+						dw9768->clock_presc);
+		if (ret < 0)
+			return ret;
+	} else {
+		/* Set AAC mode */
 		ret = dw9768_mod_reg(dw9768, DW9768_AAC_PRESC_REG,
-				     DW9768_CLOCK_PRE_SCALE_SEL_MASK,
-				     dw9768->clock_presc);
+				     DW9768_AAC_MODE_SEL_MASK,
+				     dw9768->aac_mode << 5);
 		if (ret < 0)
 			return ret;
+
+		/* Set clock presc */
+		if (dw9768->clock_presc != DW9768_CLOCK_PRE_SCALE_DEFAULT) {
+			ret = dw9768_mod_reg(dw9768, DW9768_AAC_PRESC_REG,
+					     DW9768_CLOCK_PRE_SCALE_SEL_MASK,
+					     dw9768->clock_presc);
+			if (ret < 0)
+				return ret;
+		}
 	}
 
 	/* Set AAC Timing */
@@ -314,7 +360,7 @@ static int dw9768_runtime_suspend(struct device *dev)
 	struct dw9768 *dw9768 = sd_to_dw9768(sd);
 
 	dw9768_release(dw9768);
-	regulator_bulk_disable(ARRAY_SIZE(dw9768_supply_names),
+	regulator_bulk_disable(dw9768->chip->num_supplies,
 			       dw9768->supplies);
 
 	return 0;
@@ -326,7 +372,7 @@ static int dw9768_runtime_resume(struct device *dev)
 	struct dw9768 *dw9768 = sd_to_dw9768(sd);
 	int ret;
 
-	ret = regulator_bulk_enable(ARRAY_SIZE(dw9768_supply_names),
+	ret = regulator_bulk_enable(dw9768->chip->num_supplies,
 				    dw9768->supplies);
 	if (ret < 0) {
 		dev_err(dev, "failed to enable regulators\n");
@@ -346,7 +392,7 @@ static int dw9768_runtime_resume(struct device *dev)
 	return 0;
 
 disable_regulator:
-	regulator_bulk_disable(ARRAY_SIZE(dw9768_supply_names),
+	regulator_bulk_disable(dw9768->chip->num_supplies,
 			       dw9768->supplies);
 
 	return ret;
@@ -394,8 +440,9 @@ static int dw9768_init_controls(struct dw9768 *dw9768)
 	v4l2_ctrl_handler_init(hdl, 1);
 
 	dw9768->focus = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_FOCUS_ABSOLUTE, 0,
-					  DW9768_MAX_FOCUS_POS,
-					  DW9768_FOCUS_STEPS, 0);
+					  dw9768->chip->max_focus_pos,
+					  DW9768_FOCUS_STEPS,
+					  dw9768->chip->default_focus_pos);
 
 	if (hdl->error)
 		return hdl->error;
@@ -416,13 +463,16 @@ static int dw9768_probe(struct i2c_client *client)
 	dw9768 = devm_kzalloc(dev, sizeof(*dw9768), GFP_KERNEL);
 	if (!dw9768)
 		return -ENOMEM;
+	dw9768->chip = i2c_get_match_data(client);
+	if (!dw9768->chip)
+		dw9768->chip = &dw9768_chip;
 
 	/* Initialize subdev */
 	v4l2_i2c_subdev_init(&dw9768->sd, client, &dw9768_ops);
 
-	dw9768->aac_mode = DW9768_AAC_MODE_DEFAULT;
-	dw9768->aac_timing = DW9768_AAC_TIME_DEFAULT;
-	dw9768->clock_presc = DW9768_CLOCK_PRE_SCALE_DEFAULT;
+	dw9768->aac_mode = dw9768->chip->aac_mode;
+	dw9768->aac_timing = dw9768->chip->aac_timing;
+	dw9768->clock_presc = dw9768->chip->clock_presc;
 
 	/* Optional indication of AAC mode select */
 	fwnode_property_read_u32(dev_fwnode(dev), "dongwoon,aac-mode",
@@ -440,15 +490,23 @@ static int dw9768_probe(struct i2c_client *client)
 						      dw9768->clock_presc,
 						      dw9768->aac_timing);
 
-	for (i = 0; i < ARRAY_SIZE(dw9768_supply_names); i++)
-		dw9768->supplies[i].supply = dw9768_supply_names[i];
+	for (i = 0; i < dw9768->chip->num_supplies; i++)
+		dw9768->supplies[i].supply = dw9768->chip->supply_names[i];
 
-	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(dw9768_supply_names),
+	ret = devm_regulator_bulk_get(dev, dw9768->chip->num_supplies,
 				      dw9768->supplies);
 	if (ret) {
 		dev_err(dev, "failed to get regulators\n");
 		return ret;
 	}
+	if (dw9768->chip->supply_voltage_uv) {
+		ret = regulator_set_voltage(dw9768->supplies[0].consumer,
+					    dw9768->chip->supply_voltage_uv,
+					    dw9768->chip->supply_voltage_uv);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "failed to set VAF voltage\n");
+	}
 
 	/* Initialize controls */
 	ret = dw9768_init_controls(dw9768);
@@ -528,8 +586,9 @@ static void dw9768_remove(struct i2c_client *client)
 }
 
 static const struct of_device_id dw9768_of_table[] = {
-	{ .compatible = "dongwoon,dw9768" },
-	{ .compatible = "giantec,gt9769" },
+	{ .compatible = "dongwoon,dw9763", .data = &dw9763_chip },
+	{ .compatible = "dongwoon,dw9768", .data = &dw9768_chip },
+	{ .compatible = "giantec,gt9769", .data = &dw9768_chip },
 	{}
 };
 MODULE_DEVICE_TABLE(of, dw9768_of_table);
@@ -552,5 +611,5 @@ static struct i2c_driver dw9768_i2c_driver = {
 module_i2c_driver(dw9768_i2c_driver);
 
 MODULE_AUTHOR("Dongchun Zhu <dongchun.zhu@mediatek.com>");
-MODULE_DESCRIPTION("DW9768 VCM driver");
+MODULE_DESCRIPTION("DW9763/DW9768 VCM driver");
 MODULE_LICENSE("GPL v2");
-- 
2.43.0


From 5fdbfb97ee34f14bdb2371fd41fb5d1b143f998e Mon Sep 17 00:00:00 2001
From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Date: Wed, 2 Sep 2026 15:26:21 +0300
