From 963357ec588e3acb91c847f5154254cdeda080e2 Mon Sep 17 00:00:00 2001
From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Date: Wed, 2 Sep 2026 21:29:34 +0300
Subject: [PATCH] device-xiaomi-vince-camera-policy: new aport

---
 .../90-vince-disable-libcamera-monitor.conf   |  7 +++++++
 .../APKBUILD                                  | 22 +++++++++++++++++++
 2 files changed, 29 insertions(+)
 create mode 100644 device/community/device-xiaomi-vince-camera-policy/90-vince-disable-libcamera-monitor.conf
 create mode 100644 device/community/device-xiaomi-vince-camera-policy/APKBUILD

diff --git a/device/community/device-xiaomi-vince-camera-policy/90-vince-disable-libcamera-monitor.conf b/device/community/device-xiaomi-vince-camera-policy/90-vince-disable-libcamera-monitor.conf
new file mode 100644
index 0000000..283bbe2
--- /dev/null
+++ b/device/community/device-xiaomi-vince-camera-policy/90-vince-disable-libcamera-monitor.conf
@@ -0,0 +1,7 @@
+# Xiaomi Redmi 5 Plus (vince): Plasma Camera uses libcamera directly.
+# Avoid keeping the linked DW9763 lens powered only for PipeWire discovery.
+wireplumber.profiles = {
+  main = {
+    monitor.libcamera = disabled
+  }
+}
diff --git a/device/community/device-xiaomi-vince-camera-policy/APKBUILD b/device/community/device-xiaomi-vince-camera-policy/APKBUILD
new file mode 100644
index 0000000..09c669e
--- /dev/null
+++ b/device/community/device-xiaomi-vince-camera-policy/APKBUILD
@@ -0,0 +1,22 @@
+pkgname=device-xiaomi-vince-camera-policy
+pkgdesc="Camera discovery policy for Xiaomi Redmi 5 Plus (vince)"
+pkgver=1
+pkgrel=0
+url="https://postmarketos.org"
+license="MIT"
+arch="noarch"
+options="!check !archcheck"
+depends="
+	device-qcom-msm8953
+	wireplumber
+"
+source="90-vince-disable-libcamera-monitor.conf"
+
+package() {
+	install -Dm644 "$srcdir"/90-vince-disable-libcamera-monitor.conf \
+		-t "$pkgdir"/usr/share/wireplumber/wireplumber.conf.d
+}
+
+sha512sums="
+eb3da6be2ef795e2d22b0c6916757d9d7772e83a3acfc9e5e67147ba2fdf4bba0679363cd5789dd7f66618e0ee62dd8254cd0fd41877776b62d0ebbe934a4662  90-vince-disable-libcamera-monitor.conf
+"
