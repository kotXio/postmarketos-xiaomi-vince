 2 files changed, 31 insertions(+)
 create mode 100644 device/community/libcamera-ipa-ov12a10/APKBUILD
 create mode 100644 device/community/libcamera-ipa-ov12a10/ov12a10.yaml

diff --git a/device/community/libcamera-ipa-ov12a10/APKBUILD b/device/community/libcamera-ipa-ov12a10/APKBUILD
new file mode 100644
index 0000000..32653f5
--- /dev/null
+++ b/device/community/libcamera-ipa-ov12a10/APKBUILD
@@ -0,0 +1,20 @@
+maintainer="Kostiantyn Andriiuk <konstantin@andriyuk.com>"
+pkgname=libcamera-ipa-ov12a10
+pkgver=1.0
+pkgrel=0
+pkgdesc="Simple IPA tuning for the OmniVision OV12A10 camera sensor"
